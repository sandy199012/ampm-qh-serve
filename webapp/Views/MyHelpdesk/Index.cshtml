@model List<Dictionary<string,object?>>
@{
    ViewData["Title"] = "My Helpdesk";
    var user = (AMPMWeb.Services.UserSession)ViewBag.User;
    bool noEmp = ViewBag.NoEmployeeLinked ?? false;
    var open     = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "Open");
    var inprog   = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "In Progress");
    var resolved = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "Resolved");
    var closed   = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "Closed");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-headset text-danger"></i> My Helpdesk</h5>
    @if (!noEmp)
    {
        <button class="btn btn-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#raiseTicketModal">
            <i class="bi bi-plus-circle"></i> Raise New Ticket
        </button>
    }
</div>

@if (TempData["Success"] != null)
{<div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle"></i> @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-circle"></i> @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}

@if (noEmp)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        Your login isn't linked to an Employee record yet, so you can't raise a ticket from here.
        Please contact IT (<strong>Sandeep Kumar Singh Kushwaha</strong>) to get your account linked.
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-danger-subtle text-center py-2">
            <div class="fw-bold fs-4 text-danger">@open</div>
            <div class="small text-muted">Open</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-primary-subtle text-center py-2">
            <div class="fw-bold fs-4 text-primary">@inprog</div>
            <div class="small text-muted">In Progress</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-success-subtle text-center py-2">
            <div class="fw-bold fs-4 text-success">@resolved</div>
            <div class="small text-muted">Resolved</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-secondary-subtle text-center py-2">
            <div class="fw-bold fs-4 text-secondary">@closed</div>
            <div class="small text-muted">Closed</div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#0A192F;color:white">
                <tr>
                    <th class="ps-3">Ticket ID</th>
                    <th>Date Raised</th>
                    <th>Issue</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-5">You haven't raised any tickets yet</td></tr>
            }
            @foreach (var t in Model)
            {
                var tid      = t.GetValueOrDefault("ticketId")?.ToString() ?? "";
                var status   = t.GetValueOrDefault("status")?.ToString() ?? "Open";
                var priority = t.GetValueOrDefault("priority")?.ToString() ?? "Medium";
                var sBadge   = status == "Open" ? "danger" : status == "In Progress" ? "primary" : status == "Resolved" ? "success" : "secondary";
                var pBadge   = priority == "Critical" ? "danger" : priority == "High" ? "warning" : priority == "Medium" ? "info" : "secondary";
                <tr>
                    <td class="ps-3 font-monospace fw-bold small text-primary">@tid</td>
                    <td class="small text-muted">@t.GetValueOrDefault("dateRaised")</td>
                    <td class="small text-truncate" style="max-width:220px">@t.GetValueOrDefault("title")</td>
                    <td><span class="badge bg-@pBadge">@priority</span></td>
                    <td>
                        <span class="badge bg-@sBadge">@status</span>
                        @{ var myEta = t.GetValueOrDefault("expectedResolution")?.ToString(); }
                        @if (!string.IsNullOrEmpty(myEta))
                        {
                            <div class="small text-warning mt-1" style="white-space:nowrap"><i class="bi bi-hourglass-split"></i> ETA: @myEta</div>
                        }
                        @{ var myFb = t.GetValueOrDefault("empFeedbackStatus")?.ToString(); }
                        @if ((status == "Resolved" || status == "Closed") && string.IsNullOrEmpty(myFb))
                        {
                            <div class="small text-danger mt-1" style="white-space:nowrap"><i class="bi bi-exclamation-circle"></i> Feedback pending</div>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="showTicket('@tid')">
                            <i class="bi bi-eye"></i> View
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Raise Ticket Modal -->
<div class="modal fade" id="raiseTicketModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/MyHelpdesk/Create" id="ticketForm">
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-danger"></i> Raise New Helpdesk Ticket</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-person-check"></i> Raising as <strong>@user.Name</strong> (@user.EmpId) — your employee details are filled in automatically.
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Issue Title *</label>
                            <input type="text" name="title" class="form-control" required placeholder="Brief description of the issue"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Category *</label>
                            <select name="category" id="categorySelect" class="form-select" required onchange="fillIssueTypes()">
                                <option value="">Select Category</option>
                                @foreach(var c in new[]{"Hardware","Laptop / Desktop","Software","Operating System","Network / LAN","Wi-Fi","Internet","VPN / Remote Access","Email / Outlook","Microsoft 365","Active Directory / User Account","Access / Permission","Server","Backup / Recovery","Cyber Security","Antivirus / Endpoint Security","Firewall","Printer / Scanner","CCTV / Security Systems","Biometric / Attendance","ERP / Business Application","POS / Billing","Mobile / Tablet / iPad","Cloud Services","Software License / Compliance","IT Asset Management","New Employee IT Setup","Employee Exit / IT Deactivation","Website / Domain","Telecommunication","Audio / Video / Meeting Room","Power / Electrical IT Equipment","Data / File Management","Procurement / IT Purchase","Vendor / AMC","IT Request / General"})
                                {<option>@c</option>}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Issue Type * <span class="text-muted fw-normal">(select one or more)</span></label>
                            <div id="issueTypeBox" class="border rounded p-2" style="max-height:170px;overflow-y:auto;background:#fff">
                                <div class="small text-muted">Select Category first</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Priority *</label>
                            <select name="priority" class="form-select" required>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Description</label>
                            <textarea name="description" class="form-control" rows="4" placeholder="Detailed description of the issue..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-check-circle"></i> Submit Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Ticket Details Modal -->
<div class="modal fade" id="viewTicketModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold" id="vtTitle"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="vtBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const myTickets = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
function esc(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

// Sub-categories ("Issue Type") shown depend on the chosen Category — same
// 36-category IT classification list used on the admin New Ticket form
// (Controllers/HelpdeskController's Create view), kept in sync here.
const categoryIssueMap = {
    "Hardware": ["Laptop", "Desktop", "Monitor", "Keyboard", "Mouse", "Printer", "Scanner", "UPS", "UPS Battery", "HDD", "SSD", "RAM", "Motherboard", "SMPS", "Adapter/Charger", "Docking Station", "Webcam", "Speaker", "Headset", "Cable", "Pendrive"],
    "Laptop / Desktop": ["System not starting", "Slow performance", "Hang", "Restart/Shutdown", "Blue Screen", "Overheating", "Battery issue", "Charging issue", "Display issue", "Keyboard issue", "Touchpad issue", "Camera/Mic issue", "Fan noise", "Physical damage"],
    "Software": ["Software installation", "Uninstallation", "Software not opening", "Software crash", "Error message", "License issue", "Update/Upgrade", "Configuration", "Compatibility issue"],
    "Operating System": ["Windows issue", "macOS issue", "Boot issue", "Login issue", "Windows activation", "OS installation", "Formatting", "Driver issue", "Windows Update", "System restore"],
    "Network / LAN": ["LAN not working", "Network connectivity", "Slow network", "IP conflict", "IP configuration", "DNS issue", "DHCP issue", "LAN port issue", "Network cable issue"],
    "Wi-Fi": ["Wi-Fi not connecting", "Slow Wi-Fi", "Wi-Fi authentication", "Weak signal", "Access Point issue", "Wi-Fi password", "Guest Wi-Fi"],
    "Internet": ["Internet not working", "Slow internet", "ISP issue", "Broadband issue", "Internet disconnection", "Bandwidth issue", "Website inaccessible"],
    "VPN / Remote Access": ["VPN not connecting", "VPN credentials", "VPN slow", "Remote Desktop issue", "Remote access permission", "WFH connectivity"],
    "Email / Outlook": ["Email not sending", "Email not receiving", "Outlook not opening", "Password issue", "Mailbox full", "Email configuration", "Signature", "Spam/Junk", "Attachment issue", "Sync issue", "Shared mailbox"],
    "Microsoft 365": ["Outlook", "Teams", "OneDrive", "SharePoint", "Word", "Excel", "PowerPoint", "Office activation", "License assignment", "MFA", "Account issue"],
    "Active Directory / User Account": ["New user creation", "Password reset", "Account locked", "Account disabled", "AD group access", "OU assignment", "Login issue", "Domain issue", "Permission issue"],
    "Access / Permission": ["Folder access", "Shared drive access", "Application access", "Server access", "Email access", "VPN access", "Website access", "Admin permission"],
    "Server": ["Server down", "Server slow", "Disk space", "CPU/RAM issue", "Service stopped", "Windows Server", "File Server", "Application Server", "Database Server", "Backup issue"],
    "Backup / Recovery": ["Backup failed", "Backup schedule", "Data restore", "File recovery", "Deleted file recovery", "Backup verification", "Disaster recovery"],
    "Cyber Security": ["Virus", "Malware", "Ransomware", "Phishing", "Suspicious email", "Suspicious link", "Unauthorized software", "Password/security issue", "Data leakage", "Security alert"],
    "Antivirus / Endpoint Security": ["Antivirus installation", "License issue", "Virus detection", "Scan issue", "Update issue", "Endpoint not reporting", "Policy issue"],
    "Firewall": ["Internet blocking", "Application blocking", "Port issue", "Firewall rule", "URL blocking", "NAT issue", "VPN rule", "MAC binding"],
    "Printer / Scanner": ["Printer not working", "Printing error", "Paper jam", "Toner issue", "Network printer", "Driver issue", "Scanner issue", "Print quality", "Printer configuration"],
    "CCTV / Security Systems": ["Camera offline", "Camera not recording", "NVR/DVR issue", "Remote viewing", "Storage issue", "Camera installation", "Network camera issue"],
    "Biometric / Attendance": ["Device offline", "Fingerprint issue", "Face recognition", "Attendance sync", "Employee registration", "Device configuration", "Mobile app issue"],
    "ERP / Business Application": ["Login issue", "Application error", "Slow application", "Access permission", "Configuration", "Data issue", "Report issue", "Integration issue"],
    "POS / Billing": ["POS login", "Billing issue", "Printer connection", "Barcode scanner", "Cash drawer", "Billing software", "Network issue", "Sync issue"],
    "Mobile / Tablet / iPad": ["Device issue", "SIM issue", "Mobile data", "Wi-Fi", "App installation", "Email configuration", "MDM", "Screen/charging/battery"],
    "Cloud Services": ["OneDrive", "SharePoint", "Google Drive", "AWS", "Azure", "Cloud access", "Storage", "Sync", "Permission"],
    "Software License / Compliance": ["Adobe", "Corel", "Microsoft Office", "Antivirus", "License renewal", "New license", "License assignment", "Compliance audit"],
    "IT Asset Management": ["New asset", "Asset allocation", "Asset transfer", "Asset return", "Asset replacement", "Asset audit", "Asset tagging", "Lost asset", "Damaged asset", "Scrap"],
    "New Employee IT Setup": ["Laptop/Desktop", "Email ID", "AD account", "Software", "VPN", "Internet", "Access permission", "Printer", "Mobile/SIM", "IT induction"],
    "Employee Exit / IT Deactivation": ["Asset recovery", "Email disable", "AD disable", "VPN disable", "Software license removal", "Data backup", "Access removal"],
    "Website / Domain": ["Website down", "Domain issue", "DNS", "SSL certificate", "Hosting", "Website access", "Domain renewal"],
    "Telecommunication": ["Landline", "Mobile SIM", "Intercom", "Calling issue", "Call quality", "SIM replacement", "Recharge/plan"],
    "Audio / Video / Meeting Room": ["Projector", "TV", "HDMI", "Video conferencing", "Microphone", "Speaker", "Meeting room system", "Camera"],
    "Power / Electrical IT Equipment": ["UPS", "Power backup", "Voltage issue", "Adapter", "Power cable", "Surge protection"],
    "Data / File Management": ["File missing", "File deletion", "File permission", "Data transfer", "Data migration", "Duplicate data", "Storage issue"],
    "Procurement / IT Purchase": ["Laptop purchase", "Desktop purchase", "Software purchase", "License renewal", "Printer purchase", "IT accessories", "Vendor quotation"],
    "Vendor / AMC": ["Vendor support", "AMC service", "Warranty claim", "Repair", "Replacement", "Service delay", "Vendor quotation"],
    "IT Request / General": ["New requirement", "IT consultation", "Configuration request", "Information request", "IT policy/SOP", "Other"]
};

// Issue Type is a checkbox list (not a single dropdown) so an employee can
// tick more than one issue type for the same ticket. All checked boxes
// share name="issueType", so on submit ASP.NET Core's model binding joins
// them into one comma-separated string automatically — no controller
// change needed, same as when only one was ever selected.
function fillIssueTypes() {
    const cat = document.getElementById('categorySelect').value;
    const box = document.getElementById('issueTypeBox');
    const items = categoryIssueMap[cat] || [];
    if (!cat) {
        box.innerHTML = '<div class="small text-muted">Select Category first</div>';
        return;
    }
    let html = '';
    items.forEach((i, idx) => {
        const id = 'it_' + idx;
        html += '<div class="form-check"><input class="form-check-input" type="checkbox" name="issueType" value="' + i + '" id="' + id + '">'
              + '<label class="form-check-label small" for="' + id + '">' + i + '</label></div>';
    });
    box.innerHTML = html;
}

document.getElementById('ticketForm').addEventListener('submit', function(e) {
    if (document.querySelectorAll('input[name="issueType"]:checked').length === 0) {
        e.preventDefault();
        alert('Please select at least one Issue Type.');
    }
});

function showTicket(id) {
    const t = myTickets.find(x => (x.ticketId || '') === id);
    if (!t) return;
    document.getElementById('vtTitle').innerHTML = '<i class="bi bi-ticket-perforated text-danger"></i> ' + esc(t.ticketId) + ' — ' + esc(t.title);
    const rows = [
        ['Status', esc(t.status)],
        ['Priority', esc(t.priority)],
        ['Issue Type', esc(t.issueType)],
        ['Category', esc(t.category)],
        ['Date Raised', esc(t.dateRaised)],
        ['Acknowledged', esc(t.dateAcknowledged) || '—'],
        ['Expected Resolution (ETA)', esc(t.expectedResolution) || '—'],
        ['Resolved', esc(t.dateResolved) || '—'],
        ['Closed', esc(t.dateClosed) || '—'],
        ['Assigned To', esc(t.assignedTo) || '—'],
    ];
    let html = '';
    if (t.expectedResolution && t.status !== 'Resolved' && t.status !== 'Closed') {
        html += '<div class="alert alert-warning py-2 mb-3"><i class="bi bi-hourglass-split"></i> <strong>Expected to be resolved by:</strong> ' + esc(t.expectedResolution) + '</div>';
    }
    html += '<table class="table table-sm mb-3">';
    rows.forEach(r => html += `<tr><td class="text-muted small" style="width:160px">${r[0]}</td><td>${r[1]}</td></tr>`);
    html += '</table>';
    html += '<div class="mb-2"><div class="small fw-bold text-muted">DESCRIPTION</div><div class="p-2 bg-light rounded small">' + (esc(t.description) || '—') + '</div></div>';
    if (t.resolution) html += '<div class="mb-2"><div class="small fw-bold text-success">RESOLUTION</div><div class="p-2 bg-success-subtle rounded small">' + esc(t.resolution) + '</div></div>';
    if (t.ackComment) html += '<div class="mb-2"><div class="small fw-bold text-primary">IT NOTE (ACKNOWLEDGED)</div><div class="p-2 bg-primary-subtle rounded small">' + esc(t.ackComment) + '</div></div>';
    html += feedbackSectionHtml(t);
    document.getElementById('vtBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('viewTicketModal')).show();
}

// Once a ticket is Resolved/Closed, let the employee confirm whether it
// actually fixed their issue (plus an optional comment). Re-showing the
// same form pre-filled with whatever was submitted last also lets them
// update their feedback if IT re-opens/re-resolves the ticket later.
function feedbackSectionHtml(t) {
    if (t.status !== 'Resolved' && t.status !== 'Closed') return '';
    const cur = t.empFeedbackStatus || '';
    const curComment = t.empFeedback || '';
    let html = '<div class="card border-0 shadow-sm mt-3">';
    html += '<div class="card-header fw-bold" style="background:#FEF3C7;color:#92400E"><i class="bi bi-chat-square-heart"></i> Your Feedback</div>';
    html += '<div class="card-body">';
    if (t.empFeedbackDate) {
        html += '<div class="small text-muted mb-2">Last submitted: ' + esc(t.empFeedbackDate) + '</div>';
    }
    html += '<form method="post" action="/MyHelpdesk/SubmitFeedback">';
    html += '<input type="hidden" name="id" value="' + esc(t.ticketId) + '"/>';
    html += '<div class="mb-2">';
    html += '<div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="feedbackStatus" id="fbYes" value="Resolved" required' + (cur === 'Resolved' ? ' checked' : '') + '><label class="form-check-label" for="fbYes">✅ Issue Resolved</label></div>';
    html += '<div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="feedbackStatus" id="fbNo" value="Not Resolved"' + (cur === 'Not Resolved' ? ' checked' : '') + '><label class="form-check-label" for="fbNo">❌ Not Resolved</label></div>';
    html += '</div>';
    html += '<textarea name="feedbackComment" class="form-control form-control-sm mb-2" rows="2" placeholder="Anything else you want IT to know...">' + esc(curComment) + '</textarea>';
    html += '<button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-send"></i> Submit Feedback</button>';
    html += '</form></div></div>';
    return html;
}
</script>
}
