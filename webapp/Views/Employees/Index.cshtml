@model List<Dictionary<string,object?>>
@{ViewData["Title"] = "Employees";}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-people text-primary"></i> Employees &mdash; @Model.Count records</h5>
    <div class="d-flex gap-2">
        <a href="/Employees/Import" class="btn btn-outline-primary btn-sm px-3"><i class="bi bi-upload"></i> Import CSV</a>
        <a href="/Employees/Export" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Export CSV</a>
        <a href="/Employees/Create" class="btn btn-primary btn-sm px-3"><i class="bi bi-plus-circle"></i> Add Employee</a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search name, emp code, mobile..."/>
            </div>
            <div class="col-md-3">
                <select name="dept" class="form-select form-select-sm">
                    <option value="">All Departments</option>
                    @foreach (var d in (List<string>)ViewBag.Departments)
                    {
                        if (ViewBag.Dept == d){ <option value="@d" selected>@d</option> }
                        else { <option value="@d">@d</option> }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm px-3">Filter</button>
                <a href="/Employees/Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
            <div class="col-auto ms-auto">
                <span class="badge bg-primary fs-6">@Model.Count</span> employees
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#0A192F;color:white">
                <tr>
                    <th class="ps-3">Emp Code</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Manager</th>
                    <th>Mobile</th>
                    <th>DOJ</th>
                    <th>PC/Hostname</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {<tr><td colspan="9" class="text-center text-muted py-5">No employees found</td></tr>}
            @foreach (var e in Model)
            {
                string emp   = e.GetValueOrDefault("emp")?.ToString() ?? "";
                string name  = e.GetValueOrDefault("name")?.ToString() ?? "";
                string dept  = e.GetValueOrDefault("dept")?.ToString() ?? "";
                string desig = e.GetValueOrDefault("designation")?.ToString() ?? "";
                string mgr   = e.GetValueOrDefault("manager")?.ToString() ?? "";
                string mob   = e.GetValueOrDefault("mobile")?.ToString() ?? "";
                string doj   = e.GetValueOrDefault("doj")?.ToString() ?? "";
                string host  = e.GetValueOrDefault("hostname")?.ToString() ?? "";
                string exit  = e.GetValueOrDefault("exitDate")?.ToString() ?? "";
                bool isExited = !string.IsNullOrEmpty(exit);
                <tr class="@(isExited?"table-secondary opacity-75":"")">
                    <td class="ps-3 font-monospace fw-bold small text-primary">@emp</td>
                    <td>
                        <strong>@name</strong>
                        @if(isExited){<br/><span class="badge bg-danger small">Exited @exit</span>}
                    </td>
                    <td><span class="badge bg-light text-dark border small">@dept</span></td>
                    <td class="small text-muted">@desig</td>
                    <td class="small">@mgr</td>
                    <td class="small">@mob</td>
                    <td class="small text-muted">@doj</td>
                    <td class="small">
                        @if(!string.IsNullOrEmpty(host))
                        {<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-pc-display"></i> @host</span>}
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/Employees/Details/@emp" class="btn btn-outline-primary btn-sm" title="View"><i class="bi bi-eye"></i></a>
                            <a href="/Employees/Edit/@emp" class="btn btn-outline-warning btn-sm" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a href="/Employees/Handover/@emp" target="_blank" class="btn btn-outline-dark btn-sm" title="Handover Form"><i class="bi bi-file-earmark-text"></i></a>
                            @if (isExited)
                            {
                            <form method="post" action="/Employees/Restore/@emp" class="d-inline" onsubmit="return confirm('Restore this employee to active?')">
                                <button class="btn btn-outline-success btn-sm" style="font-size:11px" type="submit" title="Restore"><i class="bi bi-arrow-counterclockwise"></i></button>
                            </form>
                            }
                            else
                            {
                            <form method="post" action="/Employees/MarkExited/@emp" class="d-inline" onsubmit="return confirm('Mark this employee as exited?')">
                                <button class="btn btn-outline-danger btn-sm" style="font-size:11px" type="submit" title="Mark Exited"><i class="bi bi-person-dash"></i></button>
                            </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-light small text-muted">
        Total: @Model.Count | Active: @Model.Count(e => string.IsNullOrEmpty(e.GetValueOrDefault("exitDate")?.ToString()))
    </div>
</div>
