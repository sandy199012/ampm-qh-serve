@model Dictionary<string,object?>
@{ViewData["Title"] = "Add Employee";
  string[] depts = {"IT","HR","ACCOUNTS & FINANCE","ADMIN","DESIGN - APPAREL","DESIGN - ACCESSORIES","PRODUCTION - APPAREL","PRODUCTION - LEATHER","PRODUCTION - MTO","WAREHOUSE & LOGISTICS","RETAILS","MERCHANDISING","QUALITY","MANAGEMENT","E-Commerce","MARKETING","SAMPLING - APPAREL","FABRIC STORE","RESEARCH & DEVELOPMENT","TRUNK SHOW","ACCESSORIES STORE"};}

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Employees/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0"><i class="bi bi-person-plus text-primary"></i> Add New Employee</h5>
</div>

<form method="post" action="/Employees/Create">
<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold" style="background:#0A192F;color:white">Personal Information</div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label small fw-bold">Employee Code *</label><input type="text" name="emp" class="form-control" required placeholder="e.g. 00500"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Full Name *</label><input type="text" name="name" class="form-control" required/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Mobile</label><input type="text" name="mobile" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Email</label><input type="email" name="email" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Gender</label>
                    <select name="gender" class="form-select"><option>male</option><option>female</option></select></div>
                <div class="mb-3"><label class="form-label small fw-bold">Date of Birth</label><input type="date" name="dob" class="form-control"/></div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold" style="background:#1e3a5f;color:white">Job Information</div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label small fw-bold">Department</label>
                    <select name="dept" class="form-select">@foreach(var d in depts){<option>@d</option>}</select></div>
                <div class="mb-3"><label class="form-label small fw-bold">Designation</label><input type="text" name="designation" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Manager</label><input type="text" name="manager" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Date of Joining</label><input type="date" name="doj" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Category</label>
                    <select name="category" class="form-select"><option>Staff</option><option>Worker</option><option>Contractual</option><option>Probation</option><option>Intern</option></select></div>
                <div class="mb-3"><label class="form-label small fw-bold">Shift</label>
                    <select name="shift" class="form-select"><option>General Shift</option><option>Morning Shift</option><option>Evening Shift</option></select></div>
            </div>
        </div>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-plus-circle"></i> Add Employee</button>
    <a href="/Employees/Index" class="btn btn-outline-secondary px-4">Cancel</a>
</div>
</form>
