@model Dictionary<string,object?>
@{
    ViewData["Title"] = "Edit Bill";
    var bid = Model.GetValueOrDefault("id")?.ToString() ?? "";
    var curCat = Model.GetValueOrDefault("category")?.ToString() ?? "";
    var curPeriod = Model.GetValueOrDefault("period")?.ToString() ?? "";
}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Bills/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">Edit — @Model.GetValueOrDefault("name")</h5>
</div>
<div class="row justify-content-center"><div class="col-lg-7">
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form method="post" action="/Bills/Edit/@bid">
    <div class="row g-3">
        <div class="col-12"><label class="form-label small fw-bold">Bill Name *</label><input type="text" name="name" value="@Model.GetValueOrDefault("name")" class="form-control" required/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Category</label>
            <select name="category" class="form-select">
                @foreach (var c in new[]{"Internet","Electricity","Rent","Water","Telephone","Mobile","Maintenance","AMC","Insurance","Subscription","Other"})
                { if (curCat==c) { <option selected>@c</option> } else { <option>@c</option> } }
            </select>
        </div>
        <div class="col-md-6"><label class="form-label small fw-bold">Vendor / Place</label><input type="text" name="vendor" value="@Model.GetValueOrDefault("vendor")" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Due Date *</label><input type="date" name="dueDate" value="@Model.GetValueOrDefault("dueDate")" class="form-control" required/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Amount (₹)</label><input type="number" step="0.01" name="amount" value="@Model.GetValueOrDefault("amount")" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Alert Days Before</label><input type="number" name="alertDays" value="@Model.GetValueOrDefault("alertDays")" class="form-control"/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Period</label>
            <select name="period" class="form-select">
                @foreach (var p in new[]{"Monthly","Quarterly","Half-Yearly","Annual","One-Time"})
                { if (curPeriod==p) { <option selected>@p</option> } else { <option>@p</option> } }
            </select>
        </div>
        <div class="col-md-6"><label class="form-label small fw-bold">Status</label><input type="text" class="form-control" value="@Model.GetValueOrDefault("status")" disabled/></div>
        <div class="col-12"><label class="form-label small fw-bold">Notes</label><textarea name="notes" class="form-control" rows="2">@Model.GetValueOrDefault("notes")</textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save</button>
        <a href="/Bills/Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>
</div></div>
</div></div>
