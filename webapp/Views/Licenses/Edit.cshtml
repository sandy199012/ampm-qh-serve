@model Dictionary<string,object?>
@{
    ViewData["Title"] = "Edit License";
    var lid = Model.GetValueOrDefault("id")?.ToString() ?? "";
    var curCat = Model.GetValueOrDefault("category")?.ToString() ?? "";
    var curStatus = Model.GetValueOrDefault("status")?.ToString() ?? "";
    var lastRenewed = Model.GetValueOrDefault("lastRenewedDate")?.ToString();
}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Licenses/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">Edit — @Model.GetValueOrDefault("name")</h5>
</div>
@if (!string.IsNullOrEmpty(lastRenewed))
{
    <div class="alert alert-light border small mb-3">Last renewed on <b>@lastRenewed</b> by <b>@Model.GetValueOrDefault("lastRenewedBy")</b></div>
}
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form method="post" action="/Licenses/Edit/@lid">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label small fw-bold">License Name *</label><input type="text" name="name" value="@Model.GetValueOrDefault("name")" class="form-control" required/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Vendor</label><input type="text" name="vendor" value="@Model.GetValueOrDefault("vendor")" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Category</label>
            <select name="category" class="form-select">
                @foreach (var c in new[]{"Antivirus/Security","Operating System","Office/Productivity","Design/Creative","Cloud/SaaS","Development Tools","Networking/Firewall","Accounting","Other"})
                { if (curCat==c) { <option selected>@c</option> } else { <option>@c</option> } }
            </select>
        </div>
        <div class="col-md-4"><label class="form-label small fw-bold">Seats</label><input type="number" name="seats" value="@Model.GetValueOrDefault("seats")" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Cost (₹)</label><input type="number" step="0.01" name="cost" value="@Model.GetValueOrDefault("cost")" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Purchase Date</label><input type="date" name="purchaseDate" value="@Model.GetValueOrDefault("purchaseDate")" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Renewal Date *</label><input type="date" name="renewalDate" value="@Model.GetValueOrDefault("renewalDate")" class="form-control" required/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Alert Days Before</label><input type="number" name="alertDays" value="@Model.GetValueOrDefault("alertDays")" class="form-control"/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Status</label>
            <select name="status" class="form-select">
                @foreach (var s in new[]{"Active","Pending Renewal","Expired","Cancelled"})
                { if (curStatus==s) { <option selected>@s</option> } else { <option>@s</option> } }
            </select>
        </div>
        <div class="col-md-6"><label class="form-label small fw-bold">Invoice No.</label><input type="text" name="invoiceNo" value="@Model.GetValueOrDefault("invoiceNo")" class="form-control"/></div>
        <div class="col-12"><label class="form-label small fw-bold">License Key</label><input type="text" name="licenseKey" value="@Model.GetValueOrDefault("licenseKey")" class="form-control font-monospace"/></div>
        <div class="col-12"><label class="form-label small fw-bold">Notes</label><textarea name="notes" class="form-control" rows="2">@Model.GetValueOrDefault("notes")</textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save</button>
        <a href="/Licenses/Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>
</div></div>
</div></div>
