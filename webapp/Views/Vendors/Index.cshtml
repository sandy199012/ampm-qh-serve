@model List<Dictionary<string,object?>>
@{ViewData["Title"] = "Vendors";}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-shop text-dark"></i> Vendors &mdash; @Model.Count</h5>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" style="max-width:280px" placeholder="Search vendor name, city..."/>
            <button class="btn btn-primary btn-sm">Search</button>
            <a href="/Vendors" class="btn btn-outline-secondary btn-sm">Clear</a>
        </form>
    </div>
</div>

<div class="row g-3">
@foreach (var v in Model)
{
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-1">@v.GetValueOrDefault("name")</h6>
                <p class="small text-muted mb-2">@v.GetValueOrDefault("category")</p>
                <ul class="list-unstyled small mb-0">
                    @if(!string.IsNullOrEmpty(v.GetValueOrDefault("contact")?.ToString()))
                    {<li><i class="bi bi-person text-muted"></i> @v.GetValueOrDefault("contact")</li>}
                    @if(!string.IsNullOrEmpty(v.GetValueOrDefault("phone")?.ToString()))
                    {<li><i class="bi bi-telephone text-muted"></i> @v.GetValueOrDefault("phone")</li>}
                    @if(!string.IsNullOrEmpty(v.GetValueOrDefault("email")?.ToString()))
                    {<li><i class="bi bi-envelope text-muted"></i> @v.GetValueOrDefault("email")</li>}
                    @if(!string.IsNullOrEmpty(v.GetValueOrDefault("gst")?.ToString()))
                    {<li><i class="bi bi-card-text text-muted"></i> GST: @v.GetValueOrDefault("gst")</li>}
                    @if(!string.IsNullOrEmpty(v.GetValueOrDefault("city")?.ToString()))
                    {<li><i class="bi bi-geo-alt text-muted"></i> @v.GetValueOrDefault("city")</li>}
                </ul>
            </div>
        </div>
    </div>
}
@if (!Model.Any())
{
    <div class="col-12 text-center text-muted py-5">No vendors found</div>
}
</div>
