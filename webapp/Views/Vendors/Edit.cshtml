@model Dictionary<string,object?>
@{ViewData["Title"] = "Edit Vendor";
  var vid = Model.GetValueOrDefault("vendorId")?.ToString() ?? "";}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Vendors/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">Edit — @Model.GetValueOrDefault("name")</h5>
</div>
<div class="row justify-content-center"><div class="col-lg-7">
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form method="post" action="/Vendors/Edit/@vid">
    <div class="row g-3">
        <div class="col-12"><label class="form-label small fw-bold">Vendor Name *</label><input type="text" name="name" value="@Model.GetValueOrDefault("name")" class="form-control" required/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Category</label>
            <select name="category" class="form-select">
                @{var curC = Model.GetValueOrDefault("category")?.ToString() ?? "";}
                @foreach(var c in new[]{"Hardware","Software","Networking","Printer","Cartridge","AMC/Service","Cloud/Hosting","Telecom","Furniture","Stationery","Mac","Other"})
                {if(curC==c){<option selected>@c</option>}else{<option>@c</option>}}
            </select>
        </div>
        <div class="col-md-6"><label class="form-label small fw-bold">GST Number</label><input type="text" name="gst" value="@Model.GetValueOrDefault("gst")" class="form-control"/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Contact Person</label><input type="text" name="contactPerson" value="@Model.GetValueOrDefault("contactPerson")" class="form-control"/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Phone</label><input type="text" name="phone" value="@Model.GetValueOrDefault("phone")" class="form-control"/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Email</label><input type="email" name="email" value="@Model.GetValueOrDefault("email")" class="form-control"/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Payment Terms</label>
            <select name="paymentTerms" class="form-select">
                @{var curPT = Model.GetValueOrDefault("paymentTerms")?.ToString() ?? "";}
                @foreach(var pt in new[]{"Advance","Credit 30 Days","Credit 45 Days","On Delivery"})
                {if(curPT==pt){<option selected>@pt</option>}else{<option>@pt</option>}}
            </select>
        </div>
        <div class="col-12"><label class="form-label small fw-bold">Address</label><textarea name="address" class="form-control" rows="2">@Model.GetValueOrDefault("address")</textarea></div>
        <div class="col-12"><label class="form-label small fw-bold">Notes</label><textarea name="notes" class="form-control" rows="2">@Model.GetValueOrDefault("notes")</textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save</button>
        <a href="/Vendors/Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>
</div></div>
</div></div>
