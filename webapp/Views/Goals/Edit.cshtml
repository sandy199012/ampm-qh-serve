@model Dictionary<string,object?>
@{ViewData["Title"] = "Edit Goal";
  var gid = Model.GetValueOrDefault("id")?.ToString() ?? "";
  string[] depts = {"IT","HR","ACCOUNTS & FINANCE","ADMIN","DESIGN - APPAREL","PRODUCTION - APPAREL","PRODUCTION - LEATHER","WAREHOUSE & LOGISTICS","RETAILS","MERCHANDISING","QUALITY","MANAGEMENT","E-Commerce","MARKETING"};}

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Goals/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">Edit Goal</h5>
</div>
<div class="row justify-content-center">
<div class="col-lg-8">
<div class="card border-0 shadow-sm">
<div class="card-body p-4">
<form method="post" action="/Goals/Edit/@gid">
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold small">Goal / Task *</label>
            <input type="text" name="title" value="@Model.GetValueOrDefault("title")" class="form-control" required/>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold small">Category</label>
            <select name="category" class="form-select">
                @foreach(var c in new[]{"Hardware","Software","Network","Email / M365","Server","Security","Training","Process Improvement","Procurement","Other"})
                {if(Model.GetValueOrDefault("category")?.ToString()==c){<option selected>@c</option>}else{<option>@c</option>}}
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold small">Priority</label>
            <select name="priority" class="form-select">
                @foreach(var p in new[]{"High","Medium","Low"})
                {if(Model.GetValueOrDefault("priority")?.ToString()==p){<option selected>@p</option>}else{<option>@p</option>}}
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold small">Department</label>
            <select name="department" class="form-select">
                @foreach(var d in depts)
                {if(Model.GetValueOrDefault("department")?.ToString()==d){<option selected>@d</option>}else{<option>@d</option>}}
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold small">Target Date</label>
            <input type="date" name="targetDate" value="@Model.GetValueOrDefault("targetDate")" class="form-control"/>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold small">Status</label>
            <select name="status" class="form-select">
                @foreach(var s in new[]{"Not Started","In Progress","On Hold","Completed","Cancelled"})
                {if(Model.GetValueOrDefault("status")?.ToString()==s){<option selected>@s</option>}else{<option>@s</option>}}
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold small">% Progress</label>
            <input type="number" name="progress" value="@Model.GetValueOrDefault("progress")" class="form-control" min="0" max="100"/>
        </div>
        <div class="col-12">
            <label class="form-label fw-bold small">Remarks</label>
            <textarea name="remarks" class="form-control" rows="2">@Model.GetValueOrDefault("remarks")</textarea>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save</button>
        <a href="/Goals/Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>
</div>
</div>
</div>
</div>
