@model List<Dictionary<string,object?>>
@{ViewData["Title"] = "IT Goals"; int curWeek = ViewBag.CurrentWeek; int maxWeek = ViewBag.MaxWeek;}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-bullseye text-info"></i> IT Weekly Goals — Week @curWeek</h5>
    <div class="d-flex gap-2 align-items-center">
        <a href="?week=@(curWeek>1?curWeek-1:1)" class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left"></i></a>
        <span class="badge bg-primary px-3 py-2">Week @curWeek / @maxWeek</span>
        <a href="?week=@(curWeek<maxWeek?curWeek+1:maxWeek)" class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-right"></i></a>
    </div>
</div>

<!-- Summary -->
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-light text-center py-2">
            <div class="fw-bold fs-4">@ViewBag.Total</div>
            <div class="small text-muted">Total</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-success-subtle text-center py-2">
            <div class="fw-bold fs-4 text-success">@ViewBag.Completed</div>
            <div class="small text-muted">Completed</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-primary-subtle text-center py-2">
            <div class="fw-bold fs-4 text-primary">@ViewBag.InProg</div>
            <div class="small text-muted">In Progress</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-warning-subtle text-center py-2">
            @{int pct = ViewBag.Total > 0 ? (int)Math.Round((double)ViewBag.Completed / (double)ViewBag.Total * 100) : 0;}
            <div class="fw-bold fs-4 text-warning">@pct%</div>
            <div class="small text-muted">Complete</div>
        </div>
    </div>
</div>

<!-- Filter -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="week" value="@curWeek"/>
            <select name="status" class="form-select form-select-sm" style="width:160px">
                <option value="">All Status</option>
                @foreach(var s in new[]{"Not Started","In Progress","On Hold","Completed","Cancelled"})
                {<option @(ViewBag.StatusFilter==s?"selected":"")>@s</option>}
            </select>
            <button class="btn btn-primary btn-sm px-3">Filter</button>
            <a href="?week=@curWeek" class="btn btn-outline-secondary btn-sm">Clear</a>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#0A192F;color:white">
                <tr>
                    <th class="ps-3">#</th>
                    <th>Goal / Task</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Department</th>
                    <th>Target Date</th>
                    <th>Progress</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {<tr><td colspan="9" class="text-center text-muted py-5">No goals for week @curWeek</td></tr>}
            @{int sno = 0;}
            @foreach (var g in Model)
            {
                sno++;
                var status   = g.GetValueOrDefault("status")?.ToString() ?? "Not Started";
                var priority = g.GetValueOrDefault("priority")?.ToString() ?? "Medium";
                var sBadge   = status == "Completed" ? "success" : status == "In Progress" ? "primary" : status == "On Hold" ? "warning" : status == "Cancelled" ? "secondary" : "danger";
                var pBadge   = priority == "High" ? "danger" : priority == "Medium" ? "warning" : "secondary";
                int prog = 0; int.TryParse(g.GetValueOrDefault("progress")?.ToString(), out prog);
                bool pending = g.GetValueOrDefault("isPending")?.ToString() == "True";
                <tr class="@(status=="Completed"?"table-success opacity-75":"")">
                    <td class="ps-3 text-muted">@sno</td>
                    <td>
                        <strong>@g.GetValueOrDefault("title")</strong>
                        @if(pending){<br/><span class="badge bg-purple-subtle text-purple small" style="background:#EDE9FE;color:#5B21B6">Pending from Wk @g.GetValueOrDefault("pendingFromWeek")</span>}
                        @if(!string.IsNullOrEmpty(g.GetValueOrDefault("remarks")?.ToString())){
                            <br/><small class="text-muted">@g.GetValueOrDefault("remarks")</small>}
                    </td>
                    <td class="small text-muted">@g.GetValueOrDefault("category")</td>
                    <td><span class="badge bg-@pBadge">@priority</span></td>
                    <td class="small">@g.GetValueOrDefault("department")</td>
                    <td class="small text-muted">@g.GetValueOrDefault("targetDate")</td>
                    <td style="min-width:100px">
                        <div class="progress" style="height:6px">
                            <div class="progress-bar bg-@sBadge" style="width:@prog%"></div>
                        </div>
                        <small class="text-muted">@prog%</small>
                    </td>
                    <td><span class="badge bg-@sBadge">@status</span></td>
                    <td>
                        @if (status != "Completed")
                        {
                            <button class="btn btn-success btn-sm" onclick="completeGoal('@g.GetValueOrDefault("id")')">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function completeGoal(id) {
    if (!confirm('Mark this goal as Complete?')) return;
    fetch('/Goals/Complete/' + id, {method:'POST'})
        .then(r => r.json()).then(d => { if(d.ok) location.reload(); });
}
</script>
}
