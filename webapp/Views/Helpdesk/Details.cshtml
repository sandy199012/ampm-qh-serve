@model Dictionary<string,object?>
@{
    ViewData["Title"] = "Ticket Details";
    var tid = Model.GetValueOrDefault("ticketId")?.ToString() ?? "";
    var status = Model.GetValueOrDefault("status")?.ToString() ?? "Open";
    var priority = Model.GetValueOrDefault("priority")?.ToString() ?? "Medium";
    var sBadge = status=="Open"?"danger":status=="In Progress"?"primary":status=="Resolved"?"success":"secondary";
    var pBadge = priority=="Critical"?"danger":priority=="High"?"warning":priority=="Medium"?"info":"secondary";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Helpdesk/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0 font-monospace">@tid</h5>
    <span class="badge bg-@sBadge">@status</span>
    <span class="badge bg-@pBadge">@priority</span>
    <button class="btn btn-outline-danger btn-sm ms-auto" onclick="openEmailModal()"><i class="bi bi-envelope"></i> Email Ticket</button>
    <a href="/Helpdesk/EmailSettings" class="btn btn-outline-secondary btn-sm" title="Email Settings"><i class="bi bi-gear"></i></a>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-bold" style="background:#0A192F;color:white">Issue Details</div>
            <div class="card-body">
                <h6 class="fw-bold">@Model.GetValueOrDefault("title")</h6>
                <p class="text-muted">@Model.GetValueOrDefault("description")</p>
                <div class="row g-2 mt-2">
                    <div class="col-md-4"><small class="text-muted d-block">Issue Type</small><strong>@Model.GetValueOrDefault("issueType")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Category</small><strong>@Model.GetValueOrDefault("category")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Assigned To</small><strong>@Model.GetValueOrDefault("assignedTo")</strong></div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-bold" style="background:#1e3a5f;color:white">Employee Info</div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-4"><small class="text-muted d-block">Name</small><strong>@Model.GetValueOrDefault("empName")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Designation</small><strong>@Model.GetValueOrDefault("empDesig")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">HOD</small><strong>@Model.GetValueOrDefault("empHod")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Department</small><strong>@Model.GetValueOrDefault("empDept")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Mobile</small><strong>@Model.GetValueOrDefault("empMobile")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Email</small><strong>@Model.GetValueOrDefault("empEmail")</strong></div>
                    <div class="col-md-4"><small class="text-muted d-block">Emp Code</small><strong>@Model.GetValueOrDefault("empId")</strong></div>
                </div>
            </div>
        </div>
        @if(!string.IsNullOrEmpty(Model.GetValueOrDefault("resolution")?.ToString())){
        <div class="card border-0 shadow-sm border-success">
            <div class="card-header fw-bold bg-success text-white">Resolution</div>
            <div class="card-body">@Model.GetValueOrDefault("resolution")</div>
        </div>}
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-bold" style="background:#059669;color:white">Timeline</div>
            <div class="card-body">
                <small class="text-muted d-block">Date Raised</small>
                <strong>@Model.GetValueOrDefault("dateRaised")</strong>
                @if(!string.IsNullOrEmpty(Model.GetValueOrDefault("dateAcknowledged")?.ToString())){
                    <small class="text-muted d-block mt-2">Date Acknowledged</small>
                    <strong class="text-primary">@Model.GetValueOrDefault("dateAcknowledged")</strong>
                }
                @if(!string.IsNullOrEmpty(Model.GetValueOrDefault("dateResolved")?.ToString())){
                    <small class="text-muted d-block mt-2">Date Resolved</small>
                    <strong class="text-success">@Model.GetValueOrDefault("dateResolved")</strong>
                }
                @if(!string.IsNullOrEmpty(Model.GetValueOrDefault("dateClosed")?.ToString())){
                    <small class="text-muted d-block mt-2">Date Closed</small>
                    <strong class="text-secondary">@Model.GetValueOrDefault("dateClosed")</strong>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold" style="background:#7C3AED;color:white">Update Status</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button class="btn btn-primary btn-sm" onclick="updateStatus('@tid','In Progress')"><i class="bi bi-play-circle"></i> In Progress</button>
                    <button class="btn btn-success btn-sm" onclick="showResolve('@tid')"><i class="bi bi-check-circle"></i> Resolve</button>
                    <button class="btn btn-secondary btn-sm" onclick="updateStatus('@tid','Closed')"><i class="bi bi-x-circle"></i> Close</button>
                </div>
                <div id="resolveDiv" class="mt-3 d-none">
                    <textarea id="resolutionText" class="form-control form-control-sm mb-2" rows="3" placeholder="Resolution notes..."></textarea>
                    <button class="btn btn-success btn-sm w-100" onclick="submitResolve('@tid')">Submit Resolution</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Email Ticket Modal ═══ -->
<div class="modal fade" id="emailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#0A192F;color:white">
                <h5 class="modal-title"><i class="bi bi-envelope"></i> Email Ticket @tid</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (ViewBag.EmailConfigured != true)
                {
                    <div class="alert alert-warning small">
                        <i class="bi bi-exclamation-triangle"></i> SMTP abhi set nahi hai, isliye "Send Email" kaam nahi karega — pehle <a href="/Helpdesk/EmailSettings">Email Settings</a> mein apna Office 365 account jodo. Tab tak neeche diye Outlook/Gmail buttons se manually bhej sakte ho (plain text).
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label fw-bold small">To (Employee Email)</label>
                    <input type="email" id="emailTo" class="form-control" placeholder="employee@ampm.in"/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">CC</label>
                    <input type="text" id="emailCc" class="form-control" readonly/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">Subject</label>
                    <input type="text" id="emailSubject" class="form-control" readonly/>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-bold small">Message Preview (this exact formatted email is what gets sent)</label>
                    <iframe id="emailPreviewFrame" style="width:100%;height:340px;border:1px solid #E5E7EB;border-radius:4px"></iframe>
                </div>
                <div id="emailStatusMsg"></div>
            </div>
            <div class="modal-footer flex-wrap">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-outline-primary btn-sm" onclick="sendViaOutlook()"><i class="bi bi-envelope"></i> Outlook / Default Mail (plain text)</button>
                <button class="btn btn-outline-danger btn-sm" onclick="sendViaGmail()"><i class="bi bi-google"></i> Gmail (plain text)</button>
                <button class="btn btn-success" id="sendEmailBtn" onclick="sendEmailNow()"><i class="bi bi-send"></i> Send Email</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const ticket = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
const itEmail = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ItEmail));
const ccEmails = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CcEmails));
const sendOnClose = @Html.Raw(ViewBag.SendOnClose ? "true" : "false");

function updateStatus(id, status) {
    fetch('/Helpdesk/UpdateStatus/' + id, {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded'},
        body: 'status=' + encodeURIComponent(status)
    }).then(r => r.json()).then(d => { if(d.ok) location.reload(); });
}
function showResolve(id) {
    document.getElementById('resolveDiv').classList.remove('d-none');
}
function submitResolve(id) {
    var res = document.getElementById('resolutionText').value;
    fetch('/Helpdesk/UpdateStatus/' + id, {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded'},
        body: 'status=Resolved&resolution=' + encodeURIComponent(res)
    }).then(r => r.json()).then(d => {
        if (!d.ok) return;
        if (sendOnClose && confirm('Ticket resolved! Employee ko resolution email bhejni hai?')) {
            location.href = '/Helpdesk/Details/' + id + '?openEmail=1';
        } else {
            location.reload();
        }
    });
}

// ───────────── Email Ticket ─────────────
function buildEmailBody() {
    const div  = '='.repeat(59);
    const div2 = '-'.repeat(59);
    const isResolved = ticket.status === 'Resolved' || ticket.status === 'Closed';
    let body = `Dear ${ticket.empName || ''},\n\n`;
    body += isResolved
        ? `Your IT support request has been resolved. Please find the details below.\n\n`
        : `Your IT support request has been registered. Our team will get back to you shortly.\n\n`;
    body += `${div}\n  IT HELPDESK - SUPPORT TICKET\n  AMPM FASHIONS PVT LTD\n${div}\n\n`;
    body += `  TICKET REFERENCE   :  ${ticket.ticketId || ''}\n`;
    body += `  STATUS             :  ${(ticket.status || '').toUpperCase()}\n`;
    body += `  PRIORITY           :  ${(ticket.priority || '').toUpperCase()}\n`;
    body += `  DATE RAISED        :  ${ticket.dateRaised || ''}\n`;
    if (ticket.dateAcknowledged) body += `  ACKNOWLEDGED       :  ${ticket.dateAcknowledged}\n`;
    if (ticket.dateResolved) body += `  RESOLVED ON        :  ${ticket.dateResolved}\n`;
    if (ticket.dateClosed) body += `  CLOSED ON          :  ${ticket.dateClosed}\n`;
    if (ticket.resolutionHrs) body += `  RESOLUTION TIME    :  ${ticket.resolutionHrs} hrs\n`;
    body += `\n${div2}\n  EMPLOYEE DETAILS\n${div2}\n`;
    body += `  Name               :  ${ticket.empName || ''}\n`;
    body += `  Employee ID        :  ${ticket.empId || ''}\n`;
    body += `  Designation        :  ${ticket.empDesig || ''}\n`;
    body += `  Department         :  ${ticket.empDept || ''}\n`;
    body += `  HOD / Manager      :  ${ticket.empHod || ''}\n`;
    body += `  Mobile             :  ${ticket.empMobile || ''}\n`;
    body += `\n${div2}\n  ISSUE DETAILS\n${div2}\n`;
    body += `  Issue Type         :  ${ticket.issueType || ''}\n`;
    body += `  Category           :  ${ticket.category || ''}\n`;
    body += `  Title              :  ${ticket.title || ''}\n`;
    body += `  Assigned To        :  ${ticket.assignedTo || ''}\n`;
    body += `\n${div2}\n  DESCRIPTION\n${div2}\n  ${ticket.description || ''}\n`;
    if (ticket.resolution) body += `\n${div2}\n  RESOLUTION / FIX APPLIED\n${div2}\n  ${ticket.resolution}\n`;
    body += `\n${div}\n\n  Sandeep Kumar Singh Kushwaha\n  IT - System Administrator\n  AMPM Fashions Pvt Ltd\n  B-144, Sector 10, Noida - 201301\n\n`;
    body += `${div}\n  This is a system-generated email from AMPM IT Helpdesk.\n  Please do not reply directly to this message.\n${div}`;
    return body;
}

function openEmailModal() {
    document.getElementById('emailTo').value = ticket.empEmail || '';
    const cc = [itEmail, ccEmails].filter(Boolean).join(', ');
    document.getElementById('emailCc').value = cc;
    document.getElementById('emailSubject').value = `[${ticket.ticketId}] [${ticket.priority}] ${ticket.title}`;
    document.getElementById('emailPreviewFrame').src = '/Helpdesk/EmailPreview/' + encodeURIComponent(ticket.ticketId);
    document.getElementById('emailStatusMsg').innerHTML = '';
    new bootstrap.Modal(document.getElementById('emailModal')).show();
}

function ensureEmpEmail() {
    let to = document.getElementById('emailTo').value.trim();
    if (!to) {
        to = prompt('Employee ka email address:', '');
        if (!to) return null;
        document.getElementById('emailTo').value = to;
        fetch('/Helpdesk/SetEmpEmail', {
            method: 'POST',
            headers: {'Content-Type':'application/x-www-form-urlencoded'},
            body: 'id=' + encodeURIComponent(ticket.ticketId) + '&email=' + encodeURIComponent(to)
        });
        ticket.empEmail = to;
    }
    return to;
}

function sendViaOutlook() {
    const to = ensureEmpEmail();
    if (!to) return;
    const cc = document.getElementById('emailCc').value;
    const subject = document.getElementById('emailSubject').value;
    const body = buildEmailBody();
    let mailto = 'mailto:' + encodeURIComponent(to) + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    if (cc) mailto += '&cc=' + encodeURIComponent(cc);
    window.location.href = mailto;
}

function sendViaGmail() {
    const to = ensureEmpEmail();
    if (!to) return;
    const cc = document.getElementById('emailCc').value;
    const subject = document.getElementById('emailSubject').value;
    const body = buildEmailBody();
    let url = 'https://mail.google.com/mail/?view=cm&to=' + encodeURIComponent(to) + '&su=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    if (cc) url += '&cc=' + encodeURIComponent(cc);
    window.open(url, '_blank');
}

function sendEmailNow() {
    const to = ensureEmpEmail();
    if (!to) return;
    const btn = document.getElementById('sendEmailBtn');
    const statusEl = document.getElementById('emailStatusMsg');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';
    statusEl.innerHTML = '';
    fetch('/Helpdesk/SendTicketEmail', {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded'},
        body: 'id=' + encodeURIComponent(ticket.ticketId) + '&to=' + encodeURIComponent(to)
    }).then(r => r.json()).then(d => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send"></i> Send Email';
        if (d.ok) {
            statusEl.innerHTML = '<div class="alert alert-success small mb-0"><i class="bi bi-check-circle"></i> Email bhej diya gaya ' + to + ' ko!</div>';
        } else {
            statusEl.innerHTML = '<div class="alert alert-danger small mb-0"><i class="bi bi-x-circle"></i> Bhej nahi paya: ' + (d.error || 'Unknown error') + '</div>';
        }
    }).catch(err => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send"></i> Send Email';
        statusEl.innerHTML = '<div class="alert alert-danger small mb-0">Error: ' + err + '</div>';
    });
}

window.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(location.search);
    if (params.get('openEmail') === '1') openEmailModal();
});
</script>
}
