@model List<Dictionary<string,object?>>
@{ViewData["Title"] = "Helpdesk";}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-headset text-danger"></i> Helpdesk Tickets</h5>
    <button id="soundAlertBtn" class="btn btn-sm px-3" onclick="toggleSoundAlerts()" title="Play a sound and show a browser notification whenever a new ticket is raised, while this page is open"></button>
    <a href="/Helpdesk/EmailSettings" class="btn btn-outline-secondary btn-sm px-3" title="Email Settings"><i class="bi bi-envelope-gear"></i></a>
    <a href="/Helpdesk/Export?status=@ViewBag.Status&priority=@ViewBag.Priority" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-file-earmark-excel"></i> Excel Report</a>
    <a href="/Helpdesk/Create" class="btn btn-danger btn-sm px-3">
        <i class="bi bi-plus-circle"></i> New Ticket
    </a>
</div>

<div id="newTicketAlerts"></div>

@{
    var open     = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "Open");
    var inprog   = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "In Progress");
    var resolved = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "Resolved");
    var critical = Model.Count(t => t.GetValueOrDefault("priority")?.ToString() == "Critical");
    // Baseline for the sound-alert poller below — the newest ticket ID already
    // on this page, so it only alerts for tickets raised AFTER the page loaded.
    var latestTicketId = Model.Any() ? Model.Max(t => t.GetValueOrDefault("ticketId")?.ToString() ?? "") : "";
}
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-danger-subtle text-center py-2">
            <div class="fw-bold fs-4 text-danger">@open</div>
            <div class="small text-muted">Open</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-primary-subtle text-center py-2">
            <div class="fw-bold fs-4 text-primary">@inprog</div>
            <div class="small text-muted">In Progress</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-success-subtle text-center py-2">
            <div class="fw-bold fs-4 text-success">@resolved</div>
            <div class="small text-muted">Resolved</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-warning-subtle text-center py-2">
            <div class="fw-bold fs-4 text-warning">@critical</div>
            <div class="small text-muted">Critical</div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    @{ var curStatus = ViewBag.Status?.ToString() ?? ""; }
                    @foreach (var s in new[]{"Open","In Progress","Resolved","Closed"})
                    {
                        if (curStatus == s) { <option selected>@s</option> }
                        else { <option>@s</option> }
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="priority" class="form-select form-select-sm">
                    <option value="">All Priority</option>
                    @{ var curPrio = ViewBag.Priority?.ToString() ?? ""; }
                    @foreach (var p in new[]{"Critical","High","Medium","Low"})
                    {
                        if (curPrio == p) { <option selected>@p</option> }
                        else { <option>@p</option> }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm px-3">Filter</button>
                <a href="/Helpdesk" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#0A192F;color:white">
                <tr>
                    <th class="ps-3">Ticket ID</th>
                    <th>Date</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Issue</th>
                    <th>Priority</th>
                    <th>Assigned</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-5">No tickets found</td></tr>
            }
            @foreach (var t in Model)
            {
                var tid      = t.GetValueOrDefault("ticketId")?.ToString() ?? "";
                var status   = t.GetValueOrDefault("status")?.ToString() ?? "Open";
                var priority = t.GetValueOrDefault("priority")?.ToString() ?? "Medium";
                var sBadge   = status == "Open" ? "danger" : status == "In Progress" ? "primary" : status == "Resolved" ? "success" : "secondary";
                var pBadge   = priority == "Critical" ? "danger" : priority == "High" ? "warning" : priority == "Medium" ? "info" : "secondary";
                <tr>
                    <td class="ps-3 font-monospace fw-bold small text-primary">@tid</td>
                    <td class="small text-muted">@t.GetValueOrDefault("dateRaised")</td>
                    <td><strong class="small">@t.GetValueOrDefault("empName")</strong></td>
                    <td><span class="badge bg-light text-dark border small">@t.GetValueOrDefault("empDept")</span></td>
                    <td class="small text-truncate" style="max-width:180px">@t.GetValueOrDefault("title")</td>
                    <td><span class="badge bg-@pBadge">@priority</span></td>
                    <td class="small">@t.GetValueOrDefault("assignedTo")</td>
                    <td>
                        <span class="badge bg-@sBadge">@status</span>
                        @{ var eta = t.GetValueOrDefault("expectedResolution")?.ToString(); }
                        @if (!string.IsNullOrEmpty(eta))
                        {
                            <div class="small text-warning mt-1" style="white-space:nowrap"><i class="bi bi-hourglass-split"></i> @eta</div>
                        }
                    </td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Act</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Helpdesk/Details/@tid"><i class="bi bi-eye"></i> View</a></li>
                                <li><a class="dropdown-item text-danger" href="/Helpdesk/Details/@tid?openEmail=1"><i class="bi bi-envelope"></i> Email</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><a class="dropdown-item text-primary" href="#" onclick="updateStatus('@tid','In Progress')"><i class="bi bi-play-circle"></i> In Progress</a></li>
                                <li><a class="dropdown-item text-success" href="#" onclick="updateStatus('@tid','Resolved')"><i class="bi bi-check-circle"></i> Resolved</a></li>
                                <li><a class="dropdown-item text-secondary" href="#" onclick="updateStatus('@tid','Closed')"><i class="bi bi-x-circle"></i> Close</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function updateStatus(id, status) {
    let extra = '';
    if (status === 'In Progress') {
        const comment = prompt('Acknowledging this ticket — enter a comment:');
        if (comment === null) return;
        extra = '&ackComment=' + encodeURIComponent(comment.trim());
        const eta = prompt('Expected time line to resolve? (e.g. "2 days", "25-Sep-2026", "By tomorrow evening") — the employee will see this. Leave blank to skip:');
        if (eta !== null && eta.trim()) extra += '&expectedResolution=' + encodeURIComponent(eta.trim());
    }
    fetch('/Helpdesk/UpdateStatus/' + id, {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded'},
        body: 'status=' + encodeURIComponent(status) + extra
    }).then(r => r.json()).then(d => { if(d.ok) location.reload(); });
}

// ───────────── New-ticket sound + browser notification alert ─────────────
// Polls every 20s for tickets raised after the newest one already on this
// page, and — if the admin has turned alerts on — plays a short beep (via
// the Web Audio API, so no audio file needs to ship with the app), shows a
// desktop/browser Notification, and drops a dismissible banner above the
// table. Browsers block audio/notifications without a real user click first,
// which is exactly what the "Sound Alerts" button provides.
function esc(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

let lastSeenTicketId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(latestTicketId));
let soundAlertsOn = localStorage.getItem('helpdesk_sound_alerts') === 'on';
let audioCtx = null;

function updateAlertButton() {
    const btn = document.getElementById('soundAlertBtn');
    if (!btn) return;
    btn.innerHTML = soundAlertsOn ? '<i class="bi bi-bell-fill"></i> Sound Alerts: ON' : '<i class="bi bi-bell-slash"></i> Sound Alerts: OFF';
    btn.className = 'btn btn-sm px-3 ' + (soundAlertsOn ? 'btn-success' : 'btn-outline-secondary');
}

function toggleSoundAlerts() {
    soundAlertsOn = !soundAlertsOn;
    localStorage.setItem('helpdesk_sound_alerts', soundAlertsOn ? 'on' : 'off');
    if (soundAlertsOn) {
        // Unlock audio autoplay + ask for desktop notification permission —
        // both need a real user click, which this button click provides.
        try { audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
        if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission();
    }
    updateAlertButton();
}

function playAlertBeep() {
    if (!soundAlertsOn) return;
    try {
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        [0, 0.22].forEach(delay => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.value = 880;
            gain.gain.setValueAtTime(0.0001, audioCtx.currentTime + delay);
            gain.gain.exponentialRampToValueAtTime(0.3, audioCtx.currentTime + delay + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + delay + 0.18);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(audioCtx.currentTime + delay);
            osc.stop(audioCtx.currentTime + delay + 0.2);
        });
    } catch(e) {}
}

function showNewTicketBanner(t) {
    const box = document.getElementById('newTicketAlerts');
    if (!box) return;
    const div = document.createElement('div');
    div.className = 'alert alert-danger d-flex justify-content-between align-items-center shadow-sm mb-2';
    div.innerHTML = `<div><i class="bi bi-bell-fill"></i> <strong>New ticket ${esc(t.ticketId)}</strong> — ${esc(t.title)}
        <span class="text-muted">(${esc(t.empName)}, ${esc(t.empDept)} &middot; ${esc(t.priority)} priority)</span></div>
        <div><a href="/Helpdesk/Details/${esc(t.ticketId)}" class="btn btn-sm btn-outline-dark me-2">View</a>
        <button class="btn btn-sm btn-outline-secondary" onclick="this.closest('.alert').remove()">Dismiss</button></div>`;
    box.prepend(div);
    if (soundAlertsOn && 'Notification' in window && Notification.permission === 'granted') {
        new Notification('New Helpdesk Ticket — ' + t.ticketId, {
            body: t.title + '\n' + t.empName + ' (' + t.empDept + ') · ' + t.priority + ' priority'
        });
    }
}

async function pollNewTickets() {
    try {
        const res = await fetch('/Helpdesk/PollNewTickets?after=' + encodeURIComponent(lastSeenTicketId));
        const d = await res.json();
        if (d.tickets && d.tickets.length) {
            d.tickets.forEach(t => showNewTicketBanner(t));
            playAlertBeep();
        }
        if (d.latestId) lastSeenTicketId = d.latestId;
    } catch(e) {}
}

updateAlertButton();
setInterval(pollNewTickets, 20000);
</script>
}
