@model List<Dictionary<string,object?>>
@{ViewData["Title"] = "Helpdesk";}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-headset text-danger"></i> Helpdesk Tickets</h5>
    <a href="/Helpdesk/Create" class="btn btn-danger btn-sm px-3">
        <i class="bi bi-plus-circle"></i> New Ticket
    </a>
</div>

<!-- Stats Row -->
<div class="row g-2 mb-3">
    @{
        var open     = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "Open");
        var inprog   = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "In Progress");
        var resolved = Model.Count(t => t.GetValueOrDefault("status")?.ToString() == "Resolved");
        var critical = Model.Count(t => t.GetValueOrDefault("priority")?.ToString() == "Critical");
    }
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-danger-subtle text-center py-2">
            <div class="fw-bold fs-4 text-danger">@open</div>
            <div class="small text-muted">Open</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-primary-subtle text-center py-2">
            <div class="fw-bold fs-4 text-primary">@inprog</div>
            <div class="small text-muted">In Progress</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-success-subtle text-center py-2">
            <div class="fw-bold fs-4 text-success">@resolved</div>
            <div class="small text-muted">Resolved</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-warning-subtle text-center py-2">
            <div class="fw-bold fs-4 text-warning">@critical</div>
            <div class="small text-muted">Critical</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    <option value="Open"        @(ViewBag.Status=="Open"?"selected":"")>Open</option>
                    <option value="In Progress" @(ViewBag.Status=="In Progress"?"selected":"")>In Progress</option>
                    <option value="Resolved"    @(ViewBag.Status=="Resolved"?"selected":"")>Resolved</option>
                    <option value="Closed"      @(ViewBag.Status=="Closed"?"selected":"")>Closed</option>
                </select>
            </div>
            <div class="col-auto">
                <select name="priority" class="form-select form-select-sm">
                    <option value="">All Priority</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm px-3">Filter</button>
                <a href="/Helpdesk" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background:#0A192F;color:white">
                <tr>
                    <th class="ps-3">Ticket ID</th>
                    <th>Date</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Issue</th>
                    <th>Type</th>
                    <th>Priority</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-5">No tickets found</td></tr>
            }
            @foreach (var t in Model)
            {
                var tid      = t.GetValueOrDefault("ticketId")?.ToString() ?? "";
                var status   = t.GetValueOrDefault("status")?.ToString() ?? "Open";
                var priority = t.GetValueOrDefault("priority")?.ToString() ?? "Medium";
                var sBadge   = status == "Open" ? "danger" : status == "In Progress" ? "primary" : status == "Resolved" ? "success" : "secondary";
                var pBadge   = priority == "Critical" ? "danger" : priority == "High" ? "warning" : priority == "Medium" ? "info" : "secondary";
                <tr>
                    <td class="ps-3 font-monospace fw-bold small text-primary">@tid</td>
                    <td class="small text-muted">@t.GetValueOrDefault("dateRaised")</td>
                    <td><strong class="small">@t.GetValueOrDefault("empName")</strong></td>
                    <td><span class="badge bg-light text-dark border small">@t.GetValueOrDefault("empDept")</span></td>
                    <td class="text-truncate small" style="max-width:180px">@t.GetValueOrDefault("title")</td>
                    <td class="small text-muted">@t.GetValueOrDefault("issueType")</td>
                    <td><span class="badge bg-@pBadge">@priority</span></td>
                    <td class="small">@t.GetValueOrDefault("assignedTo")</td>
                    <td>
                        <span class="badge bg-@sBadge">@status</span>
                    </td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                Action
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Helpdesk/Details/@tid"><i class="bi bi-eye"></i> View</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><a class="dropdown-item text-primary" href="#" onclick="updateStatus('@tid','In Progress')"><i class="bi bi-play-circle"></i> In Progress</a></li>
                                <li><a class="dropdown-item text-success" href="#" onclick="updateStatus('@tid','Resolved')"><i class="bi bi-check-circle"></i> Resolved</a></li>
                                <li><a class="dropdown-item text-secondary" href="#" onclick="updateStatus('@tid','Closed')"><i class="bi bi-x-circle"></i> Close</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function updateStatus(id, status) {
    fetch('/Helpdesk/UpdateStatus/' + id, {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded'},
        body: 'status=' + encodeURIComponent(status)
    }).then(r => r.json()).then(d => {
        if (d.ok) location.reload();
    });
}
</script>
}
