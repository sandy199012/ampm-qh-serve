@{
    var modules = (string[])ViewBag.Modules;
    var labels = (Dictionary<string,string>)ViewBag.ModuleLabels;
    var perms = (Dictionary<string, AMPMWeb.Services.ModulePermission>)ViewBag.Perms;
}
<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Module</th>
                <th class="text-center" style="width:110px">View</th>
                <th class="text-center" style="width:130px">Approve</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in modules)
            {
                var p = perms.GetValueOrDefault(m);
                var view = p?.View ?? false;
                var approve = p?.Approve ?? false;
                <tr>
                    <td>@labels.GetValueOrDefault(m, m)</td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input" name="view_@m" @(view ? "checked" : "")/>
                    </td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input" name="approve_@m" @(approve ? "checked" : "")/>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="small text-muted mt-2"><i class="bi bi-info-circle"></i> "View" se woh module dikhega, "Approve" se us module ke andar approve/resolve actions bhi kar payega. Admin/Super Admin role automatically sabhi modules access kar sakta hai — yeh checklist sirf "User" role ke liye lagu hoti hai.</div>
