@{
    ViewData["Title"] = "New User";
}
<div class="d-flex align-items-center mb-3 gap-3">
    <a href="/Users/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0"><i class="bi bi-person-plus"></i> New User</h5>
</div>

<form method="post" action="/Users/Create">
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header fw-bold" style="background:#0A192F;color:white">Account Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Select Employee <span class="text-muted">(optional — auto-fills the details below)</span></label>
                    <select id="empPicker" class="form-select" onchange="fillFromEmployee()">
                        <option value="">-- Select Employee --</option>
                        @{ var employees = (List<Dictionary<string,object?>>)ViewBag.Employees; }
                        @foreach (var e in employees)
                        {
                            var code = e.GetValueOrDefault("emp")?.ToString() ?? "";
                            var nm   = e.GetValueOrDefault("name")?.ToString() ?? "";
                            var dept = e.GetValueOrDefault("dept")?.ToString() ?? "";
                            <option value="@code" data-name="@nm" data-dept="@dept">@nm (@code)@(string.IsNullOrEmpty(dept) ? "" : " — " + dept)</option>
                        }
                    </select>
                    <div class="form-text">Picking a name fills in Username, Full Name, Department and Employee Code below — you still set the password yourself.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Username</label>
                    <input type="text" name="username" class="form-control" required autofocus/>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Password</label>
                    <input type="password" name="password" class="form-control" required/>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Full Name</label>
                    <input type="text" name="name" class="form-control"/>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Department</label>
                    <input type="text" name="department" class="form-control" placeholder="e.g. HR, Production, Design"/>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Role</label>
                    <select name="role" class="form-select">
                        <option value="user" selected>User (module permissions apply)</option>
                        <option value="admin">Admin (full access, can manage users)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small">Employee Code <span class="text-muted">(for mobile app, optional)</span></label>
                    <input type="text" name="empId" class="form-control" placeholder="e.g. AMPM123"/>
                    <div class="form-text">Enter the Emp Code from the Employees list so the mobile app shows only this employee's tickets.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header fw-bold" style="background:#1e3a5f;color:white">Module Permissions</div>
        <div class="card-body">
            @await Html.PartialAsync("_PermissionsGrid")
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Create User</button>
    <a href="/Users/Index" class="btn btn-secondary">Cancel</a>
</form>

<script>
function fillFromEmployee() {
    const sel = document.getElementById('empPicker');
    const opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.value) return;
    document.querySelector('input[name="empId"]').value = opt.value;
    document.querySelector('input[name="name"]').value = opt.dataset.name || '';
    document.querySelector('input[name="department"]').value = opt.dataset.dept || '';
    // Mobile logins use the Employee Code as the username — suggest it, but
    // don't overwrite anything Sandy may have already typed in manually.
    const userField = document.querySelector('input[name="username"]');
    if (!userField.value.trim()) userField.value = opt.value;
}
</script>
