@model List<AMPMWeb.Services.UserRow>
@{
    ViewData["Title"] = "User Management";
    var modules = (string[])ViewBag.Modules;
    var labels = (Dictionary<string,string>)ViewBag.ModuleLabels;
    var permsByUser = (Dictionary<int, Dictionary<string, AMPMWeb.Services.ModulePermission>>)ViewBag.Perms;
}
<div class="d-flex align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-people-fill"></i> User Management</h5>
    <a href="/Users/Create" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-circle"></i> New User</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Modules Assigned</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var perms = permsByUser.GetValueOrDefault(u.Id) ?? new();
                    var assigned = modules.Where(m => perms.ContainsKey(m) && (perms[m].View || perms[m].Approve)).ToList();
                    <tr>
                        <td class="font-monospace">@u.Username</td>
                        <td>@u.Name</td>
                        <td>@u.Department</td>
                        <td>
                            @if (u.Role == "superadmin") { <span class="badge bg-dark">Super Admin</span> }
                            else if (u.Role == "admin") { <span class="badge bg-primary">Admin</span> }
                            else { <span class="badge bg-secondary">User</span> }
                        </td>
                        <td>
                            @if (u.IsActive == 1) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-danger">Disabled</span> }
                        </td>
                        <td>
                            @if (u.Role == "admin" || u.Role == "superadmin")
                            {
                                <span class="text-muted small">Full access (all modules)</span>
                            }
                            else if (assigned.Count == 0)
                            {
                                <span class="text-muted small">None assigned</span>
                            }
                            else
                            {
                                foreach (var m in assigned)
                                {
                                    var p = perms[m];
                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                        @labels.GetValueOrDefault(m, m)@(p.Approve ? " (View+Approve)" : " (View)")
                                    </span>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <a href="/Users/Edit/@u.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i></a>
                            @if (u.Role != "superadmin")
                            {
                                <form method="post" action="/Users/Delete/@u.Id" class="d-inline" onsubmit="return confirm('Is user ko delete karna hai?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
