            <td class="small text-end">${l.gst ? Number(l.gst).toLocaleString('en-IN') : ''}</td>
            <td class="small text-end text-muted">${gross ? gross.toLocaleString('en-IN', {maximumFractionDigits:2}) : ''}</td>
            <td class="small text-end">${l.tds ? Number(l.tds).toLocaleString('en-IN') : ''}</td>
            <td class="small text-end text-muted">${net ? net.toLocaleString('en-IN', {maximumFractionDigits:2}) : ''}</td>
            <td class="small text-muted">${esc(l.paymentDate)}</td>
            <td>${statusBadge}</td>
            <td class="small">${esc(l.paymentMode)}</td>
            <td class="small text-end">${l.budgetAmount ? Number(l.budgetAmount).toLocaleString('en-IN') : ''}</td>
            <td class="small text-end ${variance > 0 ? 'text-danger' : 'text-success'}">${variance !== '' ? variance.toLocaleString('en-IN', {maximumFractionDigits:2}) : ''}</td>
            <td class="small">${esc(l.capexOpex)}</td>
