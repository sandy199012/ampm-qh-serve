@section Scripts {
<script>
const endpoints = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
let pcs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(pcInv));
let licenses = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(licenses));
let softwareRegister = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(softwareRegister));
let onlineSubs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(onlineSubs));
let itSpendLog = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(itSpendLog));

// ───────────── Uptime Monitor (existing) ─────────────
async function checkOne(idx, url) {
    const card = document.getElementById('ep_' + idx);
    const badge = document.getElementById('status_' + idx);
    const msEl = document.getElementById('ms_' + idx);
    badge.className = 'badge bg-warning';
    badge.textContent = '⏳ Checking...';
    card.style.borderLeftColor = '#F59E0B';
    try {
        const res = await fetch('/api/endpoints/check?url=' + encodeURIComponent(url));
        const d = await res.json();
        if (d.ok && d.status < 400) {
            badge.className = 'badge bg-success';
            badge.textContent = '✅ Online (' + d.status + ')';
            card.style.borderLeftColor = '#10B981';
            msEl.textContent = d.ms + 'ms';
        } else {
            badge.className = 'badge bg-danger';
            badge.textContent = '❌ ' + (d.status || 'Error');
            card.style.borderLeftColor = '#EF4444';
            msEl.textContent = d.error ? d.error.substring(0,30) : '';
        }
    } catch(e) {
        badge.className = 'badge bg-danger';
        badge.textContent = '❌ Failed';
        card.style.borderLeftColor = '#EF4444';
    }
    updateSummary();
}

async function checkAll() {
    document.getElementById('lastCheck').textContent = 'Checking... please wait';
    const promises = endpoints.map((ep, i) => checkOne(i, ep.url));
    await Promise.all(promises);
    document.getElementById('lastCheck').textContent = 'Last checked: ' + new Date().toLocaleTimeString();
}

function updateSummary() {
    let up = 0, down = 0;
    document.querySelectorAll('[id^="status_"]').forEach(el => {
        if (el.textContent.includes('✅')) up++;
        else if (el.textContent.includes('❌')) down++;
    });
    document.getElementById('upCount').textContent = up;
    document.getElementById('downCount').textContent = down;
}

function addEndpoint() {
    new bootstrap.Modal(document.getElementById('addModal')).show();
}

function saveEndpoint() {
    const name = document.getElementById('newName').value.trim();
    const url  = document.getElementById('newUrl').value.trim();
    const cat  = document.getElementById('newCat').value;
    if (!name || !url) return alert('Name and URL required!');
    endpoints.push({ name, url, category: cat, enabled: true });
    fetch('/Endpoints/Save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(endpoints)
    }).then(() => location.reload());
}

window.addEventListener('DOMContentLoaded', () => { setTimeout(checkAll, 500); renderPc(); renderLic(); renderSwReg(); renderOnlineSub(); renderSpendLog(); });

// ───────────── PC Inventory & Antivirus ─────────────
function esc(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function renderPc() {
    const q = (document.getElementById('pcSearch')?.value || '').toLowerCase();
    const body = document.getElementById('pcTableBody');
    let rows = '';
    let total = 0, qhOk = 0, qhMissing = 0, qhStopped = 0;
    pcs.forEach((p, i) => {
        total++;
        const svc = (p.qhService || '').toString();
        if (svc === 'Running') qhOk++;
        else if (svc === 'Stopped') qhStopped++;
        else qhMissing++;
        const hay = [p.hostname, p.ip, p.user, p.notes].join(' ').toLowerCase();
        if (q && !hay.includes(q)) return;
        let svcBadge = svc === 'Running' ? '<span class="badge bg-success">Running</span>'
                     : svc === 'Stopped' ? '<span class="badge bg-warning">Stopped</span>'
                     : '<span class="badge bg-danger">Not Installed</span>';
        rows += `<tr>
            <td class="ps-3 fw-bold font-monospace">${esc(p.hostname)}</td>
            <td class="font-monospace small">${esc(p.ip)}</td>
            <td class="small">${esc(p.os)}</td>
            <td class="small">${esc(p.cpu)}</td>
            <td class="small">${esc(p.ramGb)}</td>
            <td class="small">${esc(p.diskFree)}</td>
            <td class="small">${esc(p.user)}</td>
            <td class="small">${esc(p.qhVersion)}</td>
            <td>${svcBadge}</td>
            <td class="small font-monospace">${esc(p.licenseKey)}</td>
            <td class="small text-muted">${esc(p.lastSeen)}</td>
            <td>${Array.isArray(p.software) && p.software.length
                ? `<button class="btn btn-outline-info btn-sm" onclick="viewSoftware(${i})"><i class="bi bi-box-seam"></i> ${p.software.length}</button>`
                : '<span class="text-muted small">—</span>'}</td>
            <td>
                <button class="btn btn-outline-warning btn-sm" onclick="openPcModal(${i})" title="Edit"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-outline-danger btn-sm" onclick="deletePc(${i})" title="Delete"><i class="bi bi-trash"></i></button>
            </td>
        </tr>`;
    });
    body.innerHTML = rows || '<tr><td colspan="13" class="text-center text-muted py-4">No PCs added yet</td></tr>';
    document.getElementById('pcTotal').textContent = total;
    document.getElementById('pcQhOk').textContent = qhOk;
    document.getElementById('pcQhMissing').textContent = qhMissing;
    document.getElementById('pcQhStopped').textContent = qhStopped;
}

function openPcModal(i) {
    document.getElementById('pcIdx').value = i;
    const p = i >= 0 ? pcs[i] : {};
    document.getElementById('pcModalTitle').textContent = i >= 0 ? 'Edit PC' : 'Add PC';
    document.getElementById('pcHostname').value = p.hostname || '';
    document.getElementById('pcIp').value = p.ip || '';
    document.getElementById('pcOs').value = p.os || '';
    document.getElementById('pcCpu').value = p.cpu || '';
    document.getElementById('pcRam').value = p.ramGb || '';
    document.getElementById('pcDisk').value = p.diskFree || '';
    document.getElementById('pcUser').value = p.user || '';
    document.getElementById('pcLastSeen').value = p.lastSeen || '';
    document.getElementById('pcQhVersion').value = p.qhVersion || '';
    document.getElementById('pcQhService').value = p.qhService || 'Not Installed';
    document.getElementById('pcLicenseKey').value = p.licenseKey || '';
    document.getElementById('pcNotes').value = p.notes || '';
    new bootstrap.Modal(document.getElementById('pcModal')).show();
}

function savePc() {
    const i = parseInt(document.getElementById('pcIdx').value);
    const hostname = document.getElementById('pcHostname').value.trim();
    if (!hostname) return alert('Hostname is required!');
    // Start from the existing record (if editing) so agent-reported fields like
    // "software" — which this form doesn't show — survive a manual save.
    const rec = Object.assign({}, (i >= 0 ? pcs[i] : {}), {
        hostname,
        ip: document.getElementById('pcIp').value.trim(),
        os: document.getElementById('pcOs').value.trim(),
        cpu: document.getElementById('pcCpu').value.trim(),
        ramGb: document.getElementById('pcRam').value.trim(),
        diskFree: document.getElementById('pcDisk').value.trim(),
        user: document.getElementById('pcUser').value.trim(),
        lastSeen: document.getElementById('pcLastSeen').value.trim(),
        qhVersion: document.getElementById('pcQhVersion').value.trim(),
        qhService: document.getElementById('pcQhService').value,
        licenseKey: document.getElementById('pcLicenseKey').value.trim(),
        notes: document.getElementById('pcNotes').value.trim()
    });
    if (i >= 0) pcs[i] = rec; else pcs.push(rec);
    persistPc(() => { renderPc(); bootstrap.Modal.getInstance(document.getElementById('pcModal')).hide(); });
}

function viewSoftware(i) {
    const p = pcs[i];
    const list = Array.isArray(p.software) ? p.software.slice().sort((a,b) => (a.name||'').localeCompare(b.name||'')) : [];
    document.getElementById('swModalTitle').textContent = `Installed Software — ${p.hostname} (${list.length})`;
    document.getElementById('swSearch').value = '';
    window._swList = list;
    renderSwList(list);
    new bootstrap.Modal(document.getElementById('softwareModal')).show();
}

function renderSwList(list) {
    const body = document.getElementById('swListBody');
    body.innerHTML = list.length
        ? list.map(s => `<tr><td>${esc(s.name)}</td><td class="text-muted small">${esc(s.version)}</td></tr>`).join('')
        : '<tr><td colspan="2" class="text-center text-muted py-3">No software reported</td></tr>';
}

function filterSwList() {
    const q = document.getElementById('swSearch').value.toLowerCase();
    const list = (window._swList || []).filter(s => (s.name||'').toLowerCase().includes(q));
    renderSwList(list);
}

function deletePc(i) {
    if (!confirm('Delete this PC record?')) return;
    const key = pcs[i].licenseKey;
    pcs.splice(i, 1);
    if (key) {
        const lic = licenses.find(l => l.licenseKey === key);
        if (lic) { lic.hostname = ''; lic.ip = ''; lic.loggedUser = ''; lic.assignedOn = ''; }
        persistLic(() => {});
    }
    persistPc(renderPc);
}

function persistPc(cb) {
    fetch('/Endpoints/SavePcInventory', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(pcs)
    }).then(() => cb && cb());
}

// ───────────── License Manager ─────────────
function computeLicStatus(l) {
    if (l.expiryDate) {
        const exp = new Date(l.expiryDate);
        const today = new Date(); today.setHours(0,0,0,0);
        if (!isNaN(exp) && exp < today) return 'Expired';
    }
    return l.hostname ? 'Assigned' : 'Unassigned';
}

function renderLic() {
    const body = document.getElementById('licTableBody');
    let rows = '';
    let total = 0, used = 0, free = 0, expiring = 0;
    const soon = new Date(); soon.setDate(soon.getDate() + 30);
    licenses.forEach((l, i) => {
        total++;
        const status = computeLicStatus(l);
        if (status === 'Assigned') used++;
        else if (status === 'Unassigned') free++;
        if (l.expiryDate) {
            const exp = new Date(l.expiryDate);
            if (!isNaN(exp) && exp <= soon && exp >= new Date()) expiring++;
        }
        let badge = status === 'Assigned' ? '<span class="badge bg-success">Assigned</span>'
                  : status === 'Expired' ? '<span class="badge bg-danger">Expired</span>'
                  : '<span class="badge bg-secondary">Unassigned</span>';
        rows += `<tr>
            <td class="ps-3">${i+1}</td>
            <td>${badge}</td>
            <td class="font-monospace small fw-bold">${esc(l.licenseKey)}</td>
            <td class="small">${esc(l.product)}</td>
            <td class="small">${esc(l.hostname)}</td>
            <td class="font-monospace small">${esc(l.ip)}</td>
            <td class="small">${esc(l.loggedUser)}</td>
            <td class="small text-muted">${esc(l.assignedOn)}</td>
            <td class="small text-muted">${esc(l.purchaseDate)}</td>
            <td class="small text-muted">${esc(l.expiryDate)}</td>
            <td>
                <button class="btn btn-outline-warning btn-sm" onclick="openLicModal(${i})" title="Edit"><i class="bi bi-pencil"></i></button>
                ${l.hostname ? `<button class="btn btn-outline-secondary btn-sm" onclick="unassignLic(${i})" title="Unassign"><i class="bi bi-x-circle"></i></button>` : ''}
                <button class="btn btn-outline-danger btn-sm" onclick="deleteLic(${i})" title="Delete"><i class="bi bi-trash"></i></button>
            </td>
        </tr>`;
    });
    body.innerHTML = rows || '<tr><td colspan="11" class="text-center text-muted py-4">No licenses added yet</td></tr>';
    document.getElementById('licTotal').textContent = total;
    document.getElementById('licUsed').textContent = used;
    document.getElementById('licFree').textContent = free;
    document.getElementById('licExpiring').textContent = expiring;
}

function openLicModal(i) {
    document.getElementById('licIdx').value = i;
    const l = i >= 0 ? licenses[i] : {};
    document.getElementById('licModalTitle').textContent = i >= 0 ? 'Edit License' : 'Add License';
    document.getElementById('licKey').value = l.licenseKey || '';
    document.getElementById('licProduct').value = l.product || 'Quick Heal Total Security';
    const sel = document.getElementById('licAssignTo');
    sel.innerHTML = '<option value="">-- Unassigned --</option>' + pcs.map(p => `<option value="${esc(p.hostname)}">${esc(p.hostname)}</option>`).join('');
    sel.value = l.hostname || '';
    document.getElementById('licIp').value = l.ip || '';
    document.getElementById('licLoggedUser').value = l.loggedUser || '';
    document.getElementById('licAssignedOn').value = l.assignedOn || '';
    document.getElementById('licPurchaseDate').value = l.purchaseDate || '';
    document.getElementById('licExpiryDate').value = l.expiryDate || '';
    document.getElementById('licNotes').value = l.notes || '';
    new bootstrap.Modal(document.getElementById('licModal')).show();
}

function onLicAssignChange() {
    const hostname = document.getElementById('licAssignTo').value;
    const pc = pcs.find(p => p.hostname === hostname);
    document.getElementById('licIp').value = pc ? (pc.ip || '') : '';
    document.getElementById('licLoggedUser').value = pc ? (pc.user || '') : '';
    if (hostname && !document.getElementById('licAssignedOn').value) {
        document.getElementById('licAssignedOn').value = new Date().toISOString().slice(0,10);
    }
}

function saveLic() {
    const i = parseInt(document.getElementById('licIdx').value);
    const key = document.getElementById('licKey').value.trim();
    if (!key) return alert('License Key is required!');
    const hostname = document.getElementById('licAssignTo').value;
    const rec = {
        licenseKey: key,
        product: document.getElementById('licProduct').value.trim(),
        hostname,
        ip: document.getElementById('licIp').value.trim(),
        loggedUser: document.getElementById('licLoggedUser').value.trim(),
        assignedOn: document.getElementById('licAssignedOn').value,
        purchaseDate: document.getElementById('licPurchaseDate').value,
        expiryDate: document.getElementById('licExpiryDate').value,
        notes: document.getElementById('licNotes').value.trim()
    };
    if (i >= 0) licenses[i] = rec; else licenses.push(rec);
    // reflect the license key onto the assigned PC record
    pcs.forEach(p => { if (p.licenseKey === key && p.hostname !== hostname) p.licenseKey = ''; });
    if (hostname) {
        const pc = pcs.find(p => p.hostname === hostname);
        if (pc) pc.licenseKey = key;
    }
    persistLic(() => persistPc(() => {
        renderLic(); renderPc();
        bootstrap.Modal.getInstance(document.getElementById('licModal')).hide();
    }));
}

function unassignLic(i) {
    if (!confirm('Unassign this license?')) return;
    const key = licenses[i].licenseKey;
    licenses[i].hostname = ''; licenses[i].ip = ''; licenses[i].loggedUser = ''; licenses[i].assignedOn = '';
    const pc = pcs.find(p => p.licenseKey === key);
    if (pc) pc.licenseKey = '';
    persistLic(() => persistPc(() => { renderLic(); renderPc(); }));
}

function deleteLic(i) {
    if (!confirm('Delete this license?')) return;
    const key = licenses[i].licenseKey;
    licenses.splice(i, 1);
    const pc = pcs.find(p => p.licenseKey === key);
    if (pc) pc.licenseKey = '';
    persistLic(() => persistPc(() => { renderLic(); renderPc(); }));
}

function persistLic(cb) {
    fetch('/Endpoints/SaveLicenses', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(licenses)
    }).then(() => cb && cb());
}

function autoMap() {
    const today = new Date(); today.setHours(0,0,0,0);
    const assignedHostnames = new Set(licenses.filter(l => l.hostname).map(l => l.hostname));
    const freeLicenses = licenses.filter(l => !l.hostname && !(l.expiryDate && new Date(l.expiryDate) < today));
    const needyPcs = pcs.filter(p => !p.licenseKey && p.qhService !== 'Running' && !assignedHostnames.has(p.hostname));
    let mapped = 0;
    for (let k = 0; k < Math.min(freeLicenses.length, needyPcs.length); k++) {
        const lic = freeLicenses[k], pc = needyPcs[k];
        lic.hostname = pc.hostname; lic.ip = pc.ip; lic.loggedUser = pc.user;
        lic.assignedOn = new Date().toISOString().slice(0,10);
        pc.licenseKey = lic.licenseKey;
        mapped++;
    }
    if (mapped === 0) { alert('No free licenses / needy PCs to auto-map.'); return; }
    persistLic(() => persistPc(() => { renderLic(); renderPc(); alert(mapped + ' license(s) auto-mapped.'); }));
}

// ───────────── IT Software Register (separate from Quick Heal License Manager above) ─────────────
function swregDaysToRenewal(l) {
    if (!l.renewalDate) return '';
    const rd = new Date(l.renewalDate);
    if (isNaN(rd)) return '';
    const today = new Date(); today.setHours(0,0,0,0);
    return Math.round((rd - today) / 86400000);
}

function swregRenewalFlag(l) {
    if (!l.renewalDate) return '';
    if ((l.status || '') !== 'Active') return 'Inactive';
    const days = swregDaysToRenewal(l);
    if (days === '') return '';
    if (days < 0) return 'Expired';
    if (days <= 30) return 'Due within 30 days';
    if (days <= 60) return 'Due in 31-60 days';
    if (days <= 90) return 'Due in 61-90 days';
    return 'Later';
}

function swregUtilization(l) {
    const p = parseFloat(l.purchasedLicenses) || 0;
    const a = parseFloat(l.assignedLicenses) || 0;
    if (!p) return '';
    return (Math.round((a / p) * 1000) / 10) + '%';
}

function nextSwRegRecordId() {
    let max = 0;
    softwareRegister.forEach(l => {
        const m = /^SW-(\d+)$/.exec(l.recordId || '');
        if (m) max = Math.max(max, parseInt(m[1]));
    });
    return 'SW-' + String(max + 1).padStart(3, '0');
}

function renderSwReg() {
    const body = document.getElementById('swregTableBody');
    let rows = '';
    let total = 0, active = 0, dueSoon = 0, expired = 0;
    softwareRegister.forEach((l, i) => {
        total++;
        if ((l.status || '') === 'Active') active++;
        const flag = swregRenewalFlag(l);
        if (flag === 'Due within 30 days') dueSoon++;
        if (flag === 'Expired') expired++;
        const days = swregDaysToRenewal(l);
        let flagBadge = '';
