@model List<Dictionary<string,object?>>
@{
    ViewData["Title"] = "Endpoint Monitor";
    var pcInv = (List<Dictionary<string,object?>>)ViewBag.PcInventory;
    var licenses = (List<Dictionary<string,object?>>)ViewBag.Licenses;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-hdd-network text-danger"></i> Endpoint &amp; Antivirus Management</h5>
</div>

<ul class="nav nav-tabs mb-3" id="epTabs">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-uptime" type="button">🌐 Uptime Monitor</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pc" type="button">💻 PC Inventory &amp; Antivirus</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-lic" type="button">🔑 License Manager</button></li>
</ul>

<div class="tab-content">

<!-- ══════════════ TAB 1: UPTIME MONITOR (existing feature, unchanged) ══════════════ -->
<div class="tab-pane fade show active" id="tab-uptime">

    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-success btn-sm px-3" onclick="checkAll()"><i class="bi bi-play-circle"></i> Check All</button>
        <button class="btn btn-primary btn-sm px-3" onclick="addEndpoint()"><i class="bi bi-plus-circle"></i> Add</button>
    </div>

    <div class="row g-2 mb-3" id="summary">
        <div class="col-4"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="totalCount">@Model.Count</div><div class="small text-muted">Total</div></div></div>
        <div class="col-4"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="upCount">-</div><div class="small text-muted">Online</div></div></div>
        <div class="col-4"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="downCount">-</div><div class="small text-muted">Offline</div></div></div>
    </div>

    <div class="text-muted small mb-3" id="lastCheck">Not checked yet. Click "Check All" to start.</div>

    <div class="row g-3" id="endpointsGrid">
    @{int idx = 0;}
    @foreach(var ep in Model)
    {
        var name = ep.GetValueOrDefault("name")?.ToString() ?? "";
        var url  = ep.GetValueOrDefault("url")?.ToString() ?? "";
        var cat  = ep.GetValueOrDefault("category")?.ToString() ?? "General";
        <div class="col-md-4" id="ep_@idx">
            <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #CBD5E1!important">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="fw-bold mb-0">@name</h6>
                            <span class="badge bg-secondary small">@cat</span>
                        </div>
                        <span class="badge bg-secondary" id="status_@idx">⏳ Pending</span>
                    </div>
                    <div class="small text-muted text-truncate mb-2"><a href="@url" target="_blank" class="text-muted">@url</a></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted" id="ms_@idx"></small>
                        <button class="btn btn-outline-primary btn-sm" onclick="checkOne(@idx, '@url')"><i class="bi bi-arrow-repeat"></i></button>
                    </div>
                </div>
            </div>
        </div>
        idx++;
    }
    </div>
</div>

<!-- ══════════════ TAB 2: PC INVENTORY & ANTIVIRUS ══════════════ -->
<div class="tab-pane fade" id="tab-pc">

    @if (!pcInv.Any())
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center">
            <div><i class="bi bi-info-circle"></i> PC Inventory is empty — this is a fresh, manually-maintained list (the old desktop tool needed a live agent on every PC; the web version doesn't). Get a head start below.</div>
            <form method="post" action="/Endpoints/ImportPcFromEmployees" class="ms-2">
                <button class="btn btn-dark btn-sm px-3" type="submit"><i class="bi bi-people"></i> Quick-Import Hostnames from Employees</button>
            </form>
        </div>
    }
    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-outline-dark btn-sm px-3" onclick="new bootstrap.Modal(document.getElementById('pcImportModal')).show()"><i class="bi bi-upload"></i> Import CSV</button>
        <a href="/Endpoints/ExportPcInventory" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Export CSV</a>
        <button class="btn btn-primary btn-sm px-3" onclick="openPcModal(-1)"><i class="bi bi-plus-circle"></i> Add PC</button>
    </div>

    <div class="row g-2 mb-3" id="pcSummary">
        <div class="col-3"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="pcTotal">0</div><div class="small text-muted">Total PCs</div></div></div>
        <div class="col-3"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="pcQhOk">0</div><div class="small text-muted">QH Installed</div></div></div>
        <div class="col-3"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="pcQhMissing">0</div><div class="small text-muted">QH Missing</div></div></div>
        <div class="col-3"><div class="card border-0 bg-warning-subtle text-center py-2"><div class="fw-bold fs-4 text-warning" id="pcQhStopped">0</div><div class="small text-muted">QH Stopped</div></div></div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <input type="text" id="pcSearch" class="form-control form-control-sm" placeholder="Search hostname, IP, user..." onkeyup="renderPc()"/>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead style="background:#0A192F;color:white">
                    <tr>
                        <th class="ps-3">Hostname</th>
                        <th>IP Address</th>
                        <th>OS</th>
                        <th>CPU</th>
                        <th>RAM (GB)</th>
                        <th>Disk Free</th>
                        <th>User</th>
                        <th>QH Version</th>
                        <th>QH Service</th>
                        <th>License Key</th>
                        <th>Last Seen</th>
                        <th>Software</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="pcTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════ TAB 3: LICENSE MANAGER (IT Software Register) ══════════════ -->
<div class="tab-pane fade" id="tab-lic">

    @if (!licenses.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No software/license records on file yet — add them one by one, or import your list as a CSV. Use <a href="/Endpoints/ExportLicenses">Export</a> first to see the exact column format.
        </div>
    }
    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-outline-dark btn-sm px-3" onclick="new bootstrap.Modal(document.getElementById('licImportModal')).show()"><i class="bi bi-upload"></i> Import CSV</button>
        <a href="/Endpoints/ExportLicenses" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Excel Report</a>
        <button class="btn btn-primary btn-sm px-3" onclick="openLicModal(-1)"><i class="bi bi-plus-circle"></i> Add Software / License</button>
    </div>

    <div class="row g-2 mb-3" id="licSummary">
        <div class="col-3"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="licTotal">0</div><div class="small text-muted">Total Records</div></div></div>
        <div class="col-3"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="licActive">0</div><div class="small text-muted">Active</div></div></div>
        <div class="col-3"><div class="card border-0 bg-warning-subtle text-center py-2"><div class="fw-bold fs-4 text-warning" id="licDueSoon">0</div><div class="small text-muted">Renewal ≤ 30 Days</div></div></div>
        <div class="col-3"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="licExpired">0</div><div class="small text-muted">Expired</div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" style="font-size:12px">
                <thead style="background:#1e3a5f;color:white">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Record ID</th>
                        <th>Software / Application</th>
                        <th>Category</th>
                        <th>Deployment</th>
                        <th>Purpose / Module</th>
                        <th>Vendor</th>
                        <th>Business Owner</th>
                        <th>IT Owner</th>
                        <th>Department</th>
                        <th>License Type</th>
                        <th>Purchased</th>
                        <th>Assigned</th>
                        <th>Utilization %</th>
                        <th>Version / Plan</th>
                        <th>Start Date</th>
                        <th>Renewal / Support Due</th>
                        <th>Annual Cost (INR)</th>
                        <th>Payment Frequency</th>
                        <th>Auto-Renew</th>
                        <th>Criticality</th>
                        <th>Data Sensitivity</th>
                        <th>SSO / MFA</th>
                        <th>Contract / PO No.</th>
                        <th>Invoice No.</th>
                        <th>Status</th>
                        <th>Days to Renewal</th>
                        <th>Renewal Flag</th>
                        <th>Risk / Issue</th>
                        <th>Action Required</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="licTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

</div>

<!-- ═══ Add/Edit Endpoint Modal (existing) ═══ -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#0A192F;color:white">
                <h5 class="modal-title">Add Endpoint</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label fw-bold small">Name</label><input type="text" id="newName" class="form-control" placeholder="My Server"/></div>
                <div class="mb-3"><label class="form-label fw-bold small">URL</label><input type="text" id="newUrl" class="form-control" placeholder="https://example.com"/></div>
                <div class="mb-3"><label class="form-label fw-bold small">Category</label>
                    <select id="newCat" class="form-select">
                        @foreach(var c in new[]{"Internal","External","Cloud","Server","API","Other"})
                        {<option>@c</option>}
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="saveEndpoint()">Add</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Import PC CSV Modal ═══ -->
<div class="modal fade" id="pcImportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Endpoints/ImportPcCsv" enctype="multipart/form-data">
                <div class="modal-header" style="background:#0A192F;color:white">
                    <h5 class="modal-title">Import PC Inventory (CSV)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Columns: Hostname, IP Address, OS, CPU, RAM GB, Disk Free, User, QH Version, QH Service, License Key, Last Seen, Notes. Matches existing rows by Hostname (updates them); new hostnames are added. Use <a href="/Endpoints/ExportPcInventory">Export CSV</a> to see the exact format.</p>
                    <input type="file" name="csvFile" accept=".csv" class="form-control" required/>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══ Import Licenses CSV Modal ═══ -->
<div class="modal fade" id="licImportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Endpoints/ImportLicensesCsv" enctype="multipart/form-data">
                <div class="modal-header" style="background:#1e3a5f;color:white">
                    <h5 class="modal-title">Import Licenses (CSV)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Columns: Record ID, Software / Application, Category, Deployment, Purpose / Module, Vendor, Business Owner, IT Owner, Department, License Type, Purchased Licenses, Assigned Licenses, Version / Plan, Start Date, Renewal / Support Due, Annual Support Cost (INR), Payment Frequency, Auto-Renew, Criticality, Data Sensitivity, SSO / MFA, Contract / PO No., Invoice No., Status, Risk / Issue, Action Required, Remarks. Matches existing rows by Record ID (updates them); blank/new Record IDs are added. Use <a href="/Endpoints/ExportLicenses">Export</a> to see the exact format.</p>
                    <input type="file" name="csvFile" accept=".csv" class="form-control" required/>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══ Add/Edit PC Modal ═══ -->
<div class="modal fade" id="pcModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#0A192F;color:white">
                <h5 class="modal-title" id="pcModalTitle">Add PC</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pcIdx" value="-1"/>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label fw-bold small">Hostname</label><input type="text" id="pcHostname" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">IP Address</label><input type="text" id="pcIp" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">OS</label><input type="text" id="pcOs" class="form-control" placeholder="Windows 11 Pro"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">CPU</label><input type="text" id="pcCpu" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">RAM (GB)</label><input type="text" id="pcRam" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">Disk Free</label><input type="text" id="pcDisk" class="form-control" placeholder="120 GB"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">Logged-in User</label><input type="text" id="pcUser" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">Last Seen</label><input type="text" id="pcLastSeen" class="form-control" placeholder="2026-09-05"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">Quick Heal Version</label><input type="text" id="pcQhVersion" class="form-control" placeholder="e.g. 24.00"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">Quick Heal Service</label>
                        <select id="pcQhService" class="form-select">
                            <option>Running</option>
                            <option>Stopped</option>
                            <option>Not Installed</option>
                        </select>
                    </div>
                    <div class="col-md-6"><label class="form-label fw-bold small">License Key</label><input type="text" id="pcLicenseKey" class="form-control" readonly placeholder="Assign from License Manager tab"/></div>
                    <div class="col-12"><label class="form-label fw-bold small">Notes</label><textarea id="pcNotes" class="form-control" rows="2"></textarea></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="savePc()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Installed Software Modal (populated by AMPM_PC_Agent) ═══ -->
<div class="modal fade" id="softwareModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#0A192F;color:white">
                <h5 class="modal-title" id="swModalTitle">Installed Software</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="swSearch" class="form-control form-control-sm mb-2" placeholder="Search software..." onkeyup="filterSwList()"/>
                <table class="table table-sm table-hover mb-0">
                    <thead><tr><th>Name</th><th>Version</th></tr></thead>
                    <tbody id="swListBody"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Add/Edit Software / License Modal (IT Software Register) ═══ -->
<div class="modal fade" id="licModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header" style="background:#1e3a5f;color:white">
                <h5 class="modal-title" id="licModalTitle">Add Software / License</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="licIdx" value="-1"/>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label fw-bold small">Record ID</label><input type="text" id="licRecordId" class="form-control" placeholder="auto if blank"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Software / Application</label><input type="text" id="licSoftware" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Category</label>
                        <select id="licCategory" class="form-select">
                            @foreach(var c in new[]{"ERP","Finance & Accounting","HRMS","POS","Design","Security","Productivity","Cloud / Hosting","Other"})
                            {<option>@c</option>}
                        </select>
                    </div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Deployment</label>
                        <select id="licDeployment" class="form-select">
                            @foreach(var c in new[]{"Cloud","Desktop","On-premise","Hybrid"})
                            {<option>@c</option>}
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Purpose / Module</label><input type="text" id="licPurpose" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Vendor</label><input type="text" id="licVendor" class="form-control"/></div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Business Owner</label><input type="text" id="licBusinessOwner" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">IT Owner</label><input type="text" id="licItOwner" class="form-control" value="Sandeep Kumar Singh Kushwaha"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Department</label>
                        <select id="licDepartment" class="form-select">
                            @foreach(var c in new[]{"Accounts & Finance","Retail","E-commerce","Production","Warehouse","HR","Marketing","Management","IT"})
                            {<option>@c</option>}
                        </select>
                    </div>

                    <div class="col-md-4"><label class="form-label fw-bold small">License Type</label>
                        <select id="licLicenseType" class="form-select">
                            @foreach(var c in new[]{"Named User","Concurrent","Site License","Perpetual","Device","Enterprise","Other"})
                            {<option>@c</option>}
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Purchased Licenses</label><input type="number" id="licPurchased" class="form-control" min="0"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Assigned Licenses</label><input type="number" id="licAssigned" class="form-control" min="0"/></div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Version / Plan</label><input type="text" id="licVersionPlan" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Start Date</label><input type="date" id="licStartDate" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Renewal / Support Due</label><input type="date" id="licRenewalDate" class="form-control"/></div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Annual Support Cost (INR)</label><input type="number" id="licAnnualCost" class="form-control" min="0"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Payment Frequency</label>
                        <select id="licPaymentFrequency" class="form-select">
                            @foreach(var c in new[]{"Monthly","Quarterly","Half-Yearly","Annual","One-time"})
                            {<option>@c</option>}
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Auto-Renew</label>
                        <select id="licAutoRenew" class="form-select"><option>Yes</option><option>No</option></select>
                    </div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Criticality</label>
                        <select id="licCriticality" class="form-select">
                            @foreach(var c in new[]{"Critical","High","Medium","Low"})
                            {<option>@c</option>}
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Data Sensitivity</label>
                        <select id="licDataSensitivity" class="form-select">
                            @foreach(var c in new[]{"Public","Internal","Confidential","Restricted"})
                            {<option>@c</option>}
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label fw-bold small">SSO / MFA</label>
                        <select id="licSsoMfa" class="form-select"><option>Yes</option><option>No</option></select>
                    </div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Contract / PO No.</label><input type="text" id="licContractPo" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Invoice No.</label><input type="text" id="licInvoiceNo" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Status</label>
                        <select id="licStatus" class="form-select">
                            @foreach(var c in new[]{"Active","Inactive","Under Review","Planned","Expired"})
                            {<option>@c</option>}
                        </select>
                    </div>

                    <div class="col-12"><label class="form-label fw-bold small">Risk / Issue</label><input type="text" id="licRiskIssue" class="form-control"/></div>
                    <div class="col-12"><label class="form-label fw-bold small">Action Required</label><input type="text" id="licActionRequired" class="form-control"/></div>
                    <div class="col-12"><label class="form-label fw-bold small">Remarks</label><textarea id="licRemarks" class="form-control" rows="2"></textarea></div>
                    <div class="col-12 text-muted small"><i class="bi bi-info-circle"></i> Utilization %, Days to Renewal and Renewal Flag are calculated automatically — no need to enter them.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="saveLic()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const endpoints = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
let pcs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(pcInv));
let licenses = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(licenses));

// ───────────── Uptime Monitor (existing) ─────────────
async function checkOne(idx, url) {
    const card = document.getElementById('ep_' + idx);
    const badge = document.getElementById('status_' + idx);
    const msEl = document.getElementById('ms_' + idx);
    badge.className = 'badge bg-warning';
    badge.textContent = '⏳ Checking...';
    card.style.borderLeftColor = '#F59E0B';
    try {
        const res = await fetch('/api/endpoints/check?url=' + encodeURIComponent(url));
        const d = await res.json();
        if (d.ok && d.status < 400) {
            badge.className = 'badge bg-success';
            badge.textContent = '✅ Online (' + d.status + ')';
            card.style.borderLeftColor = '#10B981';
            msEl.textContent = d.ms + 'ms';
        } else {
            badge.className = 'badge bg-danger';
            badge.textContent = '❌ ' + (d.status || 'Error');
            card.style.borderLeftColor = '#EF4444';
            msEl.textContent = d.error ? d.error.substring(0,30) : '';
        }
    } catch(e) {
        badge.className = 'badge bg-danger';
        badge.textContent = '❌ Failed';
        card.style.borderLeftColor = '#EF4444';
    }
    updateSummary();
}

async function checkAll() {
    document.getElementById('lastCheck').textContent = 'Checking... please wait';
    const promises = endpoints.map((ep, i) => checkOne(i, ep.url));
    await Promise.all(promises);
    document.getElementById('lastCheck').textContent = 'Last checked: ' + new Date().toLocaleTimeString();
}

function updateSummary() {
    let up = 0, down = 0;
    document.querySelectorAll('[id^="status_"]').forEach(el => {
        if (el.textContent.includes('✅')) up++;
        else if (el.textContent.includes('❌')) down++;
    });
    document.getElementById('upCount').textContent = up;
    document.getElementById('downCount').textContent = down;
}

function addEndpoint() {
    new bootstrap.Modal(document.getElementById('addModal')).show();
}

function saveEndpoint() {
    const name = document.getElementById('newName').value.trim();
    const url  = document.getElementById('newUrl').value.trim();
    const cat  = document.getElementById('newCat').value;
    if (!name || !url) return alert('Name and URL required!');
    endpoints.push({ name, url, category: cat, enabled: true });
    fetch('/Endpoints/Save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(endpoints)
    }).then(() => location.reload());
}

window.addEventListener('DOMContentLoaded', () => { setTimeout(checkAll, 500); renderPc(); renderLic(); });

// ───────────── PC Inventory & Antivirus ─────────────
function esc(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function renderPc() {
    const q = (document.getElementById('pcSearch')?.value || '').toLowerCase();
    const body = document.getElementById('pcTableBody');
    let rows = '';
    let total = 0, qhOk = 0, qhMissing = 0, qhStopped = 0;
    pcs.forEach((p, i) => {
        total++;
        const svc = (p.qhService || '').toString();
        if (svc === 'Running') qhOk++;
        else if (svc === 'Stopped') qhStopped++;
        else qhMissing++;
        const hay = [p.hostname, p.ip, p.user, p.notes].join(' ').toLowerCase();
        if (q && !hay.includes(q)) return;
        let svcBadge = svc === 'Running' ? '<span class="badge bg-success">Running</span>'
                     : svc === 'Stopped' ? '<span class="badge bg-warning">Stopped</span>'
                     : '<span class="badge bg-danger">Not Installed</span>';
        rows += `<tr>
            <td class="ps-3 fw-bold font-monospace">${esc(p.hostname)}</td>
            <td class="font-monospace small">${esc(p.ip)}</td>
            <td class="small">${esc(p.os)}</td>
            <td class="small">${esc(p.cpu)}</td>
            <td class="small">${esc(p.ramGb)}</td>
            <td class="small">${esc(p.diskFree)}</td>
            <td class="small">${esc(p.user)}</td>
            <td class="small">${esc(p.qhVersion)}</td>
            <td>${svcBadge}</td>
            <td class="small font-monospace">${esc(p.licenseKey)}</td>
            <td class="small text-muted">${esc(p.lastSeen)}</td>
            <td>${Array.isArray(p.software) && p.software.length
                ? `<button class="btn btn-outline-info btn-sm" onclick="viewSoftware(${i})"><i class="bi bi-box-seam"></i> ${p.software.length}</button>`
                : '<span class="text-muted small">—</span>'}</td>
            <td>
                <button class="btn btn-outline-warning btn-sm" onclick="openPcModal(${i})" title="Edit"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-outline-danger btn-sm" onclick="deletePc(${i})" title="Delete"><i class="bi bi-trash"></i></button>
            </td>
        </tr>`;
    });
    body.innerHTML = rows || '<tr><td colspan="13" class="text-center text-muted py-4">No PCs added yet</td></tr>';
    document.getElementById('pcTotal').textContent = total;
    document.getElementById('pcQhOk').textContent = qhOk;
    document.getElementById('pcQhMissing').textContent = qhMissing;
    document.getElementById('pcQhStopped').textContent = qhStopped;
}

function openPcModal(i) {
    document.getElementById('pcIdx').value = i;
    const p = i >= 0 ? pcs[i] : {};
    document.getElementById('pcModalTitle').textContent = i >= 0 ? 'Edit PC' : 'Add PC';
    document.getElementById('pcHostname').value = p.hostname || '';
    document.getElementById('pcIp').value = p.ip || '';
    document.getElementById('pcOs').value = p.os || '';
    document.getElementById('pcCpu').value = p.cpu || '';
    document.getElementById('pcRam').value = p.ramGb || '';
    document.getElementById('pcDisk').value = p.diskFree || '';
    document.getElementById('pcUser').value = p.user || '';
    document.getElementById('pcLastSeen').value = p.lastSeen || '';
    document.getElementById('pcQhVersion').value = p.qhVersion || '';
    document.getElementById('pcQhService').value = p.qhService || 'Not Installed';
    document.getElementById('pcLicenseKey').value = p.licenseKey || '';
    document.getElementById('pcNotes').value = p.notes || '';
    new bootstrap.Modal(document.getElementById('pcModal')).show();
}

function savePc() {
    const i = parseInt(document.getElementById('pcIdx').value);
    const hostname = document.getElementById('pcHostname').value.trim();
    if (!hostname) return alert('Hostname is required!');
    // Start from the existing record (if editing) so agent-reported fields like
    // "software" — which this form doesn't show — survive a manual save.
    const rec = Object.assign({}, (i >= 0 ? pcs[i] : {}), {
        hostname,
        ip: document.getElementById('pcIp').value.trim(),
        os: document.getElementById('pcOs').value.trim(),
        cpu: document.getElementById('pcCpu').value.trim(),
        ramGb: document.getElementById('pcRam').value.trim(),
        diskFree: document.getElementById('pcDisk').value.trim(),
        user: document.getElementById('pcUser').value.trim(),
        lastSeen: document.getElementById('pcLastSeen').value.trim(),
        qhVersion: document.getElementById('pcQhVersion').value.trim(),
        qhService: document.getElementById('pcQhService').value,
        licenseKey: document.getElementById('pcLicenseKey').value.trim(),
        notes: document.getElementById('pcNotes').value.trim()
    });
    if (i >= 0) pcs[i] = rec; else pcs.push(rec);
    persistPc(() => { renderPc(); bootstrap.Modal.getInstance(document.getElementById('pcModal')).hide(); });
}

function viewSoftware(i) {
    const p = pcs[i];
    const list = Array.isArray(p.software) ? p.software.slice().sort((a,b) => (a.name||'').localeCompare(b.name||'')) : [];
    document.getElementById('swModalTitle').textContent = `Installed Software — ${p.hostname} (${list.length})`;
    document.getElementById('swSearch').value = '';
    window._swList = list;
    renderSwList(list);
    new bootstrap.Modal(document.getElementById('softwareModal')).show();
}

function renderSwList(list) {
    const body = document.getElementById('swListBody');
    body.innerHTML = list.length
        ? list.map(s => `<tr><td>${esc(s.name)}</td><td class="text-muted small">${esc(s.version)}</td></tr>`).join('')
        : '<tr><td colspan="2" class="text-center text-muted py-3">No software reported</td></tr>';
}

function filterSwList() {
    const q = document.getElementById('swSearch').value.toLowerCase();
    const list = (window._swList || []).filter(s => (s.name||'').toLowerCase().includes(q));
    renderSwList(list);
}

function deletePc(i) {
    if (!confirm('Delete this PC record?')) return;
    const key = pcs[i].licenseKey;
    pcs.splice(i, 1);
    if (key) {
        const lic = licenses.find(l => l.licenseKey === key);
        if (lic) { lic.hostname = ''; lic.ip = ''; lic.loggedUser = ''; lic.assignedOn = ''; }
        persistLic(() => {});
    }
    persistPc(renderPc);
}

function persistPc(cb) {
    fetch('/Endpoints/SavePcInventory', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(pcs)
    }).then(() => cb && cb());
}

// ───────────── License Manager (IT Software Register) ─────────────
function licDaysToRenewal(l) {
    if (!l.renewalDate) return '';
    const rd = new Date(l.renewalDate);
    if (isNaN(rd)) return '';
    const today = new Date(); today.setHours(0,0,0,0);
    return Math.round((rd - today) / 86400000);
}

function licRenewalFlag(l) {
    if (!l.renewalDate) return '';
    if ((l.status || '') !== 'Active') return 'Inactive';
    const days = licDaysToRenewal(l);
    if (days === '') return '';
    if (days < 0) return 'Expired';
    if (days <= 30) return 'Due within 30 days';
    if (days <= 60) return 'Due in 31-60 days';
    if (days <= 90) return 'Due in 61-90 days';
    return 'Later';
}

function licUtilization(l) {
    const p = parseFloat(l.purchasedLicenses) || 0;
    const a = parseFloat(l.assignedLicenses) || 0;
    if (!p) return '';
    return (Math.round((a / p) * 1000) / 10) + '%';
}

function nextRecordId() {
    let max = 0;
    licenses.forEach(l => {
        const m = /^SW-(\d+)$/.exec(l.recordId || '');
        if (m) max = Math.max(max, parseInt(m[1]));
    });
    return 'SW-' + String(max + 1).padStart(3, '0');
}

function renderLic() {
    const body = document.getElementById('licTableBody');
    let rows = '';
    let total = 0, active = 0, dueSoon = 0, expired = 0;
    licenses.forEach((l, i) => {
        total++;
        if ((l.status || '') === 'Active') active++;
        const flag = licRenewalFlag(l);
        if (flag === 'Due within 30 days') dueSoon++;
        if (flag === 'Expired') expired++;
        const days = licDaysToRenewal(l);
        let flagBadge = '';
        if (flag === 'Expired') flagBadge = `<span class="badge bg-danger">${flag}</span>`;
        else if (flag === 'Due within 30 days') flagBadge = `<span class="badge bg-warning text-dark">${flag}</span>`;
        else if (flag === 'Due in 31-60 days' || flag === 'Due in 61-90 days') flagBadge = `<span class="badge bg-info text-dark">${flag}</span>`;
        else if (flag === 'Inactive') flagBadge = `<span class="badge bg-secondary">${flag}</span>`;
        else if (flag) flagBadge = `<span class="badge bg-light text-dark border">${flag}</span>`;
        let statusBadge = l.status === 'Active' ? `<span class="badge bg-success">${esc(l.status)}</span>`
                         : l.status === 'Expired' ? `<span class="badge bg-danger">${esc(l.status)}</span>`
                         : `<span class="badge bg-secondary">${esc(l.status || '')}</span>`;
        rows += `<tr>
            <td class="ps-3">${i+1}</td>
            <td class="small fw-bold">${esc(l.recordId)}</td>
            <td class="small fw-bold">${esc(l.software)}</td>
            <td class="small">${esc(l.category)}</td>
            <td class="small">${esc(l.deployment)}</td>
            <td class="small">${esc(l.purpose)}</td>
            <td class="small">${esc(l.vendor)}</td>
            <td class="small">${esc(l.businessOwner)}</td>
            <td class="small">${esc(l.itOwner)}</td>
            <td class="small">${esc(l.department)}</td>
            <td class="small">${esc(l.licenseType)}</td>
            <td class="small text-center">${esc(l.purchasedLicenses)}</td>
            <td class="small text-center">${esc(l.assignedLicenses)}</td>
            <td class="small text-center text-muted">${licUtilization(l)}</td>
            <td class="small">${esc(l.versionPlan)}</td>
            <td class="small text-muted">${esc(l.startDate)}</td>
            <td class="small text-muted">${esc(l.renewalDate)}</td>
            <td class="small text-end">${l.annualCost ? Number(l.annualCost).toLocaleString('en-IN') : ''}</td>
            <td class="small">${esc(l.paymentFrequency)}</td>
            <td class="small">${esc(l.autoRenew)}</td>
            <td class="small">${esc(l.criticality)}</td>
            <td class="small">${esc(l.dataSensitivity)}</td>
            <td class="small">${esc(l.ssoMfa)}</td>
            <td class="small">${esc(l.contractPo)}</td>
            <td class="small">${esc(l.invoiceNo)}</td>
            <td>${statusBadge}</td>
            <td class="small text-center text-muted">${days}</td>
            <td>${flagBadge}</td>
            <td class="small text-danger">${esc(l.riskIssue)}</td>
            <td class="small">${esc(l.actionRequired)}</td>
            <td class="small text-muted">${esc(l.remarks)}</td>
            <td>
                <button class="btn btn-outline-warning btn-sm" onclick="openLicModal(${i})" title="Edit"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-outline-danger btn-sm" onclick="deleteLic(${i})" title="Delete"><i class="bi bi-trash"></i></button>
            </td>
        </tr>`;
    });
    body.innerHTML = rows || '<tr><td colspan="32" class="text-center text-muted py-4">No software/license records added yet</td></tr>';
    document.getElementById('licTotal').textContent = total;
    document.getElementById('licActive').textContent = active;
    document.getElementById('licDueSoon').textContent = dueSoon;
    document.getElementById('licExpired').textContent = expired;
}

function openLicModal(i) {
    document.getElementById('licIdx').value = i;
    const l = i >= 0 ? licenses[i] : {};
    document.getElementById('licModalTitle').textContent = i >= 0 ? 'Edit Software / License' : 'Add Software / License';
    document.getElementById('licRecordId').value = l.recordId || '';
    document.getElementById('licSoftware').value = l.software || '';
    document.getElementById('licCategory').value = l.category || 'ERP';
    document.getElementById('licDeployment').value = l.deployment || 'Cloud';
    document.getElementById('licPurpose').value = l.purpose || '';
    document.getElementById('licVendor').value = l.vendor || '';
    document.getElementById('licBusinessOwner').value = l.businessOwner || '';
    document.getElementById('licItOwner').value = l.itOwner || 'Sandeep Kumar Singh Kushwaha';
    document.getElementById('licDepartment').value = l.department || 'IT';
    document.getElementById('licLicenseType').value = l.licenseType || 'Named User';
    document.getElementById('licPurchased').value = l.purchasedLicenses || '';
    document.getElementById('licAssigned').value = l.assignedLicenses || '';
    document.getElementById('licVersionPlan').value = l.versionPlan || '';
    document.getElementById('licStartDate').value = l.startDate || '';
    document.getElementById('licRenewalDate').value = l.renewalDate || '';
    document.getElementById('licAnnualCost').value = l.annualCost || '';
    document.getElementById('licPaymentFrequency').value = l.paymentFrequency || 'Annual';
    document.getElementById('licAutoRenew').value = l.autoRenew || 'No';
    document.getElementById('licCriticality').value = l.criticality || 'Medium';
    document.getElementById('licDataSensitivity').value = l.dataSensitivity || 'Internal';
    document.getElementById('licSsoMfa').value = l.ssoMfa || 'No';
    document.getElementById('licContractPo').value = l.contractPo || '';
    document.getElementById('licInvoiceNo').value = l.invoiceNo || '';
    document.getElementById('licStatus').value = l.status || 'Active';
    document.getElementById('licRiskIssue').value = l.riskIssue || '';
    document.getElementById('licActionRequired').value = l.actionRequired || '';
    document.getElementById('licRemarks').value = l.remarks || '';
    new bootstrap.Modal(document.getElementById('licModal')).show();
}

function saveLic() {
    const i = parseInt(document.getElementById('licIdx').value);
    let recordId = document.getElementById('licRecordId').value.trim();
    const software = document.getElementById('licSoftware').value.trim();
    if (!software) return alert('Software / Application name is required!');
    if (!recordId) recordId = nextRecordId();
    const rec = {
        recordId,
        software,
        category: document.getElementById('licCategory').value,
        deployment: document.getElementById('licDeployment').value,
        purpose: document.getElementById('licPurpose').value.trim(),
        vendor: document.getElementById('licVendor').value.trim(),
        businessOwner: document.getElementById('licBusinessOwner').value.trim(),
        itOwner: document.getElementById('licItOwner').value.trim(),
        department: document.getElementById('licDepartment').value,
        licenseType: document.getElementById('licLicenseType').value,
        purchasedLicenses: document.getElementById('licPurchased').value,
        assignedLicenses: document.getElementById('licAssigned').value,
        versionPlan: document.getElementById('licVersionPlan').value.trim(),
        startDate: document.getElementById('licStartDate').value,
        renewalDate: document.getElementById('licRenewalDate').value,
        annualCost: document.getElementById('licAnnualCost').value,
        paymentFrequency: document.getElementById('licPaymentFrequency').value,
        autoRenew: document.getElementById('licAutoRenew').value,
        criticality: document.getElementById('licCriticality').value,
        dataSensitivity: document.getElementById('licDataSensitivity').value,
        ssoMfa: document.getElementById('licSsoMfa').value,
        contractPo: document.getElementById('licContractPo').value.trim(),
        invoiceNo: document.getElementById('licInvoiceNo').value.trim(),
        status: document.getElementById('licStatus').value,
        riskIssue: document.getElementById('licRiskIssue').value.trim(),
        actionRequired: document.getElementById('licActionRequired').value.trim(),
        remarks: document.getElementById('licRemarks').value.trim(),
    };
    if (i >= 0) licenses[i] = rec; else licenses.push(rec);
    persistLic(() => {
        renderLic();
        bootstrap.Modal.getInstance(document.getElementById('licModal')).hide();
    });
}

function deleteLic(i) {
    if (!confirm('Delete this record?')) return;
    licenses.splice(i, 1);
    persistLic(renderLic);
}

function persistLic(cb) {
    fetch('/Endpoints/SaveLicenses', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(licenses)
    }).then(() => cb && cb());
}
</script>
}
