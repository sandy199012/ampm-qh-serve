// ───────────── IT Spend Log (separate from the tabs above — an append-style transaction log) ─────────────
function spendLogReportingMonth(l) {
    if (!l.expenseDate) return '';
    const d = new Date(l.expenseDate);
    if (isNaN(d)) return '';
    return d.toLocaleString('en-IN', { month: 'short', year: 'numeric' });
}

function spendLogGrossAmount(l) {
    const base = parseFloat(l.baseAmount) || 0;
    const gst = parseFloat(l.gst) || 0;
    return base + gst;
}

function spendLogNetPaid(l) {
    const gross = spendLogGrossAmount(l);
    const tds = parseFloat(l.tds) || 0;
    return gross - tds;
}

function spendLogVarianceToBudget(l) {
    if (l.budgetAmount === undefined || l.budgetAmount === '' || l.budgetAmount === null) return '';
    const base = parseFloat(l.baseAmount) || 0;
    const budget = parseFloat(l.budgetAmount) || 0;
    return base - budget;
}

function nextExpenseId() {
    let max = 0;
    itSpendLog.forEach(l => {
        const m = /^EXP-(\d+)$/.exec(l.expenseId || '');
        if (m) max = Math.max(max, parseInt(m[1]));
    });
    return 'EXP-' + String(max + 1).padStart(4, '0');
}

function renderSpendLog() {
    const body = document.getElementById('spendLogTableBody');
    let rows = '';
    let total = 0, baseTotal = 0, pending = 0, overBudget = 0;
    itSpendLog.forEach((l, i) => {
        total++;
        baseTotal += parseFloat(l.baseAmount) || 0;
        if (l.paymentStatus === 'Pending' || l.paymentStatus === 'Overdue') pending++;
        const variance = spendLogVarianceToBudget(l);
        if (variance !== '' && variance > 0) overBudget++;
        let statusBadge = l.paymentStatus === 'Paid' ? `<span class="badge bg-success">${esc(l.paymentStatus)}</span>`
                         : l.paymentStatus === 'Overdue' ? `<span class="badge bg-danger">${esc(l.paymentStatus)}</span>`
                         : l.paymentStatus === 'Partially Paid' ? `<span class="badge bg-info text-dark">${esc(l.paymentStatus)}</span>`
                         : `<span class="badge bg-warning text-dark">${esc(l.paymentStatus || '')}</span>`;
        const gross = spendLogGrossAmount(l);
        const net = spendLogNetPaid(l);
        rows += `<tr>
            <td class="ps-3">${i+1}</td>
            <td class="small text-muted">${esc(l.expenseDate)}</td>
            <td class="small text-muted">${spendLogReportingMonth(l)}</td>
            <td class="small fw-bold">${esc(l.expenseId)}</td>
