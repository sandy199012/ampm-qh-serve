@model List<Dictionary<string,object?>>
@{
    ViewData["Title"] = "Endpoint Monitor";
    var pcInv = (List<Dictionary<string,object?>>)ViewBag.PcInventory;
    var licenses = (List<Dictionary<string,object?>>)ViewBag.Licenses;
    var softwareRegister = (List<Dictionary<string,object?>>)ViewBag.SoftwareRegister;
    var onlineSubs = (List<Dictionary<string,object?>>)ViewBag.OnlineSubscriptions;
    var itSpendLog = (List<Dictionary<string,object?>>)ViewBag.ITSpendLog;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-hdd-network text-danger"></i> Endpoint &amp; Antivirus Management</h5>
</div>

<ul class="nav nav-tabs mb-3" id="epTabs">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-uptime" type="button">🌐 Uptime Monitor</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pc" type="button">💻 PC Inventory &amp; Antivirus</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-lic" type="button">🔑 License Manager</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-swreg" type="button">🗂️ IT Software Register</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-onlinesub" type="button">💳 Online Subscriptions</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-spendlog" type="button">💰 IT Spend Log</button></li>
</ul>

<div class="tab-content">

<!-- ══════════════ TAB 1: UPTIME MONITOR (existing feature, unchanged) ══════════════ -->
<div class="tab-pane fade show active" id="tab-uptime">

    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-success btn-sm px-3" onclick="checkAll()"><i class="bi bi-play-circle"></i> Check All</button>
        <button class="btn btn-primary btn-sm px-3" onclick="addEndpoint()"><i class="bi bi-plus-circle"></i> Add</button>
    </div>

    <div class="row g-2 mb-3" id="summary">
        <div class="col-4"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="totalCount">@Model.Count</div><div class="small text-muted">Total</div></div></div>
        <div class="col-4"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="upCount">-</div><div class="small text-muted">Online</div></div></div>
        <div class="col-4"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="downCount">-</div><div class="small text-muted">Offline</div></div></div>
    </div>

    <div class="text-muted small mb-3" id="lastCheck">Not checked yet. Click "Check All" to start.</div>

    <div class="row g-3" id="endpointsGrid">
    @{int idx = 0;}
    @foreach(var ep in Model)
    {
        var name = ep.GetValueOrDefault("name")?.ToString() ?? "";
        var url  = ep.GetValueOrDefault("url")?.ToString() ?? "";
        var cat  = ep.GetValueOrDefault("category")?.ToString() ?? "General";
        <div class="col-md-4" id="ep_@idx">
            <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #CBD5E1!important">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="fw-bold mb-0">@name</h6>
                            <span class="badge bg-secondary small">@cat</span>
                        </div>
                        <span class="badge bg-secondary" id="status_@idx">⏳ Pending</span>
                    </div>
                    <div class="small text-muted text-truncate mb-2"><a href="@url" target="_blank" class="text-muted">@url</a></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted" id="ms_@idx"></small>
                        <button class="btn btn-outline-primary btn-sm" onclick="checkOne(@idx, '@url')"><i class="bi bi-arrow-repeat"></i></button>
                    </div>
                </div>
            </div>
        </div>
        idx++;
    }
    </div>
</div>

<!-- ══════════════ TAB 2: PC INVENTORY & ANTIVIRUS ══════════════ -->
<div class="tab-pane fade" id="tab-pc">

    @if (!pcInv.Any())
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center">
            <div><i class="bi bi-info-circle"></i> PC Inventory is empty — this is a fresh, manually-maintained list (the old desktop tool needed a live agent on every PC; the web version doesn't). Get a head start below.</div>
            <form method="post" action="/Endpoints/ImportPcFromEmployees" class="ms-2">
                <button class="btn btn-dark btn-sm px-3" type="submit"><i class="bi bi-people"></i> Quick-Import Hostnames from Employees</button>
            </form>
        </div>
    }
    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-outline-dark btn-sm px-3" onclick="new bootstrap.Modal(document.getElementById('pcImportModal')).show()"><i class="bi bi-upload"></i> Import CSV</button>
        <a href="/Endpoints/ExportPcInventory" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Export CSV</a>
        <button class="btn btn-primary btn-sm px-3" onclick="openPcModal(-1)"><i class="bi bi-plus-circle"></i> Add PC</button>
    </div>

    <div class="row g-2 mb-3" id="pcSummary">
        <div class="col-3"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="pcTotal">0</div><div class="small text-muted">Total PCs</div></div></div>
        <div class="col-3"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="pcQhOk">0</div><div class="small text-muted">QH Installed</div></div></div>
        <div class="col-3"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="pcQhMissing">0</div><div class="small text-muted">QH Missing</div></div></div>
        <div class="col-3"><div class="card border-0 bg-warning-subtle text-center py-2"><div class="fw-bold fs-4 text-warning" id="pcQhStopped">0</div><div class="small text-muted">QH Stopped</div></div></div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <input type="text" id="pcSearch" class="form-control form-control-sm" placeholder="Search hostname, IP, user..." onkeyup="renderPc()"/>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead style="background:#0A192F;color:white">
                    <tr>
                        <th class="ps-3">Hostname</th>
                        <th>IP Address</th>
                        <th>OS</th>
                        <th>CPU</th>
                        <th>RAM (GB)</th>
                        <th>Disk Free</th>
                        <th>User</th>
                        <th>QH Version</th>
                        <th>QH Service</th>
                        <th>License Key</th>
                        <th>Last Seen</th>
                        <th>Software</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="pcTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════ TAB 3: LICENSE MANAGER ══════════════ -->
<div class="tab-pane fade" id="tab-lic">

    @if (!licenses.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No Quick Heal licenses on file yet — add them one by one, or import your existing license list as a CSV (columns: License Key, Product, Assigned To, IP Address, Logged User, Assigned On, Purchase Date, Expiry Date, Notes).
        </div>
    }
    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <form method="post" action="/Endpoints/RepairData" onsubmit="return confirm('This clears any corrupted fields (showing as [object Object]) back to blank — the original text in those fields cannot be recovered. Continue?')" class="d-inline">
            <button class="btn btn-outline-danger btn-sm px-3" type="submit" title="Fix fields showing [object Object]"><i class="bi bi-tools"></i> Repair Data</button>
        </form>
        <button class="btn btn-outline-dark btn-sm px-3" onclick="new bootstrap.Modal(document.getElementById('licImportModal')).show()"><i class="bi bi-upload"></i> Import CSV</button>
        <a href="/Endpoints/ExportLicenses" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Export CSV</a>
        <button class="btn btn-outline-dark btn-sm px-3" onclick="autoMap()"><i class="bi bi-magic"></i> Auto-Map</button>
        <button class="btn btn-primary btn-sm px-3" onclick="openLicModal(-1)"><i class="bi bi-plus-circle"></i> Add License</button>
    </div>

    <div class="row g-2 mb-3" id="licSummary">
        <div class="col-3"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="licTotal">0</div><div class="small text-muted">Total Licenses</div></div></div>
        <div class="col-3"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="licUsed">0</div><div class="small text-muted">Used</div></div></div>
        <div class="col-3"><div class="card border-0 bg-info-subtle text-center py-2"><div class="fw-bold fs-4 text-info" id="licFree">0</div><div class="small text-muted">Free</div></div></div>
        <div class="col-3"><div class="card border-0 bg-warning-subtle text-center py-2"><div class="fw-bold fs-4 text-warning" id="licExpiring">0</div><div class="small text-muted">Expiring Soon</div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead style="background:#1e3a5f;color:white">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Status</th>
                        <th>License Key</th>
                        <th>Product</th>
                        <th>Assigned To</th>
                        <th>IP Address</th>
                        <th>Logged User</th>
                        <th>Assigned On</th>
                        <th>Purchase</th>
                        <th>Expiry</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="licTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════ TAB 4: IT SOFTWARE REGISTER (new, separate from Quick Heal License Manager) ══════════════ -->
<div class="tab-pane fade" id="tab-swreg">

    @if (!softwareRegister.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No software/license records on file yet — add them one by one, or import your list as a CSV. Use <a href="/Endpoints/ExportITReport">Excel Report</a> first to see the exact column format.
        </div>
    }
    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-outline-dark btn-sm px-3" onclick="new bootstrap.Modal(document.getElementById('swregImportModal')).show()"><i class="bi bi-upload"></i> Import CSV</button>
        <a href="/Endpoints/ExportITReport" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Excel Report</a>
        <button class="btn btn-primary btn-sm px-3" onclick="openSwRegModal(-1)"><i class="bi bi-plus-circle"></i> Add Software / License</button>
    </div>

    <div class="row g-2 mb-3" id="swregSummary">
        <div class="col-3"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="swregTotal">0</div><div class="small text-muted">Total Records</div></div></div>
        <div class="col-3"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="swregActive">0</div><div class="small text-muted">Active</div></div></div>
        <div class="col-3"><div class="card border-0 bg-warning-subtle text-center py-2"><div class="fw-bold fs-4 text-warning" id="swregDueSoon">0</div><div class="small text-muted">Renewal ≤ 30 Days</div></div></div>
        <div class="col-3"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="swregExpired">0</div><div class="small text-muted">Expired</div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" style="font-size:12px">
                <thead style="background:#1e3a5f;color:white">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Record ID</th>
                        <th>Software / Application</th>
                        <th>Category</th>
                        <th>Deployment</th>
                        <th>Purpose / Module</th>
                        <th>Vendor</th>
                        <th>Business Owner</th>
                        <th>IT Owner</th>
                        <th>Department</th>
                        <th>License Type</th>
                        <th>Purchased</th>
                        <th>Assigned</th>
                        <th>Utilization %</th>
                        <th>Version / Plan</th>
                        <th>Start Date</th>
                        <th>Renewal / Support Due</th>
                        <th>Annual Cost (INR)</th>
                        <th>Payment Frequency</th>
                        <th>Auto-Renew</th>
                        <th>Criticality</th>
                        <th>Data Sensitivity</th>
                        <th>SSO / MFA</th>
                        <th>Contract / PO No.</th>
                        <th>Invoice No.</th>
                        <th>Status</th>
                        <th>Days to Renewal</th>
                        <th>Renewal Flag</th>
                        <th>Risk / Issue</th>
                        <th>Action Required</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="swregTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════ TAB 5: ONLINE SUBSCRIPTIONS (new, separate KV store) ══════════════ -->
<div class="tab-pane fade" id="tab-onlinesub">

    @if (!onlineSubs.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No online subscription records on file yet — add them one by one, or import your list as a CSV. Use <a href="/Endpoints/ExportITReport">Excel Report</a> first to see the exact column format.
        </div>
    }
    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-outline-dark btn-sm px-3" onclick="new bootstrap.Modal(document.getElementById('onlineSubImportModal')).show()"><i class="bi bi-upload"></i> Import CSV</button>
        <a href="/Endpoints/ExportITReport" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Excel Report</a>
        <button class="btn btn-primary btn-sm px-3" onclick="openOnlineSubModal(-1)"><i class="bi bi-plus-circle"></i> Add Subscription</button>
    </div>

    <div class="row g-2 mb-3" id="onlineSubSummary">
        <div class="col-3"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="onlineSubTotal">0</div><div class="small text-muted">Total Subscriptions</div></div></div>
        <div class="col-3"><div class="card border-0 bg-success-subtle text-center py-2"><div class="fw-bold fs-4 text-success" id="onlineSubActive">0</div><div class="small text-muted">Active</div></div></div>
        <div class="col-3"><div class="card border-0 bg-warning-subtle text-center py-2"><div class="fw-bold fs-4 text-warning" id="onlineSubDueSoon">0</div><div class="small text-muted">Renewal ≤ 30 Days</div></div></div>
        <div class="col-3"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="onlineSubExpired">0</div><div class="small text-muted">Expired</div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" style="font-size:12px">
                <thead style="background:#1e3a5f;color:white">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Subscription ID</th>
                        <th>Tool / Platform</th>
                        <th>Subscription Type</th>
                        <th>Use Case</th>
                        <th>Vendor</th>
                        <th>Website</th>
                        <th>Business Owner</th>
                        <th>Admin Account / Email</th>
                        <th>Department</th>
                        <th>Plan</th>
                        <th>Seats</th>
                        <th>Active Users</th>
                        <th>Utilization %</th>
                        <th>Billing Currency</th>
                        <th>Billing Amount</th>
                        <th>FX Rate to INR</th>
                        <th>Billing Amount (INR)</th>
                        <th>Billing Frequency</th>
                        <th>Annualized Cost (INR)</th>
                        <th>Start Date</th>
                        <th>Renewal Date</th>
                        <th>Auto-Renew</th>
                        <th>Payment Mode</th>
                        <th>Card/Bank Last 4</th>
                        <th>GST / Tax Credit</th>
                        <th>Data Shared</th>
                        <th>AI Data Retention/Training</th>
                        <th>Security Review</th>
                        <th>Criticality</th>
                        <th>Status</th>
                        <th>Days to Renewal</th>
                        <th>Renewal Flag</th>
                        <th>Duplicate / Overlap</th>
                        <th>Cost Saving Action</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="onlineSubTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════ TAB 6: IT SPEND LOG (new, separate KV store, append-only transaction log) ══════════════ -->
<div class="tab-pane fade" id="tab-spendlog">

    @if (!itSpendLog.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No spend log entries on file yet — add them one by one, or import your list as a CSV. Use <a href="/Endpoints/ExportITReport">Excel Report</a> first to see the exact column format.
        </div>
    }
    <div class="d-flex justify-content-end align-items-center mb-3 gap-2">
        <button class="btn btn-outline-dark btn-sm px-3" onclick="new bootstrap.Modal(document.getElementById('spendLogImportModal')).show()"><i class="bi bi-upload"></i> Import CSV</button>
        <a href="/Endpoints/ExportITReport" class="btn btn-outline-success btn-sm px-3"><i class="bi bi-download"></i> Excel Report</a>
        <button class="btn btn-primary btn-sm px-3" onclick="openSpendLogModal(-1)"><i class="bi bi-plus-circle"></i> Add Expense</button>
    </div>

    <div class="row g-2 mb-3" id="spendLogSummary">
        <div class="col-3"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold fs-4" id="spendLogTotal">0</div><div class="small text-muted">Total Entries</div></div></div>
        <div class="col-3"><div class="card border-0 bg-info-subtle text-center py-2"><div class="fw-bold fs-4 text-info" id="spendLogBaseTotal">0</div><div class="small text-muted">Total Base Amount (INR)</div></div></div>
        <div class="col-3"><div class="card border-0 bg-warning-subtle text-center py-2"><div class="fw-bold fs-4 text-warning" id="spendLogPending">0</div><div class="small text-muted">Pending/Overdue Payments</div></div></div>
        <div class="col-3"><div class="card border-0 bg-danger-subtle text-center py-2"><div class="fw-bold fs-4 text-danger" id="spendLogOverBudget">0</div><div class="small text-muted">Over Budget</div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" style="font-size:12px">
                <thead style="background:#1e3a5f;color:white">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Expense Date</th>
                        <th>Reporting Month</th>
                        <th>Expense ID</th>
                        <th>Vendor</th>
                        <th>Tool / Software</th>
                        <th>Subscription Type</th>
                        <th>Cost Category</th>
                        <th>Department</th>
                        <th>Invoice No.</th>
                        <th>PO/Contract No.</th>
                        <th>Base Amount (INR)</th>
                        <th>GST (INR)</th>
                        <th>Gross Amount</th>
                        <th>TDS (INR)</th>
                        <th>Net Paid/Payable</th>
                        <th>Payment Date</th>
                        <th>Payment Status</th>
                        <th>Payment Mode</th>
                        <th>Budget Amount (INR)</th>
                        <th>Variance to Budget</th>
                        <th>Capex/Opex</th>
                        <th>Cost Center</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="spendLogTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

</div>

<!-- ═══ Add/Edit Endpoint Modal (existing) ═══ -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#0A192F;color:white">
                <h5 class="modal-title">Add Endpoint</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label fw-bold small">Name</label><input type="text" id="newName" class="form-control" placeholder="My Server"/></div>
                <div class="mb-3"><label class="form-label fw-bold small">URL</label><input type="text" id="newUrl" class="form-control" placeholder="https://example.com"/></div>
                <div class="mb-3"><label class="form-label fw-bold small">Category</label>
                    <select id="newCat" class="form-select">
                        @foreach(var c in new[]{"Internal","External","Cloud","Server","API","Other"})
                        {<option>@c</option>}
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="saveEndpoint()">Add</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Import PC CSV Modal ═══ -->
<div class="modal fade" id="pcImportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Endpoints/ImportPcCsv" enctype="multipart/form-data">
                <div class="modal-header" style="background:#0A192F;color:white">
                    <h5 class="modal-title">Import PC Inventory (CSV)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Columns: Hostname, IP Address, OS, CPU, RAM GB, Disk Free, User, QH Version, QH Service, License Key, Last Seen, Notes. Matches existing rows by Hostname (updates them); new hostnames are added. Use <a href="/Endpoints/ExportPcInventory">Export CSV</a> to see the exact format.</p>
                    <input type="file" name="csvFile" accept=".csv" class="form-control" required/>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══ Import Licenses CSV Modal ═══ -->
<div class="modal fade" id="licImportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Endpoints/ImportLicensesCsv" enctype="multipart/form-data">
                <div class="modal-header" style="background:#1e3a5f;color:white">
                    <h5 class="modal-title">Import Licenses (CSV)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
