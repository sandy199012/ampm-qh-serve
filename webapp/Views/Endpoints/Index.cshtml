// ───────────── Online Subscriptions (separate from IT Software Register above) ─────────────
function onlineSubDaysToRenewal(l) {
    if (!l.renewalDate) return '';
    const rd = new Date(l.renewalDate);
    if (isNaN(rd)) return '';
    const today = new Date(); today.setHours(0,0,0,0);
    return Math.round((rd - today) / 86400000);
}

function onlineSubRenewalFlag(l) {
    if (!l.renewalDate) return '';
    if ((l.status || '') !== 'Active') return 'Inactive';
    const days = onlineSubDaysToRenewal(l);
    if (days === '') return '';
    if (days < 0) return 'Expired';
    if (days <= 30) return 'Due within 30 days';
    if (days <= 60) return 'Due in 31-60 days';
    if (days <= 90) return 'Due in 61-90 days';
    return 'Later';
}

function onlineSubUtilization(l) {
    const seats = parseFloat(l.seats) || 0;
    const active = parseFloat(l.activeUsers) || 0;
    if (!seats) return '';
    return (Math.round((active / seats) * 1000) / 10) + '%';
}

function onlineSubBillingAmountInr(l) {
    const amt = parseFloat(l.billingAmount) || 0;
    const fx = parseFloat(l.fxRate) || 0;
    if (!amt || !fx) return 0;
    return amt * fx;
}

function onlineSubAnnualizedCostInr(l) {
    const inr = onlineSubBillingAmountInr(l);
    if (!inr) return 0;
    const mult = { 'Monthly': 12, 'Quarterly': 4, 'Half-Yearly': 2, 'Annual': 1, 'One-time': 1 }[l.billingFrequency || ''] ?? 1;
    return inr * mult;
}

function nextOnlineSubId() {
    let max = 0;
    onlineSubs.forEach(l => {
        const m = /^OS-(\d+)$/.exec(l.subscriptionId || '');
        if (m) max = Math.max(max, parseInt(m[1]));
    });
    return 'OS-' + String(max + 1).padStart(3, '0');
}

