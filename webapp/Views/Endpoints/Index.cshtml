    const l = i >= 0 ? itSpendLog[i] : {};
    document.getElementById('spendLogModalTitle').textContent = i >= 0 ? 'Edit Expense' : 'Add Expense';
    document.getElementById('spendLogExpenseDate').value = l.expenseDate || '';
    document.getElementById('spendLogExpenseId').value = l.expenseId || '';
    document.getElementById('spendLogVendor').value = l.vendor || '';
    document.getElementById('spendLogTool').value = l.toolSoftware || '';
    document.getElementById('spendLogSubType').value = l.subscriptionType || '';
    document.getElementById('spendLogCostCategory').value = l.costCategory || 'Software License';
    document.getElementById('spendLogDepartment').value = l.department || 'IT';
    document.getElementById('spendLogInvoiceNo').value = l.invoiceNo || '';
    document.getElementById('spendLogPoNo').value = l.poContractNo || '';
    document.getElementById('spendLogBaseAmount').value = l.baseAmount || '';
    document.getElementById('spendLogGst').value = l.gst || '';
    document.getElementById('spendLogTds').value = l.tds || '';
    document.getElementById('spendLogPaymentDate').value = l.paymentDate || '';
    document.getElementById('spendLogPaymentStatus').value = l.paymentStatus || 'Pending';
    document.getElementById('spendLogPaymentMode').value = l.paymentMode || '';
    document.getElementById('spendLogBudgetAmount').value = l.budgetAmount || '';
    document.getElementById('spendLogCapexOpex').value = l.capexOpex || 'Opex';
    document.getElementById('spendLogCostCenter').value = l.costCenter || '';
    document.getElementById('spendLogRemarks').value = l.remarks || '';
    new bootstrap.Modal(document.getElementById('spendLogModal')).show();
}

function saveSpendLog() {
    const i = parseInt(document.getElementById('spendLogIdx').value);
    let expenseId = document.getElementById('spendLogExpenseId').value.trim();
    const vendor = document.getElementById('spendLogVendor').value.trim();
    const tool = document.getElementById('spendLogTool').value.trim();
    if (!vendor && !tool) return alert('Vendor or Tool / Software is required!');
    if (!expenseId) expenseId = nextExpenseId();
    const rec = {
        expenseId,
        expenseDate: document.getElementById('spendLogExpenseDate').value,
        vendor,
        toolSoftware: tool,
        subscriptionType: document.getElementById('spendLogSubType').value.trim(),
        costCategory: document.getElementById('spendLogCostCategory').value,
        department: document.getElementById('spendLogDepartment').value,
        invoiceNo: document.getElementById('spendLogInvoiceNo').value.trim(),
        poContractNo: document.getElementById('spendLogPoNo').value.trim(),
        baseAmount: document.getElementById('spendLogBaseAmount').value,
        gst: document.getElementById('spendLogGst').value,
        tds: document.getElementById('spendLogTds').value,
        paymentDate: document.getElementById('spendLogPaymentDate').value,
        paymentStatus: document.getElementById('spendLogPaymentStatus').value,
        paymentMode: document.getElementById('spendLogPaymentMode').value.trim(),
        budgetAmount: document.getElementById('spendLogBudgetAmount').value,
        capexOpex: document.getElementById('spendLogCapexOpex').value,
        costCenter: document.getElementById('spendLogCostCenter').value.trim(),
        remarks: document.getElementById('spendLogRemarks').value.trim(),
    };
    if (i >= 0) itSpendLog[i] = rec; else itSpendLog.push(rec);
    persistSpendLog(() => {
        renderSpendLog();
        bootstrap.Modal.getInstance(document.getElementById('spendLogModal')).hide();
    });
}

function deleteSpendLog(i) {
    if (!confirm('Delete this expense entry?')) return;
    itSpendLog.splice(i, 1);
    persistSpendLog(renderSpendLog);
}

function persistSpendLog(cb) {
    fetch('/Endpoints/SaveITSpendLog', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(itSpendLog)
    }).then(() => cb && cb());
}
</script>
}
