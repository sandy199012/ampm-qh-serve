                    <div class="col-12"><label class="form-label fw-bold small">Remarks</label><textarea id="onlineSubRemarks" class="form-control" rows="2"></textarea></div>
                    <div class="col-12 text-muted small"><i class="bi bi-info-circle"></i> Utilization %, Billing Amount (INR), Annualized Cost (INR), Days to Renewal and Renewal Flag are calculated automatically — no need to enter them.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="saveOnlineSub()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Add/Edit IT Spend Log Modal ═══ -->
<div class="modal fade" id="spendLogModal" tabindex="-1">
