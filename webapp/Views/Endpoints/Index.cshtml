                    <div class="col-md-4"><label class="form-label fw-bold small">Expense ID</label><input type="text" id="spendLogExpenseId" class="form-control" placeholder="auto if blank"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Vendor</label><input type="text" id="spendLogVendor" class="form-control"/></div>

                    <div class="col-md-6"><label class="form-label fw-bold small">Tool / Software</label><input type="text" id="spendLogTool" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">Subscription Type</label><input type="text" id="spendLogSubType" class="form-control"/></div>

                    <div class="col-md-6"><label class="form-label fw-bold small">Cost Category</label>
