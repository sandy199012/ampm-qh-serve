                    <div class="col-md-6"><label class="form-label fw-bold small">Invoice No.</label><input type="text" id="spendLogInvoiceNo" class="form-control"/></div>
                    <div class="col-md-6"><label class="form-label fw-bold small">PO/Contract No.</label><input type="text" id="spendLogPoNo" class="form-control"/></div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Base Amount (INR)</label><input type="number" id="spendLogBaseAmount" class="form-control" min="0" step="0.01"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">GST (INR)</label><input type="number" id="spendLogGst" class="form-control" min="0" step="0.01"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">TDS (INR)</label><input type="number" id="spendLogTds" class="form-control" min="0" step="0.01"/></div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Payment Date</label><input type="date" id="spendLogPaymentDate" class="form-control"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Payment Status</label>
                        <select id="spendLogPaymentStatus" class="form-select">
                            @foreach(var c in new[]{"Paid","Pending","Overdue","Partially Paid"})
                            {<option>@c</option>}
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Payment Mode</label><input type="text" id="spendLogPaymentMode" class="form-control" placeholder="Bank Transfer / Card / UPI"/></div>

                    <div class="col-md-4"><label class="form-label fw-bold small">Budget Amount (INR)</label><input type="number" id="spendLogBudgetAmount" class="form-control" min="0" step="0.01"/></div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Capex/Opex</label>
                        <select id="spendLogCapexOpex" class="form-select"><option>Opex</option><option>Capex</option></select>
                    </div>
                    <div class="col-md-4"><label class="form-label fw-bold small">Cost Center</label><input type="text" id="spendLogCostCenter" class="form-control"/></div>

