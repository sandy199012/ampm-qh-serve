                <button class="btn btn-outline-warning btn-sm" onclick="openSpendLogModal(${i})" title="Edit"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-outline-danger btn-sm" onclick="deleteSpendLog(${i})" title="Delete"><i class="bi bi-trash"></i></button>
            </td>
        </tr>`;
    });
    body.innerHTML = rows || '<tr><td colspan="25" class="text-center text-muted py-4">No spend log entries added yet</td></tr>';
    document.getElementById('spendLogTotal').textContent = total;
    document.getElementById('spendLogBaseTotal').textContent = baseTotal.toLocaleString('en-IN', {maximumFractionDigits:0});
    document.getElementById('spendLogPending').textContent = pending;
    document.getElementById('spendLogOverBudget').textContent = overBudget;
}

