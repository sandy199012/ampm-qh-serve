@{ViewData["Title"] = "New Purchase Order";
  string[] depts = {"IT","HR","ACCOUNTS & FINANCE","ADMIN","DESIGN - APPAREL","PRODUCTION - APPAREL","PRODUCTION - LEATHER","WAREHOUSE & LOGISTICS","RETAILS","MERCHANDISING","QUALITY","MANAGEMENT","E-Commerce","MARKETING"};}

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/PurchaseOrders/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-plus text-success"></i> New Purchase Order</h5>
</div>

<form method="post" action="/PurchaseOrders/Create" id="poForm">
<div class="row g-3">
    <!-- PO Header -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold" style="background:#0A192F;color:white">PO Details</div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label small fw-bold">PO Date *</label>
                    <input type="date" name="poDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Priority</label>
                    <select name="priority" class="form-select">
                        <option>Normal</option><option>High</option><option selected>Urgent</option>
                    </select>
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Department</label>
                    <select name="dept" class="form-select">
                        @foreach(var d in depts){<option>@d</option>}
                    </select>
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Purpose *</label>
                    <input type="text" name="purpose" class="form-control" required placeholder="Purpose of purchase"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Delivery Date</label>
                    <input type="date" name="deliveryDate" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Payment Terms</label>
                    <select name="paymentTerms" class="form-select">
                        <option>100% Advance</option><option>50% Advance</option>
                        <option>Credit 30 Days</option><option>Credit 45 Days</option><option>On Delivery</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Vendor Details -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold" style="background:#1e3a5f;color:white">Vendor Details</div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label small fw-bold">Vendor Name *</label>
                    <input type="text" name="vendorName" id="vendorName" class="form-control" required placeholder="Vendor/Supplier name"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">GST Number</label>
                    <input type="text" name="vendorGst" class="form-control" placeholder="GSTIN"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Address</label>
                    <textarea name="vendorAddr" class="form-control" rows="2"></textarea></div>
                <div class="mb-3"><label class="form-label small fw-bold">Phone</label>
                    <input type="text" name="vendorPhone" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Contact Person</label>
                    <input type="text" name="vendorContact" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Approved By</label>
                    <input type="text" name="approvedBy" class="form-control" value="Sandeep Kumar Singh Kushwaha"/></div>
            </div>
        </div>
    </div>

    <!-- Items -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:#059669;color:white">
                <span class="fw-bold">Items</span>
                <button type="button" class="btn btn-sm btn-light" onclick="addItem()"><i class="bi bi-plus"></i> Add Item</button>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" id="itemsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width:40%">Description</th>
                            <th style="width:10%">Qty</th>
                            <th style="width:12%">Rate (Rs.)</th>
                            <th style="width:10%">GST %</th>
                            <th style="width:13%">Amount</th>
                            <th style="width:5%"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        <tr id="item_0">
                            <td><input type="text" name="items[0][desc]" class="form-control form-control-sm" placeholder="Item description" required/></td>
                            <td><input type="number" name="items[0][qty]" class="form-control form-control-sm qty" value="1" min="0.01" step="0.01" onchange="calcRow(0)"/></td>
                            <td><input type="number" name="items[0][rate]" class="form-control form-control-sm rate" value="0" min="0" step="0.01" onchange="calcRow(0)"/></td>
                            <td><input type="number" name="items[0][gst]" class="form-control form-control-sm gst" value="18" min="0" max="28" onchange="calcTotal()"/></td>
                            <td><input type="number" name="items[0][amount]" class="form-control form-control-sm amount" value="0" readonly style="background:#f8f9fa"/></td>
                            <td><button type="button" class="btn btn-danger btn-sm" onclick="removeItem(0)"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- GST & Totals -->
    <div class="col-md-6 offset-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold" style="background:#7C3AED;color:white">Amount Summary</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small fw-bold">GST Type</label>
                    <select name="gstType" id="gstType" class="form-select" onchange="calcTotal()">
                        <option value="IGST">IGST (Interstate)</option>
                        <option value="CGST_SGST">CGST + SGST (Intrastate)</option>
                    </select>
                </div>
                <table class="table table-sm">
                    <tr><td class="text-muted">Sub Total</td><td class="text-end fw-bold" id="subTotalDisp">&#8377;0.00</td></tr>
                    <tr><td class="text-muted" id="gstLabel">GST</td><td class="text-end" id="gstDisp">&#8377;0.00</td></tr>
                    <tr class="table-dark"><td class="fw-bold">Grand Total</td><td class="text-end fw-bold fs-5" id="grandDisp">&#8377;0.00</td></tr>
                </table>
                <input type="hidden" name="subTotal" id="subTotal" value="0"/>
                <input type="hidden" name="gstAmount" id="gstAmount" value="0"/>
                <input type="hidden" name="grandTotal" id="grandTotal" value="0"/>
            </div>
        </div>
    </div>

    <!-- Notes -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <label class="form-label small fw-bold">Notes / Terms</label>
                <textarea name="notes" class="form-control" rows="3" placeholder="Special instructions, terms and conditions..."></textarea>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <button type="submit" class="btn btn-success px-4"><i class="bi bi-file-earmark-check"></i> Create PO</button>
    <a href="/PurchaseOrders/Index" class="btn btn-outline-secondary px-4">Cancel</a>
</div>
</form>

@section Scripts {
<script>
let itemCount = 1;

function addItem() {
    const i = itemCount++;
    const row = `<tr id="item_${i}">
        <td><input type="text" name="items[${i}][desc]" class="form-control form-control-sm" placeholder="Item description" required/></td>
        <td><input type="number" name="items[${i}][qty]" class="form-control form-control-sm qty" value="1" min="0.01" step="0.01" onchange="calcRow(${i})"/></td>
        <td><input type="number" name="items[${i}][rate]" class="form-control form-control-sm rate" value="0" min="0" step="0.01" onchange="calcRow(${i})"/></td>
        <td><input type="number" name="items[${i}][gst]" class="form-control form-control-sm gst" value="18" onchange="calcTotal()"/></td>
        <td><input type="number" name="items[${i}][amount]" class="form-control form-control-sm amount" value="0" readonly style="background:#f8f9fa"/></td>
        <td><button type="button" class="btn btn-danger btn-sm" onclick="removeItem(${i})"><i class="bi bi-trash"></i></button></td>
    </tr>`;
    document.getElementById('itemsBody').insertAdjacentHTML('beforeend', row);
}

function removeItem(i) {
    const row = document.getElementById('item_' + i);
    if (row && document.querySelectorAll('#itemsBody tr').length > 1) {
        row.remove(); calcTotal();
    }
}

function calcRow(i) {
    const row = document.getElementById('item_' + i);
    if (!row) return;
    const qty = parseFloat(row.querySelector('.qty').value) || 0;
    const rate = parseFloat(row.querySelector('.rate').value) || 0;
    row.querySelector('.amount').value = (qty * rate).toFixed(2);
    calcTotal();
}

function calcTotal() {
    let subTotal = 0;
    document.querySelectorAll('#itemsBody tr').forEach(row => {
        const amt = parseFloat(row.querySelector('.amount')?.value) || 0;
        subTotal += amt;
    });
    // Weighted avg GST
    let gstAmt = 0;
    document.querySelectorAll('#itemsBody tr').forEach(row => {
        const amt = parseFloat(row.querySelector('.amount')?.value) || 0;
        const gst = parseFloat(row.querySelector('.gst')?.value) || 0;
        gstAmt += amt * gst / 100;
    });
    const grand = subTotal + gstAmt;
    document.getElementById('subTotal').value = subTotal.toFixed(2);
    document.getElementById('gstAmount').value = gstAmt.toFixed(2);
    document.getElementById('grandTotal').value = grand.toFixed(2);
    document.getElementById('subTotalDisp').innerHTML = '&#8377;' + subTotal.toFixed(2);
    document.getElementById('gstDisp').innerHTML = '&#8377;' + gstAmt.toFixed(2);
    document.getElementById('grandDisp').innerHTML = '&#8377;' + grand.toFixed(2);
    const gstType = document.getElementById('gstType').value;
    document.getElementById('gstLabel').textContent = gstType === 'IGST' ? 'IGST' : 'CGST + SGST';
}

// Init
calcRow(0);
</script>
}
