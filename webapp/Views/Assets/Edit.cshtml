@model Dictionary<string,object?>
@{ViewData["Title"] = "Edit Asset";
  var isPrinter = (Model.GetValueOrDefault("assetType")?.ToString() ?? "") == "Printer";
  var isNet = new[]{"Network Switch","WiFi Device","NVR","Camera","Other Network Device"}.Contains(Model.GetValueOrDefault("assetType")?.ToString() ?? "");
  var aid = Model.GetValueOrDefault("id")?.ToString() ?? "";
  string[] depts = {"IT","HR","ACCOUNTS & FINANCE","ADMIN","DESIGN - APPAREL","DESIGN - ACCESSORIES","PRODUCTION - APPAREL","PRODUCTION - LEATHER","PRODUCTION - MTO","WAREHOUSE & LOGISTICS","RETAILS","MERCHANDISING","QUALITY","MANAGEMENT","E-Commerce","MARKETING","SAMPLING - APPAREL","FABRIC STORE","RESEARCH & DEVELOPMENT","TRUNK SHOW","ACCESSORIES STORE"};}

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Assets/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">Edit — @Model.GetValueOrDefault("assetTag")</h5>
</div>
<form method="post" action="/Assets/Edit/@aid">
<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-bold" style="background:#0A192F;color:white">Asset Details</div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label small fw-bold">Asset Tag</label><input type="text" name="assetTag" value="@Model.GetValueOrDefault("assetTag")" class="form-control" readonly/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Asset Type</label>
                    <select name="assetType" id="assetType" class="form-select" onchange="onTypeChange()">
                        @{var curType = Model.GetValueOrDefault("assetType")?.ToString() ?? "";}
                        @foreach(var t in new[]{"Laptop","Desktop","Monitor","Printer","Tablet","Phone","Server","UPS","Network Switch","WiFi Device","NVR","Camera","Other Network Device","Other"})
                        {if(curType==t){<option selected>@t</option>}else{<option>@t</option>}}
                    </select>
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Brand</label><input type="text" name="brand" value="@Model.GetValueOrDefault("brand")" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Model</label><input type="text" name="model" value="@Model.GetValueOrDefault("model")" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Serial No.</label><input type="text" name="serial" value="@Model.GetValueOrDefault("serial")" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Condition</label>
                    <select name="condition" class="form-select">
                        @{var curCond = Model.GetValueOrDefault("condition")?.ToString() ?? "Good";}
                        @foreach(var c in new[]{"Good","Fair","Poor"})
                        {if(curCond==c){<option selected>@c</option>}else{<option>@c</option>}}
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-3" id="printerCard" style="@(isPrinter ? "" : "display:none")">
            <div class="card-header fw-bold" style="background:#0F766E;color:white"><i class="bi bi-printer"></i> Printer Details@if(!string.IsNullOrEmpty(Model.GetValueOrDefault("source")?.ToString())){<span class="badge bg-light text-dark ms-2 fw-normal">@Model.GetValueOrDefault("source")</span>}</div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label small fw-bold">Printer Type</label>
                    <select name="printerType" class="form-select" disabled="@(!isPrinter)">
                        @{var curPt = Model.GetValueOrDefault("printerType")?.ToString() ?? "";}
                        <option value="">Select...</option>
                        @foreach(var pt in new[]{"Laser","Inkjet","Multifunction (MFP)","Thermal / Label","Dot Matrix","Plotter","Other"})
                        {if(curPt==pt){<option selected>@pt</option>}else{<option>@pt</option>}}
                    </select>
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Connection</label>
                    <select name="connection" class="form-select" disabled="@(!isPrinter)">
                        @{var curCn = Model.GetValueOrDefault("connection")?.ToString() ?? "";}
                        @foreach(var cn in new[]{"Network (LAN)","Wi-Fi","USB"})
                        {if(curCn==cn){<option selected>@cn</option>}else{<option>@cn</option>}}
                    </select>
                </div>
                <div class="row g-2">
                    <div class="col-6 mb-3"><label class="form-label small fw-bold">IP Address</label><input type="text" name="ip" value="@Model.GetValueOrDefault("ip")" class="form-control" disabled="@(!isPrinter)"/></div>
                    <div class="col-6 mb-3"><label class="form-label small fw-bold">MAC Address</label><input type="text" name="mac" value="@Model.GetValueOrDefault("mac")" class="form-control" disabled="@(!isPrinter)"/></div>
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Hostname / Print Server Name</label><input type="text" name="hostname" value="@Model.GetValueOrDefault("hostname")" class="form-control" disabled="@(!isPrinter)"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Toner / Cartridge Model</label><input type="text" name="tonerModel" value="@Model.GetValueOrDefault("tonerModel")" class="form-control" disabled="@(!isPrinter)"/></div>
                @if(!string.IsNullOrEmpty(Model.GetValueOrDefault("connectedPc")?.ToString()))
                {
                    <div class="small text-muted mb-1">USB printer connected to PC: <b>@Model.GetValueOrDefault("connectedPc")</b> (port @Model.GetValueOrDefault("usbPort"))</div>
                }
                @if(!string.IsNullOrEmpty(Model.GetValueOrDefault("pageCount")?.ToString()))
                {
                    <div class="small text-muted">Page count (last scan): <b>@Model.GetValueOrDefault("pageCount")</b> &nbsp;|&nbsp; Last seen: @Model.GetValueOrDefault("lastSeen")</div>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-3" id="netCard" style="@(isNet ? "" : "display:none")">
            <div class="card-header fw-bold" style="background:#1D4ED8;color:white"><i class="bi bi-router"></i> Network Device Details@if(!string.IsNullOrEmpty(Model.GetValueOrDefault("source")?.ToString())){<span class="badge bg-light text-dark ms-2 fw-normal">@Model.GetValueOrDefault("source")</span>}</div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6 mb-3"><label class="form-label small fw-bold">IP Address</label><input type="text" name="ip" value="@Model.GetValueOrDefault("ip")" class="form-control" disabled="@(!isNet)"/></div>
                    <div class="col-6 mb-3"><label class="form-label small fw-bold">MAC Address</label><input type="text" name="mac" value="@Model.GetValueOrDefault("mac")" class="form-control" disabled="@(!isNet)"/></div>
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Hostname / Device Name</label><input type="text" name="hostname" value="@Model.GetValueOrDefault("hostname")" class="form-control" disabled="@(!isNet)"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Ports / Channels</label><input type="text" name="portCount" value="@Model.GetValueOrDefault("portCount")" class="form-control" disabled="@(!isNet)"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Location</label><input type="text" name="location" value="@Model.GetValueOrDefault("location")" class="form-control" disabled="@(!isNet)"/></div>
                @if(!string.IsNullOrEmpty(Model.GetValueOrDefault("lastSeen")?.ToString()))
                {
                    <div class="small text-muted">Last seen by scanner: <b>@Model.GetValueOrDefault("lastSeen")</b></div>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-3" id="specCard" style="@((isPrinter || isNet) ? "display:none" : "")">
            <div class="card-header fw-bold" style="background:#1e3a5f;color:white">Specifications</div>
            <div class="card-body">
                <div class="mb-3"><label class="form-label small fw-bold">Processor</label><input type="text" name="processor" value="@Model.GetValueOrDefault("processor")" class="form-control" disabled="@(isPrinter || isNet)"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">RAM (GB)</label><input type="text" name="ram" value="@Model.GetValueOrDefault("ram")" class="form-control" disabled="@(isPrinter || isNet)"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Storage (GB)</label><input type="text" name="storage" value="@Model.GetValueOrDefault("storage")" class="form-control" disabled="@(isPrinter || isNet)"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">OS</label><input type="text" name="os" value="@Model.GetValueOrDefault("os")" class="form-control" disabled="@(isPrinter || isNet)"/></div>
            </div>
        </div>
        <div class="card border-0 shadow-sm" id="assignCard" style="@(isNet ? "display:none" : "")">
            <div class="card-header fw-bold" style="background:#059669;color:white">Assignment</div>
            <div class="card-body">
                @{ var employees = (List<Dictionary<string,object?>>)(ViewBag.Employees ?? new List<Dictionary<string,object?>>()); }
                <div class="mb-3"><label class="form-label small fw-bold">Select Employee <span class="fw-normal text-muted">(optional — auto-fills below)</span></label>
                    <select id="empSelect" class="form-select" onchange="fillAssetEmp()">
                        <option value="">-- Select Employee --</option>
                        @foreach(var e in employees)
                        {
                            var nm = e.GetValueOrDefault("name")?.ToString() ?? "";
                            var cd = e.GetValueOrDefault("emp")?.ToString() ?? "";
                            var dp = e.GetValueOrDefault("dept")?.ToString() ?? "";
                            <option value="@nm" data-emp="@cd" data-dept="@dp">@nm (@cd)@(string.IsNullOrEmpty(dp) ? "" : " — " + dp)</option>
                        }
                    </select>
                    @if (!employees.Any())
                    {
                        <div class="small text-muted mt-1"><i class="bi bi-info-circle"></i> No employees in Employee Master yet — <a href="/Employees/Create">add one</a> or type details manually below.</div>
                    }
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Assigned To (Name)</label><input type="text" name="assignedToName" value="@Model.GetValueOrDefault("assignedToName")" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Emp Code</label><input type="text" name="assignedToEmp" value="@Model.GetValueOrDefault("assignedToEmp")" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Department</label>
                    <select name="assignedToDept" id="assignedToDept" class="form-select">
                        @{var curDept = Model.GetValueOrDefault("assignedToDept")?.ToString() ?? "";}
                        <option value="">Select...</option>
                        @foreach(var d in depts)
                        {if(curDept==d){<option selected>@d</option>}else{<option>@d</option>}}
                    </select>
                </div>
                <div class="mb-3"><label class="form-label small fw-bold">Assigned Date</label><input type="date" name="assignedDate" value="@Model.GetValueOrDefault("assignedDate")" class="form-control"/></div>
                <div class="mb-3"><label class="form-label small fw-bold">Location</label><input type="text" name="location" value="@Model.GetValueOrDefault("location")" class="form-control"/></div>
            </div>
        </div>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save</button>
    <a href="/Assets/Index" class="btn btn-outline-secondary px-4">Cancel</a>
</div>
</form>

@section Scripts {
<script>
function toggleCard(id, show) {
    const c = document.getElementById(id);
    c.style.display = show ? '' : 'none';
    // Inputs in a hidden card are disabled so they are NOT posted (existing values stay untouched).
    c.querySelectorAll('input,select,textarea').forEach(i => i.disabled = !show);
}
const netTypes = ['Network Switch', 'WiFi Device', 'NVR', 'Camera', 'Other Network Device'];
function onTypeChange() {
    const t = document.getElementById('assetType').value;
    const isPrn = t === 'Printer';
    const isNet = netTypes.indexOf(t) >= 0;
    toggleCard('printerCard', isPrn);
    toggleCard('netCard', isNet);
    toggleCard('specCard', !isPrn && !isNet);
    toggleCard('assignCard', !isNet);
}
onTypeChange();
function fillAssetEmp() {
    const sel = document.getElementById('empSelect');
    const opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.value) return;
    document.querySelector('input[name="assignedToName"]').value = opt.value;
    document.querySelector('input[name="assignedToEmp"]').value = opt.dataset.emp || '';
    const deptSel = document.getElementById('assignedToDept');
    const wanted = (opt.dataset.dept || '').trim().toUpperCase();
    for (const o of deptSel.options) {
        if (o.value.trim().toUpperCase() === wanted) { deptSel.value = o.value; break; }
    }
}
</script>
}
