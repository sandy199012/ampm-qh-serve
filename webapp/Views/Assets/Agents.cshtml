@{
    ViewData["Title"] = "Agents";
    var pcTotal   = (int)(ViewBag.PcTotal ?? 0);
    var pc1h      = (int)(ViewBag.PcLast1h ?? 0);
    var pc24h     = (int)(ViewBag.PcLast24h ?? 0);
    var pcNewest  = (string)(ViewBag.PcNewest ?? "");
    var pcHost    = (string)(ViewBag.PcNewestHost ?? "");
    var prInfo    = ViewBag.PrinterScanInfo as Dictionary<string,object?>;
    var nwInfo    = ViewBag.NetScanInfo as Dictionary<string,object?>;
    bool keyEnv   = (bool)(ViewBag.KeyFromEnv ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-cloud-download" style="color:#7C3AED"></i> Agents &mdash; auto-update your assets</h5>
    <a href="/Assets/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Asset Stock</a>
</div>

<div class="alert alert-light border small">
    The website cannot see your office PCs or network from the internet, so small agents run <b>inside the office</b> and send the details here.
    Download an agent <b>from this page</b> &mdash; the access key is put inside it automatically. To update an agent (new version or new key), just download it again and run its Setup file again.
    @if (!keyEnv)
    {
        <div class="text-danger mt-1"><i class="bi bi-exclamation-triangle"></i> The server is still using the built-in default key. For better security set <code>AMPM_AGENT_KEY</code> in Render &rarr; Environment, then download the agents again.</div>
    }
</div>

<div class="row g-3">

  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h6 class="fw-bold"><i class="bi bi-pc-display text-primary"></i> PC Agent</h6>
        <p class="small text-muted mb-2">Runs on <b>every office PC / laptop</b>. Sends hostname, IP, MAC, OS, CPU, RAM, disk, serial number, installed software, the signed-in user and any <b>USB printers</b> plugged into that PC &mdash; at every start-up and every 10 minutes.</p>
        <div class="small mb-3">
            @if (pcTotal == 0) { <span class="badge bg-secondary">No PC has reported yet</span> }
            else
            {
                <span class="badge bg-@(pc1h > 0 ? "success" : "warning text-dark")">@pc1h PC reported in the last hour</span>
                <span class="badge bg-light text-dark border">@pc24h of @pcTotal in last 24 h</span>
                @if (pcNewest != "") { <div class="text-muted mt-1">Latest report: <b>@pcNewest</b> (@pcHost)</div> }
            }
        </div>
        <a href="/Assets/AgentDownload?type=pc" class="btn btn-primary btn-sm"><i class="bi bi-download"></i> Download PC Agent</a>
        <ol class="small mt-3 mb-0 ps-3">
            <li>Extract the ZIP on the PC.</li>
            <li>Double-click <b>AMPM_PC_Agent.bat</b> to report once.</li>
            <li>Right-click <b>AMPM_PC_Agent_Setup.bat</b> &rarr; <b>Run as administrator</b> (once) &mdash; after that it reports by itself.</li>
        </ol>
        <div class="small text-muted mt-2">Data goes to <b>Endpoints &rarr; PC Inventory</b> and the PC's row in Asset Stock.</div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h6 class="fw-bold"><i class="bi bi-printer text-success"></i> Printer Agent</h6>
        <p class="small text-muted mb-2">Run on <b>one PC inside the office network</b>. Finds every <b>network printer</b> (tag <b>PRN-</b>) with IP, MAC, brand, model, serial number and page count. (USB printers come from the PC Agent.)</p>
        <div class="small mb-3">
            @if (prInfo == null) { <span class="badge bg-secondary">No scan received yet</span> }
            else
            {
                <span class="badge bg-success">Last scan @prInfo.GetValueOrDefault("time")</span>
                <div class="text-muted mt-1">from <b>@prInfo.GetValueOrDefault("scannedFrom")</b> (@prInfo.GetValueOrDefault("subnets")) &mdash; @prInfo.GetValueOrDefault("found") found, @prInfo.GetValueOrDefault("added") new, @prInfo.GetValueOrDefault("updated") updated</div>
            }
        </div>
        <a href="/Assets/AgentDownload?type=printer" class="btn btn-success btn-sm"><i class="bi bi-download"></i> Download Printer Agent</a>
        <ol class="small mt-3 mb-0 ps-3">
            <li>Extract the ZIP on one office PC.</li>
            <li>Double-click <b>AMPM_Printer_Agent.bat</b> &mdash; takes 10&ndash;30 seconds.</li>
            <li>Optional: <b>AMPM_Printer_Agent_Setup.bat</b> (run as administrator) scans every day at 11:00.</li>
        </ol>
        <div class="small text-muted mt-2">Data goes to the <b>Assets</b> list (type Printer).</div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h6 class="fw-bold"><i class="bi bi-router text-warning"></i> Network Device Agent</h6>
        <p class="small text-muted mb-2">Run on <b>one PC inside the office network</b>. Finds <b>switches, WiFi / routers, NVR / DVR and IP cameras</b> (tags <b>SW- WIFI- NVR- CAM-</b>) with IP, MAC, brand, model and serial. Anything it cannot identify comes in as <b>NET-</b> &ldquo;Other Network Device&rdquo; &mdash; set its real type with Edit.</p>
        <div class="small mb-3">
            @if (nwInfo == null) { <span class="badge bg-secondary">No scan received yet</span> }
            else
            {
                <span class="badge bg-success">Last scan @nwInfo.GetValueOrDefault("time")</span>
                <div class="text-muted mt-1">from <b>@nwInfo.GetValueOrDefault("scannedFrom")</b> (@nwInfo.GetValueOrDefault("subnets")) &mdash; @nwInfo.GetValueOrDefault("found") found, @nwInfo.GetValueOrDefault("added") new, @nwInfo.GetValueOrDefault("updated") updated</div>
            }
        </div>
        <a href="/Assets/AgentDownload?type=network" class="btn btn-warning btn-sm"><i class="bi bi-download"></i> Download Network Device Agent</a>
        <ol class="small mt-3 mb-0 ps-3">
            <li>Extract the ZIP on one office PC.</li>
            <li>Double-click <b>AMPM_Network_Agent.bat</b> &mdash; takes 2&ndash;4 minutes.</li>
            <li>Optional: <b>AMPM_Network_Agent_Setup.bat</b> (run as administrator) scans every day at 11:30.</li>
        </ol>
        <div class="small text-muted mt-2">Data goes to <b>Asset Stock &rarr; Network Devices</b> tab.</div>
      </div>
    </div>
  </div>

</div>

<div class="row g-3 mt-0">
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h6 class="fw-bold"><i class="bi bi-apple text-dark"></i> Mac Agent <span class="badge bg-light text-dark border fw-normal">macOS</span></h6>
        <p class="small text-muted mb-2">The same as the PC Agent, but for <b>MacBook / iMac / Mac mini</b>. Sends hostname, IP, MAC, macOS version, model, serial number, chip / CPU, RAM, disk, installed apps, the signed-in user and any <b>USB printers</b> &mdash; at every restart and every 10 minutes.</p>
        <a href="/Assets/AgentDownload?type=mac" class="btn btn-dark btn-sm"><i class="bi bi-download"></i> Download Mac Agent</a>
        <ol class="small mt-3 mb-0 ps-3">
            <li>Unzip the file on the Mac (double-click it).</li>
            <li>Double-click <b>AMPM_Mac_Agent.command</b> to report once. If macOS blocks it: right-click &rarr; <b>Open</b> &rarr; <b>Open</b>.</li>
            <li>Double-click <b>AMPM_Mac_Agent_Setup.command</b> (once, asks the Mac's admin password) &mdash; after that it reports by itself.</li>
        </ol>
        <div class="small text-muted mt-2">Data goes to <b>Endpoints &rarr; PC Inventory</b> and the Mac's row in Asset Stock (same as Windows PCs).</div>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body small text-muted">
        <b>Mac tips.</b>
        <ul class="mb-2 mt-1 ps-3">
            <li>Prefer Terminal? Open the unzipped folder in Terminal and run <code>sudo bash AMPM_Mac_Agent_Setup.command</code>.</li>
            <li>The Mac must be on the internet (the agent talks to this website). It works on both Apple Silicon and Intel Macs.</li>
            <li>Log file: <code>ampm_agent_log.txt</code> next to the script, and in <code>/Library/Application Support/AMPM/PcAgent</code> for the automatic runs. If a Mac does not show up here, that log says why.</li>
            <li>To stop it on a Mac: <code>sudo launchctl bootout system /Library/LaunchDaemons/com.ampm.pcagent.plist</code> and delete that file.</li>
            <li>The Mac's name in the list is its <b>Sharing &rarr; Local hostname</b> (System Settings &rarr; General &rarr; Sharing), for example <code>Sandys-MacBook-Pro</code>.</li>
        </ul>
        Network printers / switches / cameras are found by the Printer and Network agents above (run those on one Windows PC in the office).
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mt-3">
  <div class="card-body">
    <h6 class="fw-bold"><i class="bi bi-phone" style="color:#7C3AED"></i> Mobile phones &amp; tablets &mdash; no agent needed</h6>
    <p class="small text-muted mb-2">
        Share this link with employees. They open it in Chrome / Safari <b>on their phone</b>, log in, and the page reads the model, Android/iOS version, screen, RAM hint and battery by itself.
        They type the <b>IMEI</b> and <b>serial</b> once (dial <code>*#06#</code>) &mdash; the IMEI is checked for correctness. The phone is saved in Asset Stock (tag <b>MOB-</b> / <b>IPAD-</b>) against their name.
    </p>
    <div class="input-group input-group-sm mb-2" style="max-width:520px">
        <input type="text" class="form-control font-monospace" id="mobLink" readonly/>
        <button class="btn btn-outline-primary" type="button" onclick="copyMobLink()"><i class="bi bi-clipboard"></i> Copy link</button>
        <a class="btn btn-outline-secondary" href="/MyDevice" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Open</a>
    </div>
    <div class="small mb-2">
        <b>Helpdesk Android app:</b> share <a href="/app" target="_blank" class="font-monospace" id="appLink">/app</a>
        &mdash; always gives the newest APK. Installed apps update themselves from inside the app.
    </div>
    <div class="small text-muted">
        A browser or normal app can never read IMEI / serial on Android 10+ or iOS &mdash; only an MDM (Mobile Device Management) tool can do that fully automatically.
        Results show in <b>Asset Stock</b> and in <b>Monitor &rarr; Mobile Devices</b>.
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mt-3">
  <div class="card-body small text-muted">
    <b>Tips.</b> Other VLAN / subnet? Open the agent's <code>.ps1</code> in Notepad and add it to <code>$extraSubnets</code> (e.g. <code>'192.168.2'</code>).
    Switches and WiFi devices are recognised best with <b>SNMP v1/v2c (community &ldquo;public&rdquo;)</b> enabled on them; for cameras and NVR switch <b>ONVIF</b> on in their settings so the model shows up.
    Every agent writes a log file next to itself (<code>ampm_agent_log.txt</code>, <code>ampm_printer_log.txt</code>, <code>ampm_network_log.txt</code>) &mdash; if something does not show here, that log says why.
    Devices you already edited by hand (assignment, location, type) are never overwritten by an agent.
  </div>
</div>

@section Scripts {
<script>
    document.getElementById('mobLink').value = location.origin + '/MyDevice';
    document.getElementById('appLink').textContent = location.origin + '/app';
    function copyMobLink() {
        const el = document.getElementById('mobLink');
        el.select();
        if (navigator.clipboard) navigator.clipboard.writeText(el.value).catch(() => document.execCommand('copy'));
        else document.execCommand('copy');
    }
</script>
}
