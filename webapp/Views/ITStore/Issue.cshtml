@model Dictionary<string,object?>
@using System.Linq
@{ViewData["Title"] = "Issue Item";
  var sid = Model.GetValueOrDefault("id")?.ToString() ?? "";
  int.TryParse(Model.GetValueOrDefault("totalQty")?.ToString(), out var t);
  int.TryParse(Model.GetValueOrDefault("issuedQty")?.ToString(), out var iss);
  int bal = t - iss;
  string[] depts = {"IT","HR","ACCOUNTS & FINANCE","ADMIN","DESIGN - APPAREL","PRODUCTION - APPAREL","PRODUCTION - LEATHER","WAREHOUSE & LOGISTICS","RETAILS","MERCHANDISING","QUALITY","MANAGEMENT","E-Commerce","MARKETING"};
  var employees = ViewBag.Employees as List<Dictionary<string,object?>> ?? new();
  var empLookup = employees.Select(e => new {
      name = e.GetValueOrDefault("name")?.ToString() ?? "",
      empId = e.GetValueOrDefault("emp")?.ToString() ?? "",
      dept = e.GetValueOrDefault("dept")?.ToString() ?? "",
      desig = e.GetValueOrDefault("designation")?.ToString() ?? "",
      hod = e.GetValueOrDefault("manager")?.ToString() ?? "",
  }).Where(e => !string.IsNullOrWhiteSpace(e.name)).ToList();
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/ITStore/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">Issue — @Model.GetValueOrDefault("name")</h5>
    <span class="badge bg-@(bal>2?"success":bal>0?"warning":"danger")">Balance: @bal</span>
</div>
<div class="row justify-content-center"><div class="col-lg-6">
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form method="post" action="/ITStore/Issue/@sid">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">Employee Name *</label>
            <input type="text" name="empName" id="empName" class="form-control" required
                   list="empList" autocomplete="off" placeholder="Naam type karo, list se select karo"/>
            <datalist id="empList">
                @foreach(var e in empLookup){<option value="@e.name"></option>}
            </datalist>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Employee ID</label>
            <input type="text" name="empId" id="empId" class="form-control" placeholder="e.g. 00405"/>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Department *</label>
            <select name="dept" id="empDept" class="form-select" required>
                <option value="">Select...</option>
                @foreach(var d in depts){<option>@d</option>}
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Designation</label>
            <input type="text" name="empDesig" id="empDesig" class="form-control" placeholder="e.g. Assistant Accountant"/>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">HOD / Manager</label>
            <input type="text" name="empHod" id="empHod" class="form-control" placeholder="Reporting manager"/>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Qty to Issue *</label>
            <input type="number" name="qty" class="form-control" required min="1" max="@bal" value="1"/>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Purpose</label>
            <input type="text" name="purpose" class="form-control" placeholder="Replacement/New/Repair"/>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Remarks</label>
            <input type="text" name="remarks" class="form-control" placeholder="Optional remarks"/>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-arrow-up-right"></i> Issue</button>
        <a href="/ITStore/Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>
</div></div>
<div class="alert alert-light border mt-3 small text-muted">
    <i class="bi bi-info-circle"></i> Issue karne ke baad "Issue History" table mein us row se <b>Print</b> karke form nikalo, employee se sign karwao, scan karke <b>Upload</b> button se attach kar do.
</div>
</div></div>

@section Scripts {
<script>
// Employee master (name -> id/dept/designation/HOD) — populated server-side
// from the Employees module, so selecting a name here auto-fills the rest
// instead of typing every field by hand.
const AMPM_EMP_LOOKUP = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(empLookup));
(function(){
    const byName = {};
    AMPM_EMP_LOOKUP.forEach(function(e){ byName[e.name] = e; });
    const nameInput = document.getElementById('empName');
    function applyMatch(){
        const rec = byName[nameInput.value];
        if (!rec) return;
        document.getElementById('empId').value = rec.empId || '';
        document.getElementById('empDesig').value = rec.desig || '';
        document.getElementById('empHod').value = rec.hod || '';
        const deptSel = document.getElementById('empDept');
        const wanted = (rec.dept || '').trim().toUpperCase();
        for (const opt of deptSel.options) {
            if (opt.value.trim().toUpperCase() === wanted) { deptSel.value = opt.value; break; }
        }
    }
    nameInput.addEventListener('input', applyMatch);
    nameInput.addEventListener('change', applyMatch);
})();
</script>
}
