@{ViewData["Title"] = "Bulk Upload Bills";}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/PurchaseBills/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-arrow-up text-dark"></i> Bulk Upload Bill PDFs</h5>
</div>

<div class="row justify-content-center"><div class="col-lg-7">
<div class="card border-0 shadow-sm"><div class="card-body p-4">

    <div class="alert alert-light border small mb-4">
        <i class="bi bi-info-circle"></i> Sare bill PDFs ek saath yahan upload kar dein — koi PO ya Budget select karne ki zaroorat nahi hai abhi.
        Har bill "Unmapped" list mein aa jayega, phir aap ek-ek karke usko PO aur Budget line se map kar sakte hain.
    </div>

    <form method="post" action="/PurchaseBills/BulkUpload" enctype="multipart/form-data" id="bulkForm">
        <div class="mb-3">
            <label class="form-label small fw-bold">Select Bill PDFs (multiple allowed) *</label>
            <input type="file" name="files" id="filesInput" class="form-control" multiple accept="application/pdf" required onchange="showList()"/>
        </div>
        <div id="fileList" class="small text-muted mb-3"></div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-dark px-4" id="uploadBtn"><i class="bi bi-upload"></i> Upload All</button>
            <a href="/PurchaseBills/Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>

</div></div>
</div></div>

@section Scripts {
<script>
function showList() {
    const files = document.getElementById('filesInput').files;
    const list = document.getElementById('fileList');
    if (!files.length) { list.innerHTML = ''; return; }
    let html = '<b>' + files.length + ' file(s) selected:</b><ul class="mb-0">';
    for (const f of files) html += '<li>' + f.name + ' (' + (f.size/1024).toFixed(0) + ' KB)</li>';
    html += '</ul>';
    list.innerHTML = html;
}
document.getElementById('bulkForm').addEventListener('submit', function() {
    const btn = document.getElementById('uploadBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Uploading...';
});
</script>
}
