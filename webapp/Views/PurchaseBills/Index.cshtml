@model List<Dictionary<string,object?>>
@{
    ViewData["Title"] = "Purchase Bills";
    double total = ViewBag.Total ?? 0;
    int unmappedCount = ViewBag.UnmappedCount ?? 0;
    string curStatus = ViewBag.StatusFilter as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-bold mb-0"><i class="bi bi-receipt text-dark"></i> Purchase Bills &mdash; @Model.Count <span class="text-muted small">(₹@total.ToString("N0"))</span></h5>
    <div class="d-flex gap-2">
        <a href="/PurchaseBills/BulkUpload" class="btn btn-outline-dark btn-sm px-3"><i class="bi bi-file-earmark-arrow-up"></i> Bulk Upload PDFs</a>
        <a href="/PurchaseBills/Create" class="btn btn-dark btn-sm px-3"><i class="bi bi-plus-circle"></i> Record Bill</a>
    </div>
</div>

@if (unmappedCount > 0)
{
    <div class="alert alert-warning small d-flex justify-content-between align-items-center">
        <span><i class="bi bi-exclamation-triangle"></i> <b>@unmappedCount</b> uploaded bill(s) not yet mapped to a PO / Budget line.</span>
        <a href="/PurchaseBills/Index?status=Unmapped" class="btn btn-warning btn-sm">Show Unmapped</a>
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.PoFilter as string))
{
    <div class="alert alert-light border small">Showing bills for PO <b>@ViewBag.PoFilter</b> — <a href="/PurchaseBills/Index">clear filter</a></div>
}
@if (!string.IsNullOrEmpty(curStatus))
{
    <div class="alert alert-light border small">Showing <b>@curStatus</b> bills — <a href="/PurchaseBills/Index">clear filter</a></div>
}

<div class="card border-0 shadow-sm">
<div class="table-responsive">
<table class="table table-hover mb-0">
<thead class="table-light" style="font-size:11px">
<tr><th class="ps-3">Status</th><th>PO Number</th><th>Vendor</th><th>Bill No</th><th>Bill Date</th><th>Amount</th><th>GST</th><th>Total</th><th>PDF</th><th></th></tr>
</thead>
<tbody>
@if(!Model.Any()){<tr><td colspan="10" class="text-center text-muted py-4">No purchase bills recorded</td></tr>}
@foreach (var b in Model)
{
    var bid = b.GetValueOrDefault("id")?.ToString() ?? "";
    var pn = b.GetValueOrDefault("poNumber")?.ToString() ?? "";
    var st = b.GetValueOrDefault("status")?.ToString() ?? "Mapped";
    var isUnmapped = st == "Unmapped";
    <tr class="@(isUnmapped ? "table-warning" : "")">
        <td class="ps-3">
            @if (isUnmapped)
            { <span class="badge bg-warning text-dark">Unmapped</span> }
            else
            { <span class="badge bg-success">Mapped</span> }
        </td>
        <td class="font-monospace small">
            @if (!string.IsNullOrEmpty(pn))
            { <a href="/PurchaseOrders/Details/@Uri.EscapeDataString(pn)">@pn</a> }
            else
            { <span class="text-muted">&mdash;</span> }
        </td>
        <td class="small">@b.GetValueOrDefault("vendorName")</td>
        <td class="small">@b.GetValueOrDefault("billNo")</td>
        <td class="small">@b.GetValueOrDefault("billDate")</td>
        <td class="small">₹@b.GetValueOrDefault("amount")</td>
        <td class="small">₹@b.GetValueOrDefault("gstAmount")</td>
        <td class="small fw-bold">₹@b.GetValueOrDefault("totalAmount")</td>
        <td>
            @if (b.GetValueOrDefault("fileName") != null)
            { <a href="/PurchaseBills/ViewScan/@bid" target="_blank" class="btn btn-outline-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i></a> }
        </td>
        <td class="text-nowrap">
            <a href="/PurchaseBills/Edit/@bid" class="btn btn-outline-primary btn-sm" title="Map / Edit"><i class="bi bi-pencil-square"></i></a>
            <form method="post" action="/PurchaseBills/Delete/@bid" class="d-inline" onsubmit="return confirm('Delete this bill? This reverses its posted amount from the Budget.')">
                <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i></button>
            </form>
        </td>
    </tr>
}
</tbody>
</table>
</div>
</div>
