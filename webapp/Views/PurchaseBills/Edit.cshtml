@model Dictionary<string,object?>
@{
    ViewData["Title"] = "Map Purchase Bill";
    var allPOs = (List<Dictionary<string,object?>>)(ViewBag.AllPOs ?? new List<Dictionary<string,object?>>());
    var budgetItems = (List<Dictionary<string,object?>>)(ViewBag.BudgetItems ?? new List<Dictionary<string,object?>>());
    var id = Model.GetValueOrDefault("id")?.ToString() ?? "";
    var curPo = Model.GetValueOrDefault("poNumber")?.ToString() ?? "";
    var curBudget = Model.GetValueOrDefault("budgetId")?.ToString() ?? "";
    bool hasScan = ViewBag.HasScan == true;
}
<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/PurchaseBills/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h5 class="fw-bold mb-0">Map Purchase Bill</h5>
    @if (hasScan)
    {
        <a href="/PurchaseBills/ViewScan/@id" target="_blank" class="btn btn-outline-danger btn-sm ms-auto"><i class="bi bi-file-earmark-pdf"></i> View Uploaded PDF</a>
    }
</div>

<div class="row g-3 justify-content-center">
@if (hasScan)
{
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-bold small">Bill PDF Preview</div>
            <iframe src="/PurchaseBills/ViewScan/@id" style="width:100%;height:520px;border:none"></iframe>
        </div>
    </div>
}
<div class="col-lg-@(hasScan ? "6" : "7")">
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form method="post" action="/PurchaseBills/Edit/@id">
    <div class="row g-3">
        <div class="col-12"><label class="form-label small fw-bold">Purchase Order</label>
            <select name="poNumber" id="poSelect" class="form-select" onchange="onPoChange()">
                <option value="">-- Not mapped to a PO yet --</option>
                @foreach (var p in allPOs)
                {
                    var pn = p.GetValueOrDefault("poNumber")?.ToString() ?? "";
                    var vn = p.GetValueOrDefault("vendorName")?.ToString() ?? "";
                    if (pn == curPo)
                    { <option value="@pn" data-vendor="@vn" selected>@pn — @vn</option> }
                    else
                    { <option value="@pn" data-vendor="@vn">@pn — @vn</option> }
                }
            </select>
        </div>
        <div class="col-md-6"><label class="form-label small fw-bold">Vendor Name</label><input type="text" name="vendorName" id="vendorNameInput" class="form-control" value="@Model.GetValueOrDefault("vendorName")"/></div>
        <div class="col-md-6"><label class="form-label small fw-bold">Bill / Invoice No.</label><input type="text" name="billNo" class="form-control" value="@Model.GetValueOrDefault("billNo")"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Bill Date *</label><input type="date" name="billDate" class="form-control" value="@Model.GetValueOrDefault("billDate")" required/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">Amount (before GST)</label><input type="number" step="0.01" name="amount" class="form-control" value="@Model.GetValueOrDefault("amount")"/></div>
        <div class="col-md-4"><label class="form-label small fw-bold">GST Amount</label><input type="number" step="0.01" name="gstAmount" class="form-control" value="@Model.GetValueOrDefault("gstAmount")"/></div>
        <div class="col-12"><label class="form-label small fw-bold">Post actual to Budget line</label>
            <select name="budgetId" class="form-select">
                <option value="">-- Don't post to budget --</option>
                @foreach (var b in budgetItems)
                {
                    var bid = b.GetValueOrDefault("id")?.ToString() ?? "";
                    if (bid == curBudget)
                    { <option value="@bid" selected>@b.GetValueOrDefault("description") (@b.GetValueOrDefault("section"))</option> }
                    else
                    { <option value="@bid">@b.GetValueOrDefault("description") (@b.GetValueOrDefault("section"))</option> }
                }
            </select>
        </div>
        <div class="col-12"><label class="form-label small fw-bold">Notes</label><textarea name="notes" class="form-control" rows="2">@Model.GetValueOrDefault("notes")</textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-dark px-4"><i class="bi bi-check-circle"></i> Save Mapping</button>
        <a href="/PurchaseBills/Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>
</div></div>
</div>
</div>

@section Scripts {
<script>
function onPoChange(){
    var sel = document.getElementById('poSelect');
    var opt = sel.options[sel.selectedIndex];
    var vendorField = document.getElementById('vendorNameInput');
    if (!vendorField.value) vendorField.value = opt.getAttribute('data-vendor') || '';
}
</script>
}
