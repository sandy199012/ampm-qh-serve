@{
    ViewData["Title"] = "Software Deploy";
    var tasks = (List<object[]>)ViewBag.Tasks;
    var hosts = (List<object[]>)ViewBag.Hosts;
    var depts = (List<string>)ViewBag.Depts;
    long maxMb = (long)ViewBag.MaxMb;
    int onlineWin = hosts.Count(h => (bool)h[6] && (string)h[2] == "windows");
    int onlineMac = hosts.Count(h => (bool)h[6] && (string)h[2] == "mac");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h5 class="fw-bold mb-0"><i class="bi bi-cloud-arrow-down-fill" style="color:#2563EB"></i> Software Deploy &mdash; install software and patches on company computers</h5>
    <a href="/Assets/Agents" class="btn btn-outline-secondary btn-sm"><i class="bi bi-cloud-download"></i> Download Deploy Agent</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-2"><div class="small text-muted">Windows PCs online</div><div class="fs-4 fw-bold">@onlineWin</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-2"><div class="small text-muted">Macs online</div><div class="fs-4 fw-bold">@onlineMac</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-2"><div class="small text-muted">Computers with the agent</div><div class="fs-4 fw-bold">@hosts.Count</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body py-2"><div class="small text-muted">Tasks</div><div class="fs-4 fw-bold">@tasks.Count</div></div></div></div>
</div>

@if (hosts.Count == 0)
{
    <div class="alert alert-info small">
        No computer has the <b>Deploy Agent</b> yet. Install it <b>once</b> on each computer (Windows: <b>AMPM_Deploy_Agent_Setup.bat</b> &rarr; Run as administrator;
        Mac: the Terminal command) from <a href="/Assets/Agents">Asset Stock &rarr; Agents</a>. After that, everything below is pushed from this page.
    </div>
}

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <h6 class="fw-bold mb-3">New deployment</h6>
    <form method="post" action="/Deploy/Create" enctype="multipart/form-data" id="depForm" onsubmit="return confirmDeploy();">
      <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small mb-0">Task name</label>
            <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Install 7-Zip" required maxlength="120"/>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-0">Computers</label>
            <select name="os" id="os" class="form-select form-select-sm" onchange="syncForm()">
                <option value="windows">Windows</option>
                <option value="mac">Mac</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-0">What to deploy</label>
            <select name="kind" id="kind" class="form-select form-select-sm" onchange="syncForm()">
                <option value="installer">Installer file</option>
                <option value="agent">Update an AMPM agent</option>
            </select>
        </div>
        <div class="col-md-3" id="fileBox">
            <label class="form-label small mb-0" id="fileLbl">Installer (.exe / .msi, max @maxMb MB)</label>
            <input type="file" name="file" id="file" class="form-control form-control-sm" accept=".exe,.msi"/>
        </div>
        <div class="col-md-3 d-none" id="agentBox">
            <label class="form-label small mb-0">Agent</label>
            <select name="agentType" id="agentType" class="form-select form-select-sm"></select>
        </div>
        <div class="col-md-6" id="argsBox">
            <label class="form-label small mb-0">Silent switches (optional)</label>
            <input type="text" name="args" id="args" class="form-control form-control-sm" maxlength="300" placeholder="e.g. /S   or   /quiet /norestart   (.msi already gets /qn /norestart)"/>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-0">Target</label>
            <select name="targetMode" id="targetMode" class="form-select form-select-sm" onchange="syncForm()">
                <option value="all">All computers</option>
                <option value="dept">One department</option>
                <option value="hosts">Specific computers</option>
            </select>
        </div>
        <div class="col-md-6 d-none" id="deptBox">
            <label class="form-label small mb-0">Department (from Asset Stock assignments)</label>
            <select name="targetValue" id="deptVal" class="form-select form-select-sm" disabled>
                @foreach (var d in depts) { <option value="@d">@d</option> }
            </select>
        </div>
        <div class="col-md-6 d-none" id="hostBox">
            <label class="form-label small mb-0">Computer names (comma or new line separated)</label>
            <textarea name="targetValue" id="hostVal" rows="2" class="form-control form-control-sm" placeholder="AMPM-033, AMPM-044" disabled></textarea>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-0">Valid for (days)</label>
            <input type="number" name="validDays" class="form-control form-control-sm" value="7" min="1" max="60"/>
        </div>
      </div>
      <div class="small text-muted mt-2">
          Each computer checks for work every 5 minutes, downloads the file, verifies its SHA-256 and runs it <b>with administrator rights</b>.
          A computer runs a task only once. After the valid period the task is ignored (so a new PC never receives an old task).
      </div>
      <div class="mt-3"><button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-rocket-takeoff"></i> Deploy</button></div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <h6 class="fw-bold">Deployments</h6>
    @if (tasks.Count == 0)
    {
        <div class="small text-muted">Nothing deployed yet.</div>
    }
    else
    {
    <div class="table-responsive">
    <table class="table table-sm table-hover small align-middle mb-0">
      <thead class="table-light"><tr><th>#</th><th>Name</th><th>OS</th><th>What</th><th>Target</th><th>Created</th><th>Valid until</th><th>State</th><th class="text-end">Done</th><th class="text-end">Failed</th><th class="text-end">Running</th><th class="text-end">Waiting</th></tr></thead>
      <tbody>
      @foreach (var t in tasks)
      {
          var state = (string)t[8];
          <tr>
            <td>@t[0]</td>
            <td><a href="/Deploy/Task/@t[0]">@t[1]</a></td>
            <td>@t[2]</td>
            <td>@t[3]</td>
            <td>@t[4]</td>
            <td class="text-nowrap">@t[5]<div class="text-muted">@t[6]</div></td>
            <td class="text-nowrap">@t[7]</td>
            <td><span class="badge bg-@(state == "Active" ? "success" : "secondary")">@state</span></td>
            <td class="text-end text-success fw-semibold">@t[9]</td>
            <td class="text-end text-danger fw-semibold">@t[10]</td>
            <td class="text-end">@t[11]</td>
            <td class="text-end">@t[12]</td>
          </tr>
      }
      </tbody>
    </table></div>
    }
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <h6 class="fw-bold">Computers with the Deploy Agent <span class="badge bg-light text-dark border fw-normal">@hosts.Count</span></h6>
    @if (hosts.Count == 0) { <div class="small text-muted">No computer has checked in yet.</div> }
    else
    {
    <div class="table-responsive" style="max-height:340px;overflow:auto">
    <table class="table table-sm small mb-0">
      <thead class="table-light"><tr><th>Computer</th><th>IP</th><th>OS</th><th>Logged-in user</th><th>Agent</th><th>Last seen</th><th></th></tr></thead>
      <tbody>
      @foreach (var h in hosts)
      {
          <tr><td>@h[0]</td><td>@h[1]</td><td>@h[2]</td><td>@h[4]</td><td>@h[3]</td><td class="text-nowrap">@h[5]</td>
              <td>@if ((bool)h[6]) { <span class="badge bg-success">online</span> } else { <span class="badge bg-secondary">offline</span> }</td></tr>
      }
      </tbody>
    </table></div>
    <div class="small text-muted mt-1">&ldquo;Online&rdquo; = checked in during the last 15 minutes. An offline computer picks up its tasks when it comes back (until the task expires).</div>
    }
  </div>
</div>

<script>
var AGENTS = {
    windows: [['pc', 'PC Inventory Agent'], ['print', 'Print Monitor Agent'], ['deploy', 'Deploy Agent (this one)']],
    mac: [['mac', 'Mac Inventory Agent'], ['macdeploy', 'Mac Deploy Agent (this one)']]
};
function syncForm() {
    var os = document.getElementById('os').value;
    var kind = document.getElementById('kind').value;
    var installer = kind === 'installer';
    document.getElementById('fileBox').classList.toggle('d-none', !installer);
    document.getElementById('argsBox').classList.toggle('d-none', !(installer && os === 'windows'));
    document.getElementById('agentBox').classList.toggle('d-none', installer);
    document.getElementById('file').disabled = !installer;
    document.getElementById('args').disabled = !(installer && os === 'windows');
    document.getElementById('file').accept = os === 'windows' ? '.exe,.msi' : '.pkg';
    document.getElementById('fileLbl').textContent = os === 'windows' ? 'Installer (.exe / .msi, max @maxMb MB)' : 'Installer (.pkg, max @maxMb MB)';
    var sel = document.getElementById('agentType');
    sel.innerHTML = '';
    AGENTS[os].forEach(function (a) { var o = document.createElement('option'); o.value = a[0]; o.textContent = a[1]; sel.appendChild(o); });
    sel.disabled = installer;
    var tm = document.getElementById('targetMode').value;
    document.getElementById('deptBox').classList.toggle('d-none', tm !== 'dept');
    document.getElementById('hostBox').classList.toggle('d-none', tm !== 'hosts');
    document.getElementById('deptVal').disabled = tm !== 'dept';
    document.getElementById('hostVal').disabled = tm !== 'hosts';
}
function confirmDeploy() {
    var tm = document.getElementById('targetMode').value;
    var who = tm === 'all' ? 'ALL computers' : (tm === 'dept' ? 'the selected department' : 'the listed computers');
    return confirm('This will run on ' + who + ' with administrator rights. Continue?');
}
syncForm();
</script>
