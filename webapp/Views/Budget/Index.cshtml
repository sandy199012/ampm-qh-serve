@model List<Dictionary<string,object?>>
@{
    ViewData["Title"] = "IT Budget";
    var months = new[]{"Apr26","May26","Jun26","Jul26","Aug26","Sep26","Oct26","Nov26","Dec26","Jan27","Feb27","Mar27"};
    var curMonth = DateTime.Now.ToString("MMMy").Replace("20","");
    string[] sections = Model.Select(b => b.GetValueOrDefault("section")?.ToString() ?? "Other")
        .Distinct().OrderBy(s=>s).ToArray();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-wallet2 text-secondary"></i> IT Budget 2026-27</h5>
    <a href="/Budget/Create" class="btn btn-secondary btn-sm px-3"><i class="bi bi-plus-circle"></i> Add Item</a>
</div>

<!-- Summary Cards -->
@{
    double totalProj = 0, totalAct = 0;
    foreach(var b in Model){
        double.TryParse(b.GetValueOrDefault("TotalProjected")?.ToString(), out var p);
        double.TryParse(b.GetValueOrDefault("TotalActual")?.ToString(), out var a);
        totalProj += p; totalAct += a;
    }
    double remaining = totalProj - totalAct;
    int usedPct = totalProj > 0 ? (int)Math.Round(totalAct/totalProj*100) : 0;
}
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center py-3" style="border-top:4px solid #2563EB!important">
        <div class="small text-muted">Total Projected</div>
        <div class="fw-bold fs-4 text-primary">&#8377;@totalProj.ToString("N0")</div>
    </div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center py-3" style="border-top:4px solid #DC2626!important">
        <div class="small text-muted">Total Actual</div>
        <div class="fw-bold fs-4 text-danger">&#8377;@totalAct.ToString("N0")</div>
        <div class="small text-muted">@usedPct% used</div>
    </div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center py-3" style="border-top:4px solid #059669!important">
        <div class="small text-muted">Remaining</div>
        <div class="fw-bold fs-4 @(remaining>=0?"text-success":"text-danger")">&#8377;@remaining.ToString("N0")</div>
    </div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm text-center py-3">
        <div class="small text-muted">Progress</div>
        <div class="fw-bold fs-4">@usedPct%</div>
        <div class="progress mx-3" style="height:6px">
            <div class="progress-bar @(usedPct>90?"bg-danger":usedPct>70?"bg-warning":"bg-success")" style="width:@Math.Min(usedPct,100)%"></div>
        </div>
    </div></div>
</div>

<!-- Budget Table -->
@foreach(var section in sections)
{
    var sItems = Model.Where(b => b.GetValueOrDefault("section")?.ToString() == section).ToList();
    double sProj = sItems.Sum(b => { double.TryParse(b.GetValueOrDefault("TotalProjected")?.ToString(), out var v); return v; });
    double sAct  = sItems.Sum(b => { double.TryParse(b.GetValueOrDefault("TotalActual")?.ToString(), out var v); return v; });
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center" style="background:#0A192F;color:white">
            <span class="fw-bold">@section</span>
            <span class="small">Projected: &#8377;@sProj.ToString("N0") | Actual: &#8377;@sAct.ToString("N0")</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light" style="font-size:11px">
                    <tr>
                        <th class="ps-3" style="min-width:200px">Description</th>
                        @foreach(var m in months){<th class="text-center" style="min-width:90px">@m</th>}
                        <th class="text-end">Total Proj.</th>
                        <th class="text-end">Total Act.</th>
                        <th class="text-end">Variance</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach(var b in sItems)
                {
                    var bid = b.GetValueOrDefault("id")?.ToString() ?? "";
                    var monthly = b.GetValueOrDefault("monthly") as Newtonsoft.Json.Linq.JObject;
                    double bProj = 0, bAct = 0;
                    double.TryParse(b.GetValueOrDefault("TotalProjected")?.ToString(), out bProj);
                    double.TryParse(b.GetValueOrDefault("TotalActual")?.ToString(), out bAct);
                    double variance = bProj - bAct;
                    <tr>
                        <td class="ps-3 small"><strong>@b.GetValueOrDefault("description")</strong></td>
                        @foreach(var m in months)
                        {
                            double proj = 0, act = 0;
                            if(monthly != null && monthly[m] != null){
                                double.TryParse(monthly[m]?["projected"]?.ToString(), out proj);
                                double.TryParse(monthly[m]?["actual"]?.ToString(), out act);
                            }
                            <td class="text-center small" style="font-size:11px">
                                @if(proj > 0 || act > 0){
                                    <div class="text-muted">@proj.ToString("N0")</div>
                                    <div class="@(act>proj?"text-danger":"text-success") fw-bold">@act.ToString("N0")</div>
                                } else {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        }
                        <td class="text-end small fw-bold">&#8377;@bProj.ToString("N0")</td>
                        <td class="text-end small text-danger">&#8377;@bAct.ToString("N0")</td>
                        <td class="text-end small @(variance>=0?"text-success":"text-danger")">&#8377;@variance.ToString("N0")</td>
                        <td><a href="/Budget/Edit/@bid" class="btn btn-outline-secondary btn-sm" style="font-size:10px"><i class="bi bi-pencil"></i></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
