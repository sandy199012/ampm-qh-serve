@{
    ViewData["Title"] = "Access Denied";
}
<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height:60vh">
    <i class="bi bi-shield-lock" style="font-size:64px;color:#DC2626"></i>
    <h4 class="fw-bold mt-3">Access Denied</h4>
    <p class="text-muted" style="max-width:420px">
        Aapko is module ko dekhne ki permission nahi hai. Agar zaroorat hai to apne admin
        (@("IT Department")) se contact karo taaki permission assign ho sake.
    </p>
    <a href="/" class="btn btn-primary mt-2"><i class="bi bi-house"></i> Dashboard par jao</a>
</div>
