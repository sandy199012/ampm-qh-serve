@{
    ViewData["Title"] = "Dashboard";
    var stats = (DashboardStats)ViewBag.Stats;
    var user  = (UserSession)ViewBag.User;
}

<div class="row mb-4" style="background:linear-gradient(135deg,#0A192F,#1e3a5f);margin:-16px -24px 0;padding:28px 24px 24px;border-radius:0 0 16px 16px">
    <div class="col">
        <h4 class="text-white fw-bold mb-1">Welcome back, @user.Name 👋</h4>
        <p class="mb-0" style="color:#06B6D4;font-size:13px">AMPM Fashions Pvt Ltd — IT Department | @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="col-auto">
        <span class="badge fs-6 px-3 py-2" style="background:rgba(255,255,255,.15);color:white">
            @user.Role.ToUpper()
        </span>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #2563EB!important">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Employees</p>
                        <h3 class="fw-bold mb-0" style="color:#2563EB">@stats.TotalEmployees</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#EFF6FF">
                        <i class="bi bi-people fs-5" style="color:#2563EB"></i>
                    </div>
                </div>
                <a href="/Employees" class="small text-decoration-none text-muted">View all →</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #DC2626!important">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Open Tickets</p>
                        <h3 class="fw-bold mb-0 text-danger">@stats.OpenTickets</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#FEF2F2">
                        <i class="bi bi-headset fs-5 text-danger"></i>
                    </div>
                </div>
                <a href="/Helpdesk" class="small text-decoration-none text-muted">View tickets →</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #059669!important">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Purchase Orders</p>
                        <h3 class="fw-bold mb-0" style="color:#059669">@stats.TotalPOs</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#F0FDF4">
                        <i class="bi bi-file-earmark-text fs-5" style="color:#059669"></i>
                    </div>
                </div>
                <a href="/PurchaseOrders" class="small text-decoration-none text-muted">View POs →</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #D97706!important">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1">Vendors</p>
                        <h3 class="fw-bold mb-0" style="color:#D97706">@stats.TotalVendors</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#FFFBEB">
                        <i class="bi bi-shop fs-5" style="color:#D97706"></i>
                    </div>
                </div>
                <a href="#" class="small text-decoration-none text-muted">View vendors →</a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <h6 class="fw-bold text-muted mb-3">QUICK ACTIONS</h6>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Helpdesk/Create" class="btn btn-danger btn-sm px-3">
                <i class="bi bi-plus-circle"></i> New Ticket
            </a>
            <a href="/Employees" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-people"></i> Employees
            </a>
            <a href="/PurchaseOrders" class="btn btn-success btn-sm px-3">
                <i class="bi bi-file-earmark-plus"></i> New PO
            </a>
            <a href="/ITStore" class="btn btn-warning btn-sm px-3">
                <i class="bi bi-box-seam"></i> IT Store
            </a>
            <a href="/Goals" class="btn btn-info btn-sm px-3 text-white">
                <i class="bi bi-bullseye"></i> IT Goals
            </a>
        </div>
    </div>
</div>

<!-- Recent Tickets -->
<div class="row g-3">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-ticket-perforated text-danger"></i> Recent Tickets</h6>
                <a href="/Helpdesk" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Ticket ID</th>
                                <th>Employee</th>
                                <th>Issue</th>
                                <th>Priority</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        @{
                            var tickets = (List<Dictionary<string,object?>>)ViewBag.RecentTickets ?? new();
                        }
                        @if (!tickets.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No tickets yet</td></tr>
                        }
                        @foreach (var t in tickets.Take(8))
                        {
                            var status   = t.GetValueOrDefault("status")?.ToString() ?? "";
                            var priority = t.GetValueOrDefault("priority")?.ToString() ?? "";
                            var sBadge   = status == "Open" ? "danger" : status == "Resolved" ? "success" : status == "In Progress" ? "primary" : "secondary";
                            var pBadge   = priority == "Critical" ? "danger" : priority == "High" ? "warning" : priority == "Medium" ? "info" : "secondary";
                            <tr>
                                <td class="ps-3 font-monospace small">@t.GetValueOrDefault("ticketId")</td>
                                <td>@t.GetValueOrDefault("empName")</td>
                                <td class="text-truncate" style="max-width:160px">@t.GetValueOrDefault("title")</td>
                                <td><span class="badge bg-@pBadge">@priority</span></td>
                                <td><span class="badge bg-@sBadge">@status</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary"></i> System Info</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <small class="text-muted d-block">Company</small>
                        <strong>AMPM Fashions Pvt. Ltd.</strong>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">IT Admin</small>
                        <strong>Sandeep Kumar Singh Kushwaha</strong>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Location</small>
                        <strong>B-144, Sector 10, Noida</strong>
                    </li>
                    <li class="mb-3">
                        <small class="text-muted d-block">Server</small>
                        <span class="badge bg-success"><i class="bi bi-circle-fill" style="font-size:8px"></i> Live on Render</span>
                    </li>
                    <li>
                        <small class="text-muted d-block">Goals This Week</small>
                        <strong>@stats.TotalGoals total</strong>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
