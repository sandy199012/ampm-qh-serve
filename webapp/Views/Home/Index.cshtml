@{
    ViewData["Title"] = "Dashboard";
    var stats = (DashboardStats)ViewBag.Stats;
    var user  = (UserSession)ViewBag.User;
    var tickets = (List<Dictionary<string,object?>>)(ViewBag.RecentTickets ?? new List<Dictionary<string,object?>>());
    var lowStock = (List<Dictionary<string,object?>>)(ViewBag.LowStock ?? new List<Dictionary<string,object?>>());
    int pendingGoals = ViewBag.PendingGoals ?? 0;
    int openTickets = stats.OpenTickets;
}

<style>
    .dash { --d-ink:#0F172A; --d-body:#334155; --d-muted:#64748B; --d-line:#E2E8F0; --d-soft:#F8FAFC;
            --d-accent:#1D4ED8; --d-danger:#B91C1C; --d-warn:#B45309; --d-ok:#15803D;
            max-width:1500px; margin:0 auto; color:var(--d-body); }
    .dash .tnum { font-variant-numeric:tabular-nums; }

    /* Page header */
    .dash-head { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:12px;
                 padding:4px 0 16px; margin-bottom:20px; border-bottom:1px solid var(--d-line); }
    .dash-title { font-size:22px; font-weight:650; color:var(--d-ink); margin:0; letter-spacing:-.2px; }
    .dash-sub { font-size:13px; color:var(--d-muted); margin:4px 0 0; }
    .dash-sub .sep { margin:0 8px; color:#CBD5E1; }
    .dash-meta { display:flex; align-items:center; gap:8px; }
    .chip { display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:600; letter-spacing:.6px;
            text-transform:uppercase; padding:5px 10px; border-radius:6px; border:1px solid var(--d-line);
            background:#fff; color:var(--d-body); }
    .chip .dot { width:7px; height:7px; border-radius:50%; background:var(--d-ok); }

    /* Section label */
    .sec-label { font-size:11px; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:var(--d-muted); margin:0 0 10px; }

    /* KPI cards */
    .kpi-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:14px; margin-bottom:24px; }
    .kpi { display:flex; align-items:center; justify-content:space-between; gap:12px; background:#fff;
           border:1px solid var(--d-line); border-radius:10px; padding:16px 18px; text-decoration:none; color:inherit;
           transition:border-color .15s, box-shadow .15s; }
    .kpi:hover { border-color:#94A3B8; box-shadow:0 2px 8px rgba(15,23,42,.06); color:inherit; }
    .kpi-label { font-size:12px; font-weight:500; color:var(--d-muted); margin-bottom:6px; }
    .kpi-value { font-size:28px; line-height:1; font-weight:650; color:var(--d-ink); }
    .kpi-value.is-danger { color:var(--d-danger); }
    .kpi-value.is-warn { color:var(--d-warn); }
    .kpi-icon { flex:none; width:40px; height:40px; border-radius:9px; display:flex; align-items:center; justify-content:center;
                background:#EFF6FF; color:var(--d-accent); font-size:18px; }
    .kpi-icon.is-danger { background:#FEF2F2; color:var(--d-danger); }
    .kpi-icon.is-warn { background:#FFFBEB; color:var(--d-warn); }

    /* Quick actions */
    .qa { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px; }
    .qa a { display:inline-flex; align-items:center; gap:7px; font-size:13px; font-weight:500; color:var(--d-ink);
            background:#fff; border:1px solid var(--d-line); border-radius:8px; padding:7px 13px; text-decoration:none;
            transition:background .15s, border-color .15s; }
    .qa a i { color:var(--d-accent); font-size:14px; }
    .qa a:hover { background:var(--d-soft); border-color:#94A3B8; }

    /* Panels */
    .panel { background:#fff; border:1px solid var(--d-line); border-radius:10px; overflow:hidden; margin-bottom:16px; }
    .panel-head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:13px 18px; border-bottom:1px solid var(--d-line); }
    .panel-title { font-size:14px; font-weight:600; color:var(--d-ink); margin:0; display:flex; align-items:center; gap:8px; }
    .panel-title i { color:var(--d-muted); font-size:15px; }
    .panel-link { font-size:12px; font-weight:500; color:var(--d-accent); text-decoration:none; }
    .panel-link:hover { text-decoration:underline; }
    .panel.is-alert-warn { border-top:3px solid #D97706; }
    .panel.is-alert-danger { border-top:3px solid #DC2626; }

    /* Tickets table */
    .dtable { width:100%; border-collapse:collapse; font-size:13px; }
    .dtable th { font-size:11px; font-weight:600; letter-spacing:.6px; text-transform:uppercase; color:var(--d-muted);
                 background:var(--d-soft); padding:10px 18px; text-align:left; border-bottom:1px solid var(--d-line); white-space:nowrap; }
    .dtable td { padding:11px 18px; border-bottom:1px solid #F1F5F9; vertical-align:middle; }
    .dtable tbody tr:last-child td { border-bottom:0; }
    .dtable tbody tr:hover { background:var(--d-soft); }
    .tid { white-space:nowrap; font-family:ui-monospace, SFMono-Regular, Consolas, monospace; font-size:12px; font-weight:600; color:var(--d-accent); }
    .ttl { max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .pill { display:inline-block; font-size:11px; font-weight:600; padding:3px 9px; border-radius:999px; border:1px solid transparent; white-space:nowrap; }
    .pill-danger { background:#FEF2F2; color:#B91C1C; border-color:#FECACA; }
    .pill-warn   { background:#FFFBEB; color:#B45309; border-color:#FDE68A; }
    .pill-info   { background:#EFF6FF; color:#1D4ED8; border-color:#BFDBFE; }
    .pill-ok     { background:#F0FDF4; color:#15803D; border-color:#BBF7D0; }
    .pill-mute   { background:#F1F5F9; color:#475569; border-color:#E2E8F0; }
    .sdot { display:inline-flex; align-items:center; gap:7px; font-size:13px; white-space:nowrap; }
    .sdot::before { content:""; width:8px; height:8px; border-radius:50%; background:#94A3B8; }
    .sdot.s-danger::before { background:#DC2626; } .sdot.s-info::before { background:#2563EB; }
    .sdot.s-ok::before { background:#16A34A; }
    .view-btn { display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:7px;
                border:1px solid var(--d-line); color:var(--d-muted); text-decoration:none; background:#fff; }
    .view-btn:hover { color:var(--d-accent); border-color:var(--d-accent); background:#EFF6FF; }
    .empty { text-align:center; color:var(--d-muted); padding:28px 12px; font-size:13px; }

    /* List rows (alerts) */
    .lrow { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:10px 18px; border-bottom:1px solid #F1F5F9; font-size:13px; }
    .lrow:last-child { border-bottom:0; }
    .lrow .lbl { display:flex; align-items:center; gap:8px; min-width:0; }
    .lrow .lbl i { color:var(--d-muted); }
    .lfoot { padding:10px 18px; border-top:1px solid var(--d-line); background:var(--d-soft); }

    /* System info */
    .info-list { margin:0; padding:4px 18px 8px; }
    .info-list div { padding:10px 0; border-bottom:1px solid #F1F5F9; }
    .info-list div:last-child { border-bottom:0; }
    .info-list dt { font-size:11px; font-weight:600; letter-spacing:.6px; text-transform:uppercase; color:var(--d-muted); margin-bottom:2px; }
    .info-list dd { margin:0; font-size:13px; font-weight:500; color:var(--d-ink); }

    @@media (max-width: 1199px) { .kpi-grid { grid-template-columns:repeat(2, 1fr); } }
    @@media (max-width: 575px) {
        .kpi-grid { gap:10px; }
        .kpi { padding:13px 14px; } .kpi-value { font-size:24px; } .kpi-icon { width:34px; height:34px; font-size:16px; }
        .dtable th, .dtable td { padding:9px 12px; }
        .dash-title { font-size:19px; }
    }
</style>

@{
    // tone: "" (normal) | "danger" | "warn"
    void Kpi(string icon, string label, int val, string url, string tone = "")
    {
        var cls = tone == "" ? "" : " is-" + tone;
        <a href="@url" class="kpi">
            <div>
                <div class="kpi-label">@label</div>
                <div class="kpi-value tnum@(cls)">@val</div>
            </div>
            <div class="kpi-icon@(cls)"><i class="bi @icon"></i></div>
        </a>;
    }
    void Act(string icon, string label, string url)
    {
        <a href="@url"><i class="bi @icon"></i> @label</a>;
    }
}

<div class="dash">

    <!-- Page header -->
    <div class="dash-head">
        <div>
            <h1 class="dash-title">Dashboard</h1>
            <p class="dash-sub">
                Welcome back, @user.Name<span class="sep">|</span>AMPM Fashions Pvt Ltd &mdash; IT Department<span class="sep">|</span>@IstTime.Now.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>
        <div class="dash-meta">
            <span class="chip"><span class="dot"></span> Live</span>
            <span class="chip">@user.Role</span>
        </div>
    </div>

    <!-- Key metrics -->
    <div class="sec-label">Overview</div>
    <div class="kpi-grid">
        @{ Kpi("bi-people-fill",          "Employees",         stats.TotalEmployees,   "/Employees/Index"); }
        @{ Kpi("bi-headset",              "Open Tickets",      openTickets,            "/Helpdesk/Index?status=Open", openTickets > 0 ? "danger" : ""); }
        @{ Kpi("bi-file-earmark-text",    "Purchase Orders",   stats.TotalPOs,         "/PurchaseOrders/Index"); }
        @{ Kpi("bi-pc-display",           "Assets",            stats.TotalAssets,      "/Assets/Index"); }
        @{ Kpi("bi-box-seam",             "IT Store Items",    stats.TotalStockItems,  "/ITStore/Index"); }
        @{ Kpi("bi-bullseye",             "Pending Goals",     pendingGoals,           "/Goals/Index"); }
        @{ Kpi("bi-key",                  "Expiring Licenses", stats.ExpiringLicenses, "/Licenses/Index", stats.ExpiringLicenses > 0 ? "danger" : ""); }
        @{ Kpi("bi-lightning-charge",     "Bills Due",         stats.BillsDue,         "/Bills/Index", stats.BillsDue > 0 ? "warn" : ""); }
    </div>

    <!-- Quick actions -->
    <div class="sec-label">Quick actions</div>
    <div class="qa">
        @{ Act("bi-plus-circle",        "New Ticket",   "/Helpdesk/Create"); }
        @{ Act("bi-file-earmark-plus",  "New PO",       "/PurchaseOrders/Create"); }
        @{ Act("bi-person-plus",        "Add Employee", "/Employees/Create"); }
        @{ Act("bi-pc-display",         "Add Asset",    "/Assets/Create"); }
        @{ Act("bi-box-seam",           "Add Stock",    "/ITStore/AddItem"); }
        @{ Act("bi-bullseye",           "Add Goal",     "/Goals/Create"); }
        @{ Act("bi-shop",               "Add Vendor",   "/Vendors/Create"); }
        @{ Act("bi-key",                "Add License",  "/Licenses/Create"); }
        @{ Act("bi-lightning-charge",   "Add Bill",     "/Bills/Create"); }
    </div>

    <div class="row g-3">
        <!-- Recent Tickets -->
        <div class="col-lg-8">
            <div class="panel">
                <div class="panel-head">
                    <h2 class="panel-title"><i class="bi bi-ticket-perforated"></i> Recent Tickets</h2>
                    <a href="/Helpdesk/Index" class="panel-link">View all &rarr;</a>
                </div>
                <div class="table-responsive">
                    <table class="dtable">
                        <thead>
                            <tr><th>ID</th><th>Employee</th><th>Issue</th><th>Priority</th><th>Status</th><th style="width:1%"></th></tr>
                        </thead>
                        <tbody>
                        @if (!tickets.Any()) { <tr><td colspan="6" class="empty">No tickets yet</td></tr> }
                        @foreach (var t in tickets)
                        {
                            var s = t.GetValueOrDefault("status")?.ToString() ?? "Open";
                            var p = t.GetValueOrDefault("priority")?.ToString() ?? "";
                            var sCls = s == "Open" ? "s-danger" : s == "In Progress" ? "s-info" : s == "Resolved" ? "s-ok" : "";
                            var pCls = p == "Critical" ? "pill-danger" : p == "High" ? "pill-warn" : p == "Medium" ? "pill-info" : "pill-mute";
                            var tid = t.GetValueOrDefault("ticketId")?.ToString() ?? "";
                            <tr>
                                <td class="tid">@tid</td>
                                <td>@t.GetValueOrDefault("empName")</td>
                                <td><div class="ttl" title="@t.GetValueOrDefault("title")">@t.GetValueOrDefault("title")</div></td>
                                <td><span class="pill @pCls">@p</span></td>
                                <td><span class="sdot @sCls">@s</span></td>
                                <td><a href="/Helpdesk/Details/@tid" class="view-btn" title="View ticket"><i class="bi bi-eye"></i></a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right panel -->
        <div class="col-lg-4">
            @if (lowStock.Any())
            {
            <div class="panel is-alert-warn">
                <div class="panel-head">
                    <h2 class="panel-title"><i class="bi bi-exclamation-triangle"></i> Low Stock Alert</h2>
                </div>
                @foreach (var item in lowStock.Take(5))
                {
                    int.TryParse(item.GetValueOrDefault("totalQty")?.ToString(), out var tq);
                    int.TryParse(item.GetValueOrDefault("issuedQty")?.ToString(), out var iq);
                    int bal = tq - iq;
                    <div class="lrow">
                        <span class="lbl">@item.GetValueOrDefault("name")</span>
                        <span class="pill @(bal <= 0 ? "pill-danger" : "pill-warn") tnum">@bal left</span>
                    </div>
                }
                <div class="lfoot"><a href="/ITStore/Index" class="panel-link">View IT Store &rarr;</a></div>
            </div>
            }

            @if (stats.ExpiringLicenses > 0 || stats.BillsDue > 0)
            {
            <div class="panel is-alert-danger">
                <div class="panel-head">
                    <h2 class="panel-title"><i class="bi bi-bell"></i> Renewals &amp; Dues</h2>
                </div>
                @if (stats.ExpiringLicenses > 0)
                {
                <div class="lrow">
                    <span class="lbl"><i class="bi bi-key"></i> Licenses expiring soon</span>
                    <a href="/Licenses/Index" class="pill pill-danger text-decoration-none tnum">@stats.ExpiringLicenses</a>
                </div>
                }
                @if (stats.BillsDue > 0)
                {
                <div class="lrow">
                    <span class="lbl"><i class="bi bi-lightning-charge"></i> Bills pending / overdue</span>
                    <a href="/Bills/Index" class="pill pill-warn text-decoration-none tnum">@stats.BillsDue</a>
                </div>
                }
            </div>
            }

            <!-- System Info -->
            <div class="panel">
                <div class="panel-head">
                    <h2 class="panel-title"><i class="bi bi-info-circle"></i> System Info</h2>
                </div>
                <dl class="info-list">
                    <div><dt>Company</dt><dd>AMPM Fashions Pvt. Ltd.</dd></div>
                    <div><dt>IT Admin</dt><dd>Sandeep Kumar Singh Kushwaha</dd></div>
                    <div><dt>GSTIN</dt><dd class="tnum">09AAFCA4854J1ZE</dd></div>
                    <div><dt>Location</dt><dd>B-144, Sector 10, Noida</dd></div>
                    <div><dt>Server</dt><dd><span class="pill pill-ok">Live &mdash; Supabase + Render</span></dd></div>
                </dl>
            </div>
        </div>
    </div>
</div>
